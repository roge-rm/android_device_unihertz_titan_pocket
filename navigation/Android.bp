// Hardware Home (front strip), Back and Recents, no on-screen nav bar (TOUCHPAD_PORT.md).

runtime_resource_overlay {
    name: "PocketNavFrameworkOverlay",
    resource_dirs: ["overlay/PocketNavFrameworkOverlay/res"],
    manifest: "overlay/PocketNavFrameworkOverlay/AndroidManifest.xml",
    product_specific: true,
}

runtime_resource_overlay {
    name: "PocketNavLineageOverlay",
    resource_dirs: ["overlay/PocketNavLineageOverlay/res"],
    manifest: "overlay/PocketNavLineageOverlay/AndroidManifest.xml",
    product_specific: true,
}
