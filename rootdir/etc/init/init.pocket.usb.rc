# File transfer over FunctionFS. Our 5.10 kernel has no f_mtp, so the stock mtp.gs0 and ptp.gs1 links
# in the vendor and system rcs fail. system_server opens /dev/usb-ffs/mtp/ep0 and ptp/ep0 once, when it
# starts, writes the descriptors and keeps them open. MtpServer then opens ep1 to ep3.

# The vendor rc makes /dev/usb-ffs 0770 shell shell at post-fs. system_server and MediaProvider aren't
# in group shell, so they can't reach mtp/ep0, the descriptors never get written and ffs.mtp fails to
# bind with ENODEV. 0775 lets them search it; adb stays 0770 shell.
# no_disconnect=1: if ep0 gets closed (system_server died) the instance is deactivated instead of
# reset, so it doesn't unbind the whole gadget and adb with it until the host next configures it
# or a new system_server opens ep0.
on post-fs-data
    chmod 0775 /dev/usb-ffs
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mkdir /dev/usb-ffs/ptp 0770 mtp mtp
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /config/usb_gadget/g1/functions/ffs.ptp
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1
    mount functionfs ptp /dev/usb-ffs/ptp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1

# The USB HAL sets vendor.usb.config (none, then the new value) and the vendor rc copies it to
# sys.usb.config. The vendor and system actions run first; their mtp.gs0 and ptp.gs1 links fail,
# so they bind adb alone or nothing. The trigger runs after both, unbinds, links the ffs functions and binds again.
# If ffs.mtp or ffs.ptp has no descriptors the bind fails with ENODEV and the gadget stays down until
# UsbDeviceManager's 5 s switch timeout sets the default (adb) again.
on property:sys.usb.config=mtp && property:sys.usb.configfs=1
    trigger pocket-usb-mtp
on property:sys.usb.config=ptp && property:sys.usb.configfs=1
    trigger pocket-usb-ptp
on property:sys.usb.ffs.ready=1 && property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    trigger pocket-usb-mtp-adb
on property:sys.usb.ffs.ready=1 && property:sys.usb.config=ptp,adb && property:sys.usb.configfs=1
    trigger pocket-usb-ptp-adb

on pocket-usb-mtp
    write /config/usb_gadget/g1/UDC none
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${vendor.usb.controller}

on pocket-usb-ptp
    write /config/usb_gadget/g1/UDC none
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "ptp"
    symlink /config/usb_gadget/g1/functions/ffs.ptp /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${vendor.usb.controller}

on pocket-usb-mtp-adb
    write /config/usb_gadget/g1/UDC none
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${vendor.usb.controller}

on pocket-usb-ptp-adb
    write /config/usb_gadget/g1/UDC none
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "ptp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.ptp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${vendor.usb.controller}
