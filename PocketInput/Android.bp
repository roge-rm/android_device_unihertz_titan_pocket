// SPDX-License-Identifier: Apache-2.0
java_library {
    name: "PocketInputCore",
    host_supported: true,
    sdk_version: "current",
    srcs: ["src/**/*.java"],
}

java_library {
    name: "PocketInputEditorAdapter",
    sdk_version: "current",
    srcs: ["android/**/*.java"],
    static_libs: ["PocketInputCore"],
}

android_app {
    name: "PocketInputSettings",
    // SettingsLib parts are built against system_current.
    sdk_version: "system_current",
    // System uid, to set persist.sys.pocket.pad_scroll for pocket_padd.
    certificate: "platform",
    min_sdk_version: "30",
    manifest: "settings/AndroidManifest.xml",
    srcs: ["settings/**/*.java"],
    resource_dirs: ["settings/res"],
    static_libs: [
        "PocketInputCore",
        "androidx.appcompat_appcompat",
        "androidx.preference_preference",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibFooterPreference",
        "SettingsLibMainSwitchPreference",
        "SettingsLibSelectorWithWidgetPreference",
        "SettingsLibSettingsTheme",
    ],
}

// Keyboard touchpad swipe scroll daemon, see TOUCHPAD_PORT.md.
cc_library_static {
    name: "libpocketpadgesture",
    host_supported: true,
    srcs: ["pad/pad_gesture.cpp"],
    export_include_dirs: ["pad"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "pocket_padd",
    system_ext_specific: true,
    srcs: ["pad/pocket_padd.cpp"],
    static_libs: ["libpocketpadgesture"],
    shared_libs: ["libbase", "liblog"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    init_rc: ["pad/pocket_padd.rc"],
    required: ["pocket-pad-scroll.idc"],
}

prebuilt_usr_idc {
    name: "pocket-pad-scroll.idc",
    src: "pad/pocket-pad-scroll.idc",
}

cc_test_host {
    name: "pocket_pad_gesture_test",
    srcs: ["pad/pad_gesture_test.cpp"],
    static_libs: ["libpocketpadgesture"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    gtest: false,
}
