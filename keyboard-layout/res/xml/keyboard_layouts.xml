<!-- aw9523-key reports vendor 0 and product 0; external keyboards report their own IDs.
     vendorId and productId are private framework attributes, hence androidprv. -->
<keyboard-layouts xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:androidprv="http://schemas.android.com/apk/prv/res/android">
    <keyboard-layout
        android:name="titan_pocket"
        android:label="@string/layout_label"
        android:keyboardLayout="@raw/aw9523_key"
        android:keyboardLocale="en-Latn-US"
        android:keyboardLayoutType="qwerty"
        androidprv:vendorId="0"
        androidprv:productId="0" />
</keyboard-layouts>
