# RAM-only single-CPU USB diagnostic, not the Android/product configuration.
CONFIG_LOCALVERSION="-titanpocket-ramdiag-v11"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_EXPERT=y
CONFIG_DEBUG_KERNEL=y
CONFIG_PRINTK=y
CONFIG_LOG_BUF_SHIFT=20
CONFIG_KALLSYMS=y
CONFIG_SMP=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM64_PA_BITS_48=y
CONFIG_RELOCATABLE=y
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_EFI is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_TTY=y
# CONFIG_VT is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PINCTRL_MT6771=y
CONFIG_PINCTRL_MTK_PARIS=y
CONFIG_EINT_MTK=y
CONFIG_COMMON_CLK_MT6771=y
CONFIG_MFD_SYSCON=y
CONFIG_REGMAP_MMIO=y
CONFIG_COMMON_CLK_MT6771_HANDOFF=y
CONFIG_RESET_CONTROLLER=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6358=y
CONFIG_PHY_MTK_MT6771_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_GADGET=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
# CONFIG_MODULES is not set
CONFIG_BLOCK=y
CONFIG_SCSI=y
# CONFIG_MMC is not set
# CONFIG_MTD is not set
# CONFIG_NET is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_PM_SLEEP is not set
# CONFIG_PCI is not set
# CONFIG_IOMMU_SUPPORT is not set
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
# CONFIG_PSTORE_DEFLATE_COMPRESS is not set
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# CONFIG_PSTORE_PMSG is not set
# CONFIG_PSTORE_FTRACE is not set
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=90
# CONFIG_RTC_CLASS is not set
# CONFIG_INPUT is not set

# One combined engineering probe, never a production storage profile.
CONFIG_SCSI_LOWLEVEL=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y
CONFIG_BLK_DEV_SD=y
CONFIG_PHY_MTK_UFS=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_COMMON_CLK_MT6358_UFS=y
# CONFIG_SCSI_UFS_CRYPTO is not set
# CONFIG_SCSI_UFS_BSG is not set
# CONFIG_SCSI_UFS_HPB is not set
CONFIG_EXT4_FS=y
# CONFIG_F2FS_FS is not set
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
# CONFIG_DM_CRYPT is not set
# CONFIG_DM_VERITY is not set
# CONFIG_DM_DEFAULT_KEY is not set
# CONFIG_FS_ENCRYPTION is not set
# Overlay onto the existing RAM-only diagnostic config, not a product defconfig.
# Real driver rootfs_initcall performs secure SHM negotiation and RoT SMC before init.
# This is not a claim of a read-only secure-world boot. Review the probe contract.
CONFIG_TRUSTKERNEL_TEE_SUPPORT=y
CONFIG_TRUSTKERNEL_TEE_FP_SUPPORT=y
# CONFIG_TRUSTKERNEL_TEE_RPMB_SUPPORT is not set
# CONFIG_TEE is not set
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_ARCH_KEEP_MEMBLOCK=y
CONFIG_TRUSTKERNEL_TEE_RAM_DIAGNOSTIC=y
# Read-only I2C chip ID probes from init through /dev/i2c-N.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MT65XX=y
