CONFIG_LOCALVERSION="-titanpocket-upgrade-probe"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ARCH_MEDIATEK=y
# The generic ARM64 preset enables Qualcomm too; it is not Pocket hardware.
# CONFIG_ARCH_QCOM is not set
CONFIG_PINCTRL_MT6771=y
CONFIG_PINCTRL_MTK_PARIS=y
CONFIG_EINT_MTK=y
CONFIG_COMMON_CLK_MT6771=y
CONFIG_COMMON_CLK_MT6771_HANDOFF=y
CONFIG_COMPAT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_COMPAT_VDSO is not set
# Initial Android core build probes, not a complete product configuration.
# CONFIG_SYSVIPC is not set
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_ACT_POLICE=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,selinux,bpf"
CONFIG_SECURITYFS=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_DEFAULT_KEY=y
CONFIG_PSI=y
CONFIG_RESET_CONTROLLER=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR_MT6358=y
CONFIG_PHY_MTK_UFS=y
CONFIG_PHY_MTK_MT6771_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_DEVTMPFS=y
CONFIG_CONFIGFS_FS=y
# Persistent kernel logging only; vendor bconsole/ftrace/pmsg stays reserved.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# CONFIG_PSTORE_PMSG is not set
# CONFIG_FTRACE is not set

# Keep the isolated EXTBUF7 component out of the engineering Image.
# CONFIG_COMMON_CLK_MT6358_UFS is not set

# Matched TrustKernel userspace ABI; upstream TEE is a different interface.
# CONFIG_TEE is not set
CONFIG_TRUSTKERNEL_TEE_SUPPORT=y
CONFIG_TRUSTKERNEL_TEE_FP_SUPPORT=y
# CONFIG_TRUSTKERNEL_TEE_RPMB_SUPPORT is not set
