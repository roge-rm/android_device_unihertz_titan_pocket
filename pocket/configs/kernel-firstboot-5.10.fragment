# First full-ROM boot of the 5.10 kernel, applied on top of allnoconfig.
# Board drivers match the v9 diagnostic; Android options follow
# kernel/configs/t/android-5.10/android-base.config. Everything is built in.
# Cmdline (clk_ignore_unused regulator_ignore_unused) comes from the
# boot image header, not from this config. No maxcpus, so all 8 CPUs
# boot at smp_init.
CONFIG_LOCALVERSION="-titanpocket-firstboot"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_DEBUG_KERNEL=y
CONFIG_PRINTK=y
CONFIG_LOG_BUF_SHIFT=20
CONFIG_KALLSYMS=y
CONFIG_SMP=y
# CPU hotplug through sysfs, as stock.
CONFIG_HOTPLUG_CPU=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM64_PA_BITS_48=y
# A73 r0p2 timer erratum, as stock; needed once CPU4-7 boot.
CONFIG_ARM64_ERRATUM_858921=y
CONFIG_RELOCATABLE=y
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_EFI is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_FILE_LOCKING=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_TTY=y
# CONFIG_VT is not set
CONFIG_UNIX98_PTYS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_COMPAT=y
# 32-bit bionic uses the time32 futex and clock syscalls; allnoconfig turns this off
CONFIG_COMPAT_32BIT_TIME=y
# CONFIG_COMPAT_VDSO is not set
CONFIG_ARMV8_DEPRECATED=y
CONFIG_SWP_EMULATION=y
CONFIG_CP15_BARRIER_EMULATION=y
CONFIG_SETEND_EMULATION=y
CONFIG_ARM64_PAN=y
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_USERFAULTFD=y
CONFIG_PROFILING=y
CONFIG_TASKSTATS=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_PSI=y
CONFIG_AUDIT=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_SCHED_DEBUG=y
CONFIG_DEBUG_LIST=y
CONFIG_KFENCE=y
# x18 preservation by the stock secure monitor and TEE is unverified; off for the first boot.
# CONFIG_SHADOW_CALL_STACK is not set

# Board drivers, same as the v9 diagnostic.
CONFIG_PINCTRL_MT6771=y
CONFIG_PINCTRL_MTK_PARIS=y
CONFIG_EINT_MTK=y
CONFIG_COMMON_CLK_MT6771=y
CONFIG_MFD_SYSCON=y
CONFIG_REGMAP_MMIO=y
CONFIG_COMMON_CLK_MT6771_HANDOFF=y
CONFIG_RESET_CONTROLLER=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6358=y
CONFIG_PHY_MTK_MT6771_USB=y
CONFIG_I2C=y
CONFIG_I2C_MT65XX=y
# System sleep: s2idle (the CPUs wait in WFI with timers running), and SPM deep suspend
# for mem, the default, from MTK_SPM_SUSPEND below (P12). PSCI SYSTEM_SUSPEND is listed by the
# stock ATF but stays unused. Turns on CONFIG_PM (runtime PM) too. See SUSPEND_PORT.md.
# Untested on this board: IOMMU. cpuidle is below (P8).
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_ARM_PSCI_NO_SYSTEM_SUSPEND=y
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_LIMIT=100
CONFIG_PM_WAKELOCKS_GC=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# CONFIG_HIBERNATION is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_MTD is not set
# CONFIG_PCI is not set
# CONFIG_DRM is not set

# Persistent kernel log; vendor pmsg/ftrace regions stay reserved.
CONFIG_PSTORE=y
# CONFIG_PSTORE_DEFLATE_COMPRESS is not set
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# CONFIG_PSTORE_PMSG is not set
# CONFIG_PSTORE_FTRACE is not set

# mtk_wdt pinged by the kernel from boot. No rc file starts watchdogd, so the
# kernel keeps pinging until something opens /dev/watchdog (open timeout 0).
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=0

# Power off as stock: MT6358 RTC writes, then PWRHOLD low. Replaces PSCI SYSTEM_OFF.
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_MT6358=y
# SoC AUXADC (mt6577_auxadc as mt6765) for the board thermistor on channel 0.
CONFIG_MEDIATEK_MT6577_AUXADC=y
# MT6358 battery OC throttling as stock (FG_CUR_H/L IRQs); releases gpufreq's boot hold at 485 MHz.
CONFIG_MT6358_BATTERY_OC=y

# UFS engineering binding, same as v9. Block writes aren't gated in the kernel; the
# RAM diagnostics' read-only rule is their init workload. PM, clock gating, WriteBooster
# and HPB stay off. No UFS crypto (blk-crypto fallback instead).
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y
CONFIG_BLK_DEV_SD=y
CONFIG_PHY_MTK_UFS=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_COMMON_CLK_MT6358_UFS=y
# CONFIG_SCSI_UFS_CRYPTO is not set
# CONFIG_SCSI_UFS_BSG is not set
# CONFIG_SCSI_UFS_HPB is not set

# TrustKernel. RAM_DIAGNOSTIC carries the SHM ownership guard. DIAGNOSTIC_LOGGER
# brings back /proc/tkcore and the TEE log reader, with the log SHM held to the
# same TEE reservation, so TA errors reach dmesg and teed's tkcore.log.
CONFIG_TRUSTKERNEL_TEE_SUPPORT=y
CONFIG_TRUSTKERNEL_TEE_FP_SUPPORT=y
# CONFIG_TRUSTKERNEL_TEE_RPMB_SUPPORT is not set
# CONFIG_TEE is not set
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y
CONFIG_OF_RESERVED_MEM=y
CONFIG_ARCH_KEEP_MEMBLOCK=y
CONFIG_TRUSTKERNEL_TEE_RAM_DIAGNOSTIC=y
CONFIG_TRUSTKERNEL_TEE_DIAGNOSTIC_LOGGER=y

# Sunwave fingerprint: /dev/sunwave_fp and fingerprint_key for the stock HAL, which
# sends Home from the front strip (FINGERPRINT_PORT.md). Needs tee_spi_transfer.
CONFIG_SUNWAVE_FP=y

# Modules on for android-base; no 5.10 modules exist and 4.14 ones are refused.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_FORCE_UNLOAD is not set
CONFIG_MODVERSIONS=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH=""

# Hardening from android-base.
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_VMAP_STACK=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# CONFIG_DEVMEM is not set
# CONFIG_USELIB is not set
# CONFIG_FHANDLE is not set
# CONFIG_FW_CACHE is not set
# CONFIG_SYSVIPC is not set

# Binder and Android core.
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_STAGING=y
CONFIG_ASHMEM=y
CONFIG_UID_SYS_STATS=y

# SELinux.
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,selinux,bpf"

# cgroups (cgroups.json: blkio, cpu, cpuset, v2 freezer, memory) and namespaces.
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
# CONFIG_RT_GROUP_SCHED is not set
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# BPF, with tracepoint programs for the platform loader.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
# CONFIG_FUNCTION_TRACER is not set
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y

# Storage stack for first-stage mount, APEX and metadata encryption.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_DEFAULT_KEY=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_DM_BOW=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EROFS_FS=y
# CONFIG_F2FS_FS is not set
CONFIG_QUOTA=y
CONFIG_QUOTACTL=y
CONFIG_QFMT_V2=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_FS_VERITY=y
CONFIG_FS_VERITY_BUILTIN_SIGNATURES=y
CONFIG_FUSE_FS=y
CONFIG_INOTIFY_USER=y
CONFIG_MISC_FILESYSTEMS=y
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set

# Crypto for FBE (aes-256-xts/cts), dm-default-key and android-base.
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTS=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_XCBC=y
CONFIG_ARM64_CRYPTO=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_SHA2_ARM64_CE=y

# USB device side for adbd: configfs gadget with FunctionFS.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_GADGET=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_ACC=y
CONFIG_USB_CONFIGFS_F_AUDIO_SRC=y
CONFIG_USB_CONFIGFS_F_MIDI=y

# Input, sound and RTC cores from android-base (no Pocket drivers yet).
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
# Titan Pocket keyboard (aw9523 on i2c4 0x58).
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_AW9523=y
# Side keys as stock: mtk-kpd with the keypad matrix (volume) and the MT6358
# power and home keys, plus stock's 8 s power key long-press reset.
CONFIG_KEYBOARD_MTK=y
CONFIG_KPD_PWRKEY_USE_PMIC=y
CONFIG_ONEKEY_REBOOT_NORMAL_MODE=y
CONFIG_ONEKEY_REBOOT_OTHER_MODE=y
CONFIG_KPD_PMIC_LPRST_TD=0
CONFIG_MTK_MRDUMP_KEY=y
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_SERIO is not set
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
# Titan Pocket keyboard touchpad (Synaptics RMI4 on i2c6, input device mtk-pad).
CONFIG_INPUT_POCKET_TOUCHPAD=y
# Titan Pocket touchscreen (GT1151QM on i2c0, input device mtk-tpd).
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_POCKET_GT1151=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y
CONFIG_USB_HID=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
# Keyboard backlight, button-backlight on GPIO 159.
CONFIG_LEDS_MT65XX_BUTTON=y
CONFIG_HID_SONY=y
CONFIG_SONY_FF=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_RTC_CLASS=y
# MT6358 RTC (rtc-mt6397) as rtc0: alarm wake from suspend and the clock for HCTOSYS.
# It writes no PDN or spare registers, where LK keeps its boot-mode bits.
CONFIG_RTC_DRV_MT6397=y

# Networking from android-base.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_INTERFACE=y
CONFIG_XFRM_MIGRATE=y
CONFIG_XFRM_STATISTICS=y
CONFIG_NET_KEY=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPVTI=y
CONFIG_INET_ESP=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_IPV6=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_INET6_ESP=y
CONFIG_INET6_IPCOMP=y
CONFIG_IPV6_MIP6=y
CONFIG_IPV6_VTI=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_SECMARK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CT_PROTO_DCCP=y
CONFIG_NF_CT_PROTO_SCTP=y
CONFIG_NF_CT_PROTO_UDPLITE=y
CONFIG_NF_CONNTRACK_AMANDA=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_H323=y
CONFIG_NF_CONNTRACK_IRC=y
CONFIG_NF_CONNTRACK_NETBIOS_NS=y
CONFIG_NF_CONNTRACK_PPTP=y
CONFIG_NF_CONNTRACK_SANE=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CONNSECMARK=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
CONFIG_NETFILTER_XT_TARGET_SECMARK=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_HELPER=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MAC=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_MATCH_TIME=y
CONFIG_NETFILTER_XT_MATCH_U32=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_MATCH_ECN=y
CONFIG_IP_NF_MATCH_TTL=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_SECURITY=y
CONFIG_IP_NF_ARPTABLES=y
CONFIG_IP_NF_ARPFILTER=y
CONFIG_IP_NF_ARP_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
# CONFIG_IP6_NF_NAT is not set
# CONFIG_BPFILTER is not set
CONFIG_L2TP=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_EMATCH=y
CONFIG_NET_EMATCH_U32=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_BPF=y
CONFIG_NETDEVICES=y
CONFIG_DUMMY=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_PPP=y
CONFIG_PPP_BSDCOMP=y
CONFIG_PPP_DEFLATE=y
CONFIG_PPP_MPPE=y
CONFIG_PPTP=y
CONFIG_PPPOL2TP=y
# CONFIG_ANDROID_PARANOID_NETWORK is not set
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set
# CONFIG_PM_AUTOSLEEP is not set
# CONFIG_QCOM_SPEC_SYNC is not set
# CONFIG_WLAN is not set
# CONFIG_USB_NET_DRIVERS is not set

# Display and GPU port glue (drivers/misc/mediatek). Each milestone adds its own symbols.
CONFIG_MEDIATEK_SOLUTION=y
CONFIG_MTK_PLATFORM="mt6771"
# Display port milestone 1: scpsys power-gate clocks (with COMMON_CLK_MT6771) and the SPM calls DISP and Mali make.
CONFIG_MACH_MT6771=y
CONFIG_MTK_BASE_POWER=y
# Display port milestone 2: SMI EXT (drivers/memory/mtk-smi.c, misc/mediatek/smi with mmdvfs) and the legacy M4U (m4u/2.4, m4u/mt6771).
CONFIG_MEMORY=y
CONFIG_MTK_SMI_EXT=y
CONFIG_MTK_M4U=y
# M4U full cache flush through the ATF snoop-filter call, as in stock.
CONFIG_MTK_CACHE_FLUSH_BY_SF=y
# Charger milestone 2: the MT6370 MFD on i2c5 0x34 with the subdevices stock built, less the charger
# (it comes with mtk_charger). rt-regmap and the Richtek flashlight class are what the MFD, FLED and BLED use.
CONFIG_LEDS_TRIGGERS=y
# The timer trigger, as stock: the lights HAL blinks the MT6370 RGB LED by writing "timer" to its trigger
# (evidence/notification-led-rea.md).
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_RT_REGMAP=y
CONFIG_RT_FLASHLIGHT=y
CONFIG_MFD_MT6370_PMU=y
CONFIG_MT6370_PMU_FLED=y
CONFIG_MT6370_PMU_BLED=y
CONFIG_MT6370_PMU_RGBLED=y
CONFIG_MT6370_PMU_LDO=y
CONFIG_MT6370_PMU_DSV=y
# Torch at /sys/class/leds/torch on both MT6370 flash LEDs, stock torch currents (FLASHLIGHT_PORT.md).
CONFIG_POCKET_TORCH=y
# Display port milestone 3: the 4.14 legacy ION (/dev/ion handle ABI and ION_IOC_CUSTOM) with the MTK heaps, in place of 5.10's staging ION.
CONFIG_ION=y
CONFIG_MTK_ION=y
# Charger step 1: the OZ8806 gauge on i2c6 0x2f with the stock bmulib maths and all of stock's
# chip and RTC spare writes, and the battery supply on /battery until mtk_battery is ported.
CONFIG_BATTERY_OZ8806=y
CONFIG_OZ8806_WRITE=y
CONFIG_OZ8806_BATTERY=y
# mtk_charger: the MT6370 charger with its own BC1.2 detection, charger and adapter classes, mtk_charger with
# SwitchCharging and the stock limits, and mt_charger (ac, usb). GM3.0 isn't built: the battery calls read the
# OZ8806. No tcpc, PE or PD. KPOC (power-off charging) is left off.
CONFIG_MTK_GAUGE_VERSION=30
CONFIG_MTK_CHARGER=y
CONFIG_MTK_SWCHR_SUPPORT=y
# CONFIG_MTK_KERNEL_POWER_OFF_CHARGING is not set
CONFIG_MTK_EXTERNAL_CHARGER_TYPE_DETECT=y
CONFIG_MT6370_PMU_CHARGER=y
CONFIG_MT6370_PMU_CHARGER_TYPE_DETECT=y
# Display port milestone 4: CMDQ v3 (/dev/mtk_cmdq) on the 4.14 GCE mailbox, mdp_sync (/dev/mdp_sync) and mtk_sync.
# MTK_CMDQ selects MAILBOX and MTK_CMDQ_MBOX; MTK_CMDQ_V3 picks the 4.14 half of the mailbox driver and helper.
CONFIG_MAILBOX=y
CONFIG_MTK_CMDQ=y
CONFIG_MTK_CMDQ_MBOX=y
CONFIG_MTK_CMDQ_V3=y
CONFIG_MTK_SYNC=y
# Zone-movable CMA: the 4.14 ZMC driver for /reserved-memory/zone-movable-cma-memory (mediatek,zone_movable_cma).
# With SSMR left out it registers no CMA user and gives the whole region back as ordinary memory. DMA_CMA is off as in stock.
CONFIG_CMA=y
CONFIG_ZONE_MOVABLE_CMA=y
CONFIG_CMA_AREAS=7
# CONFIG_DMA_CMA is not set
# DMA zone below 4 GiB, as stock's ZONE_DMA. M4U page tables (GFP_DMA, SLAB_CACHE_DMA) keep 32-bit addresses and
# CMDQ, M4U and DISP use 32-bit DMA masks. With no dma-ranges in the DT, zone_dma_bits is 32, so ZONE_DMA covers
# DRAM from 0x40000000 up to 0x100000000 and ZONE_DMA32 is empty.
CONFIG_ZONE_DMA=y
CONFIG_ZONE_DMA32=y
# Display port milestone 5: DISP (dispsys, videox, /dev/mtk_disp_mgr), mtkfb (fb0 on LK's framebuffer), the R63308
# panel with the LCM helpers, the leds-mt65xx lcd-backlight through disp_pwm, and the ext_disp objects DISP links against.
CONFIG_FB=y
CONFIG_MTK_FB=y
CONFIG_MTK_LCM=y
CONFIG_CUSTOM_KERNEL_LCM="R63308_CASCADEMDZ40"
CONFIG_MTK_LCM_PHYSICAL_ROTATION="0"
CONFIG_LCM_HEIGHT="720"
CONFIG_LCM_WIDTH="720"
CONFIG_MTK_FB_SUPPORT_ASSERTION_LAYER=y
CONFIG_MTK_PQ_COLOR_MODE="DISP"
CONFIG_MTK_PMIC_CHIP_MT6358=y
CONFIG_MTK_DRAMC=y
CONFIG_MTK_QOS_SUPPORT=y
CONFIG_MTK_LEDS=y
CONFIG_LIGHTNESS_MAPPING_VALUE=255
# CONFIG_MTK_AAL_SUPPORT is not set
# CONFIG_SINGLE_PANEL_OUTPUT is not set
CONFIG_MTK_DUAL_DISPLAY_SUPPORT=0
# Boot mode from LK's atag,boot (get_boot_mode, /sys/class/BOOT/BOOT/boot), which DISP's idle manager checks.
CONFIG_MTK_BOOT=y
# CONFIG_FB_SIMPLE is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
CONFIG_MTK_GPU_SUPPORT=y
CONFIG_MTK_GPU_VERSION="mali bifrost r25p0"
CONFIG_MTK_GPU_COMMON_DVFS_SUPPORT=y
CONFIG_MTK_GPU_OPP_STATS_SUPPORT=y
CONFIG_MTK_FREQ_HOPPING=y
# SoC over-temperature protection: mtk_thermal with the MT6771 entry (readings, a critical trip
# that powers off, and stock's 117 C TOPRGU hardware reset). Fuses come from LK's atag,devinfo, so
# mtk-efuse stays off and efusec@11f10000 stays stock for gpufreq.
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_MTK_THERMAL=y
# cpufreq: mediatek-cpufreq on the mcucfg CPU muxes with the board DT's fixed OPPs (793 to 1417 MHz),
# the performance governor by default for first boot (schedutil is built in), and cpufreq cooling for cpu_thermal's 95 and 85 C trips.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
# Utilisation clamping, for Android's cpu.uclamp task profiles with schedutil.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
# Energy model from the board's dynamic-power-coefficient, and the MC sched level (CPU0-3 and CPU4-7 as clusters) for EAS.
CONFIG_ENERGY_MODEL=y
CONFIG_SCHED_MC=y
CONFIG_ARM_MEDIATEK_CPUFREQ=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y
# power_allocator for cpu_thermal (mtk_thermal sets it on the zone with sustainable-power); step_wise stays the
# default for every other zone, cpu_backstop included. Emulation gives emul_temp for the trial (POWER_PORT.md P5).
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_THERMAL_EMULATION=y
# Vibrator as stock: mtk_vibrator on /odm/vibrator@0, the MT6358 VIBR LDO at 3.0 V. Built in so
# /sys/class/leds/vibrator exists before init.rc chowns it on boot.
CONFIG_MTK_VIBRATOR=y
# SCP core for the sensor hub (SENSORS_PORT.md): IPI, ready notify and scp_share; LK loads the firmware.
CONFIG_MTK_TINYSYS_SCP_SUPPORT=y
# Sensor hub stack as stock (SENSORS_PORT.md milestone 2): nanohub over the SCP IPI, hwmon misc
# devices and /dev/sensorlist, accel and alsps hub drivers. Stock values; IIO only holds nanohub's data.
CONFIG_IIO=y
CONFIG_NANOHUB=y
CONFIG_NANOHUB_MTK_IPI=y
CONFIG_MTK_SENSOR_SUPPORT=y
CONFIG_MTK_SENSOR_ARCHITECTURE="1.0"
CONFIG_MTK_HWMON=y
CONFIG_CUSTOM_KERNEL_SENSORHUB=y
CONFIG_CUSTOM_KERNEL_ACCELEROMETER=y
CONFIG_MTK_ACCELHUB=y
CONFIG_CUSTOM_KERNEL_ALSPS=y
CONFIG_MTK_ALSPSHUB=y
# The rest of the hub sensors (SENSORS_PORT.md milestone 3): gyro, mag, step counter, situation
# gestures and fusion, stock values. Stock leaves in-pocket, answer call, flat, SAR, orientation,
# significant motion, barometer and activity off, and so do we.
CONFIG_CUSTOM_KERNEL_GYROSCOPE=y
CONFIG_MTK_GYROHUB=y
CONFIG_CUSTOM_KERNEL_MAGNETOMETER=y
CONFIG_MTK_MAGHUB=y
CONFIG_CUSTOM_KERNEL_SENSOR_FUSION=y
CONFIG_CUSTOM_KERNEL_GRV_SENSOR=y
CONFIG_CUSTOM_KERNEL_GMRV_SENSOR=y
CONFIG_CUSTOM_KERNEL_RV_SENSOR=y
CONFIG_CUSTOM_KERNEL_LINEARACCEL_SENSOR=y
CONFIG_CUSTOM_KERNEL_GRAVITY_SENSOR=y
CONFIG_CUSTOM_KERNEL_UNCALI_ACC_SENSOR=y
CONFIG_CUSTOM_KERNEL_UNCALI_GYRO_SENSOR=y
CONFIG_CUSTOM_KERNEL_UNCALI_MAG_SENSOR=y
CONFIG_MTK_UNCALI_MAGHUB=y
CONFIG_MTK_UNCALI_GYROHUB=y
CONFIG_MTK_GAMEROTVECHUB=y
CONFIG_MTK_ROTATVECHUB=y
CONFIG_MTK_GMAGROTVECHUB=y
CONFIG_MTK_GRAVITYHUB=y
CONFIG_MTK_LINEARACCHUB=y
CONFIG_MTK_ORIENTHUB=y
CONFIG_MTK_UNCALI_ACCHUB=y
CONFIG_CUSTOM_KERNEL_STEP_COUNTER=y
CONFIG_MTK_STEPSIGNHUB=y
CONFIG_CUSTOM_KERNEL_SITUATION=y
CONFIG_MTK_STATHUB=y
CONFIG_MTK_WAKEHUB=y
CONFIG_MTK_GLGHUB=y
CONFIG_MTK_PICKUPHUB=y
CONFIG_MTK_DEVICE_ORIENTATION_HUB=y
CONFIG_MTK_MOTION_DETECT_HUB=y
CONFIG_MTK_TILTDETECTHUB=y
# Audio scaffolding (AUDIO_PORT.md milestone 0): the ASoC core and MediaTek's 4.14 sound stack glue,
# stock values. No AFE, PCM or codec objects yet. Mainline SND_SOC_MT8183 and SND_SOC_MT6358 stay off.
CONFIG_SND_SOC=y
CONFIG_MTK_SND_SOC_NEW_ARCH=y
CONFIG_MTK_SND_SOC_CODEC="mt6358"
# mt-snd-card has 32 PCM devices (42 streams); static minors only fit 8 devices per card, so
# snd_card_register fails with -EBUSY. Dynamic minors, as stock.
CONFIG_SND_DYNAMIC_MINORS=y
CONFIG_SND_MAX_CARDS=32
# Connectivity (WIFI_PORT.md milestone 1): the connsys built-in adapter (connadp) with its stubs, and the
# stock connsys options the out-of-tree WMT, Wi-Fi, BT, GPS and FM builds read. MTK_COMBO_WIFI selects
# WIRELESS_EXT and WEXT_PRIV, as stock. cfg80211 built in with testmode, as stock; no mac80211, no rfkill.
CONFIG_MTK_COMBO=y
# MMC core for the SDIO exports wmt_drv links (sdio_detect.o and hif_sdio.o are always built), as stock
# MMC=y. No MMC host driver is built.
CONFIG_MMC=y
# CONFIG_MMC_BLOCK is not set
CONFIG_MTK_COMBO_CHIP_CONSYS_6771=y
CONFIG_MTK_COMBO_BT=y
CONFIG_MTK_COMBO_GPS=y
CONFIG_MTK_COMBO_WIFI=y
CONFIG_MTK_WIFI_MCC_SUPPORT=y
CONFIG_MTK_GPS_SUPPORT=y
# CONFIG_MTK_GPS_EMI is not set
CONFIG_MTK_FMRADIO=y
CONFIG_MTK_FM_CHIP="MT6631_FM"
CONFIG_CFG80211=y
CONFIG_NL80211_TESTMODE=y
CONFIG_CFG80211_DEVELOPER_WARNINGS=y
# CONFIG_CFG80211_DEFAULT_PS is not set
CONFIG_CFG80211_INTERNAL_REGDB=y
CONFIG_CFG80211_CRDA_SUPPORT=y
# CONFIG_CFG80211_WEXT is not set
# BTIF (WIFI_PORT.md milestone 2): the AP side of the connsys STP link, built in as stock.
CONFIG_MTK_BTIF=y
# NFC (WIFI_PORT.md milestone 8): ST21NFC built in as stock, /dev/st21nfc for the stock HAL. Its clock buffer
# call goes to the connectivity adapter's clk_buf_ctrl. Stock's st54spi eSE driver is left out (no st54 device).
CONFIG_MTK_NFC_CLKBUF_ENABLE=y
CONFIG_NFC_CHIP_SUPPORT=y
# Smart amp (AUDIO_PORT.md milestone 3): /dev/smartpa_i2c on the speaker_amp client at I2C 3 0x34, as stock's
# foursemi driver, for the vendor FS16xx libraries. Built in so the node is there for init.mt6771.rc's chmod on boot.
CONFIG_MTK_SMARTPA_FS16XX_I2C=y
# Headset (AUDIO_PORT.md milestone 5): stock's ACCDET on the MT6358, jack detect on PMIC EINT0, /dev/accdet and the
# ACCDET input device. Its AUXADC, efuse and interrupt calls go to pmic/mt6358/pmic_legacy.c over the mt6397 MFD.
CONFIG_MTK_ACCDET=y
CONFIG_ACCDET_EINT_IRQ=y
CONFIG_ACCDET_SUPPORT_EINT0=y
# Modem M2 (MODEM_PORT.md): the calls eccci makes outside itself, VMODEM, clock buffer flight mode, SPM MD source
# request, and logging stubs for PBM, vcorefs and AEE. Nothing calls them until eccci is in (M3).
CONFIG_MTK_CCCI_PLATFORM_DEPS=y
# Modem M4 (MODEM_PORT.md): ccmni network interfaces and set_rps_map, built in as stock. No interface
# appears until eccci (M3) calls ccmni_ops.init; weak stubs stand in for its two port calls until then.
CONFIG_MTK_NET_CCMNI=y
# Modem M5 (MODEM_PORT.md): conn_md, the LTE coex bridge WMT and eccci register with, in place of the connectivity
# stubs (the WMT modules are built with IDC off and don't import it yet). The modem PA thermistor zone on AUXADC
# channel 1 and the modem coolers stock binds to it; they reach the modem through eccci once M3 is in.
CONFIG_MTK_CONN_MD=y
CONFIG_MTK_THERMAL_BTSMDPA=y
CONFIG_MTK_COOLER_MUTT=y
# Modem M3a (MODEM_PORT.md): eccci core, fsm, CLDMA and CCIF and the MT6771 platform code, built in as stock
# (ccmni's GRO and the cooler's calls need it =y).
CONFIG_MTK_ECCCI_DRIVER=y
CONFIG_MTK_ECCCI_CLDMA=y
CONFIG_MTK_ECCCI_C2K=y
# Modem M3b (MODEM_PORT.md): the eccci port layer (/dev/ccci_*, /dev/ttyC*, RPC, IPC, SMEM, net ports), udc and
# the mixdev event log, as stock. Nothing opens a port until the modem probes.
CONFIG_MTK_MIX_DEVICES=y
# Modem M1 (MODEM_PORT.md): ccci_util builds with eccci. MD1 as stock's ulwctg (12), no MD3.
CONFIG_MTK_MD1_SUPPORT=12
CONFIG_MTK_MD3_SUPPORT=0

# debugfs for trial debugging (clk, regmap, gpio); audsys and other gated syscons hide their regmap files (0039)
CONFIG_DEBUG_FS=y

# Lockup reporting (BT_WATCHDOG.md fix 1): soft lockups (a CPU stuck with interrupts on for 20 s) and hung tasks
# (120 s in D state) print their backtrace to the console, so pstore names the stuck code. Neither panics: the HW
# watchdog (31 s) still does the reset, and the RCU stall dump (21 s) still prints. No pseudo-NMI or hard-lockup
# detector: arm64 on 5.10 has neither a perf NMI hard-lockup detector nor an NMI backtrace to use them.
CONFIG_SOFTLOCKUP_DETECTOR=y
# CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC is not set
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
# CONFIG_BOOTPARAM_HUNG_TASK_PANIC is not set
# Systracker (BT_WATCHDOG.md fix 2): the infra bus tracker at 0x10208000 ends a bus access that hangs for 100 ms
# (2 s second stage) with a slave error, as stock, so it becomes an oops or SError panic naming the address.
CONFIG_MTK_SYSTRACKER_V2=y
# Video codec (CAMERA_PORT.md milestone V): stock's MT6771 videocodec driver, /dev/Vcodec (and /dev/Vcodec2) for the
# stock 32-bit OMX codecs: power, clocks, the HW lock, IRQ wait and the VDEC/VENC register mmap. Mainline mtk-vcodec stays off.
CONFIG_MTK_VIDEOCODEC_DRIVER=y
# CONFIG_VIDEO_MEDIATEK_VCODEC is not set
# CONFIG_VIDEO_MEDIATEK_VPU is not set
# Camera (CAMERA_PORT.md milestone C0): mtk_i2c_transfer and the hw_trig_i2c_*/i2c_ccu_* calls for imgsensor,
# cam_cal and CCU, over i2c-mt65xx. The ext flags become plain transfers; the hardware trigger and CCU calls fail.
CONFIG_MTK_I2C_SHIM=y
# Camera sensor path (CAMERA_PORT.md milestone C1), as stock: imgsensor v1_1 with seninf and the mt6771 camera_hw
# (MT6358 rails, pin states, MCLK), the OV16880 and OV8865 drivers, cam_cal v1 and the main and sub lens cores with
# AK7371AF. /dev/kd_camera_hw, /dev/seninf, /dev/CAM_CAL_DRV and /dev/MAINAF; nothing is powered until the HAL opens them.
CONFIG_MTK_IMGSENSOR=y
CONFIG_CUSTOM_KERNEL_IMGSENSOR="ov16880_mipi_raw ov8865_mipi_raw"
CONFIG_MTK_CAM_CAL=y
CONFIG_MTK_LENS=y
# CONFIG_MTK_LENS_USE_MODULE is not set
# Camera flashlight (CAMERA_PORT.md milestone C2), as stock: the core with /dev/flashlight, flashlights-mt6370 on the Richtek
# class, power throttling (strict) and DLPT. The low battery and percent notifiers and PBM are stubs (see the C2 notes).
CONFIG_MTK_FLASHLIGHT=y
CONFIG_MTK_FLASHLIGHT_MT6370=y
# CONFIG_MTK_FLASHLIGHT_DEBUG is not set
CONFIG_MTK_FLASHLIGHT_PT=y
CONFIG_MTK_FLASHLIGHT_PT_STRICT=y
CONFIG_MTK_FLASHLIGHT_DLPT=y
# Camera ISP (CAMERA_PORT.md milestone C3), as stock: the isp_50 P1 ISP (/dev/camera-isp), DIP (/dev/camera-dip) and
# WPE (/dev/camera-wpe), and the archcounter time sync ISP_GET_GLOBAL_TIME uses. RSC and FDVT follow (milestone C4).
CONFIG_MTK_ARCHCOUNTER_TIMESYNC=y
CONFIG_MTK_CAMERA_ISP=y
CONFIG_MTK_CAMERA_ISP_WPE_SUPPORT=y
CONFIG_MTK_CAMERA_ISP_RSC_SUPPORT=y
CONFIG_MTK_CAMERA_ISP_FD_SUPPORT=y
# Camera CCU (CAMERA_PORT.md milestone C5), as stock: CCU 2.0 with the mt6771 code, /dev/ccu, and the
# i2c-mt65xx CCU channel. The CCU firmware stays on the stock vendor partition.
CONFIG_MTK_CCU=y
# Camera JPEG encoder (CAMERA_PORT.md milestone C6), as stock: JPEG v2 for mt6771, /proc/mtk_jpeg.
CONFIG_MTK_JPEG=y
# SSPM mailbox and IPI core (POWER_PORT.md P7): PLT_INIT with the logger buffer, no firmware load. Not stock's
# MTK_TINYSYS_SSPM_SUPPORT, which would turn on SSPM paths in ged, freqhopping and base/power.
CONFIG_MTK_SSPM_IPI=y
# EMI MPU regions over ATF (POWER_PORT.md P9), as stock: the locked AP region 31 at boot, SCP region 6 and
# the connsys modules' regions 26 and 25, which build their callers with this option.
CONFIG_MTK_EMI=y
# MCDI core-off (POWER_PORT.md P8): cpuidle-psci with the menu governor and the mcdi-cpu state (PSCI
# 0x10001), the APXGPT broadcast timer and the SSPM mailbox 3 client. The state is off on every CPU at boot and
# the client sends nothing until mtk_mcdi.enable=1, so idle stays WFI unless a trial opts in. No PSCI domains:
# the stock ATF has no OSI mode.
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_ARM_PSCI_CPUIDLE=y
# CONFIG_ARM_PSCI_CPUIDLE_DOMAIN is not set
CONFIG_MTK_MCDI_SSPM=y
CONFIG_MTK_CPUHP_POWER_DOWN=y
# SPM base driver (POWER_PORT.md P11a): SPM map, IRQ0, the PCM firmware index and ATF's firmware status, debugfs
# spm/status. No vcorefs, DVFS or suspend.
CONFIG_MTK_SPM_BASE=y
# vcorefs init with Vcore DVS and DRAM DFS off as stock recovery, flag 0x418 (POWER_PORT.md P11b), then the pm_qos
# requests and screen state into the DVFSRC (P11d). init and dvfs (DVS and DFS on, P11f) are on by default,
# spm_vcorefs.init=0 or dvfs=0 turns them off. Debugfs spm/vcorefs, spm/qos.
CONFIG_MTK_SPM_VCOREFS=y
# SPM deep suspend for mem (POWER_PORT.md P12): PCM WDT, SSPM suspend commands, MCDI pause, TOPRGU handover, GIC
# masked but SPM IRQ0 and stock's edge IRQs with SYS_CIRQ latching those, 8250_mtk sleep handshake, SIP suspend
# flags, PSCI CPU_SUSPEND 0x1010005, wake reason and pm_wakeup_irq. With spm_suspend.deep=1 and spm_vcorefs.init=1,
# both default, mem_sleep is deep (P12d); mem_sleep_default=s2idle keeps s2idle.
CONFIG_MTK_SPM_SUSPEND=y
# IR blaster (IR_PORT.md): PWM1 memory mode and /dev/irtx for the stock consumerir HAL, LED power from the MT6370 LDO
# while the device is open.
CONFIG_MTK_PWM=y
CONFIG_MTK_IRTX_PWM_SUPPORT=y
