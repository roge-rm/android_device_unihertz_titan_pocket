+/*
+ * Linux 5.10 passes every subtype registered on the interface as one bitmap
+ * (bit = subtype >> 4) in place of one call per frame type.
+ */
+void mtk_cfg80211_update_mgmt_frame_registrations(struct wiphy *wiphy,
+						  struct wireless_dev *wdev,
+						  struct mgmt_frame_regs *upd)
+{
+	u32 stypes = upd->interface_stypes;
+
+	mtk_cfg80211_mgmt_frame_register(wiphy, wdev, MAC_FRAME_PROBE_REQ,
+					 stypes & BIT(IEEE80211_STYPE_PROBE_REQ >> 4));
+	mtk_cfg80211_mgmt_frame_register(wiphy, wdev, MAC_FRAME_ACTION,
+					 stypes & BIT(IEEE80211_STYPE_ACTION >> 4));
+}
