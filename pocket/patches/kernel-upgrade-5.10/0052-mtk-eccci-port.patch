+static int get_md_adc_val(__attribute__((unused))unsigned int num)
+{
+#ifdef CONFIG_MEDIATEK_MT6577_AUXADC
+	struct iio_channel *chan = md_adc_channel();
+	int raw = 0;
+	int ret;
+
+	if (!chan || num != chan->channel->channel) {
+		CCCI_ERROR_LOG(0, RPC, "ERR:no IIO channel for adc %u\n", num);
+		return -1;
+	}
+	/* stock returns the raw 12-bit code */
+	ret = iio_read_channel_raw(chan, &raw);
+	if (ret < 0)
+		return ret;
+	return raw;
+#else
+	CCCI_ERROR_LOG(0, RPC, "ERR:CONFIG AUXADC and IIO not ready");
+	return -1;
+#endif
+}
