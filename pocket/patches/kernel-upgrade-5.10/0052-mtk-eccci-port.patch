+/* Channel number for an ADC name, as stock's IMM_get_adc_channel_num. */
+static int get_md_adc_info(__attribute__((unused))char *adc_name,
+			   __attribute__((unused))unsigned int len)
+{
+#ifdef CONFIG_MEDIATEK_MT6577_AUXADC
+	struct device_node *node;
+	u32 ch;
+	int i, ret = -1;
+
+	node = of_find_compatible_node(NULL, NULL, "mediatek,adc_channel");
+	if (!node || !adc_name)
+		goto out;
+	for (i = 0; i < ARRAY_SIZE(md_adc_names); i++) {
+		if (of_property_read_u32(node, md_adc_names[i].prop, &ch))
+			continue;
+		if (!strncmp(adc_name, md_adc_names[i].name, len)) {
+			ret = ch;
+			break;
+		}
+	}
+out:
+	of_node_put(node);
+	if (ret < 0)
+		CCCI_ERROR_LOG(0, RPC, "ERR:no adc channel for %.*s\n",
+			len, adc_name ? adc_name : "");
+	return ret;
+#else
+	CCCI_ERROR_LOG(0, RPC, "ERR:CONFIG AUXADC and IIO not ready");
+	return -1;
+#endif
+}
