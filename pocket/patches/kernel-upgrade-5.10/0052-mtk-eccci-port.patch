+static struct platform_driver md_adc_driver = {
+	.driver = {
+		.name = "ccci_md_adc",
+		.of_match_table = md_adc_of_ids,
+		.suppress_bind_attrs = true,
+	},
+	.probe = md_adc_probe,
+};
+builtin_platform_driver(md_adc_driver);
