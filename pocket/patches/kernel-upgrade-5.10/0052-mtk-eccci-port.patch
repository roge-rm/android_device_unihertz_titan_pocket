+static int md_adc_probe(struct platform_device *pdev)
+{
+	struct iio_channel *chan;
+
+	chan = devm_iio_channel_get(&pdev->dev, "md-channel");
+	if (IS_ERR(chan))
+		return PTR_ERR(chan);
+	/* pairs with smp_load_acquire in md_adc_channel(), read by the rpc thread */
+	smp_store_release(&md_adc_chan, chan);
+	CCCI_NORMAL_LOG(0, RPC, "md adc channel %d\n", chan->channel->channel);
+	return 0;
+}
