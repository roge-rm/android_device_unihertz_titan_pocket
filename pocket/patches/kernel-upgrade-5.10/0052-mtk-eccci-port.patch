+/*
+ * The MD's ADC channel. Stock reads it through MTK_AUXADC's IMM calls; here
+ * the upstream mt6577_auxadc IIO driver serves it through the md_auxadc
+ * node's "md-channel" (stock's channel 4, adc_fdd_rf_params_dynamic_custom_ch).
+ * The node stays disabled until the modem is enabled, so nothing probes at boot.
+ */
+static struct iio_channel *md_adc_chan;
+
+/* Stock mtk_auxadc's adc_channel properties and the names it gives them. */
+static const struct {
