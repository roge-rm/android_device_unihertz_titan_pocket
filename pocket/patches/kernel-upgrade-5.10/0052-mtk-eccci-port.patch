+{
+	char *dictionary_content = NULL;
+
+	switch (dic_option) {
+	case UDC_DICT_STD_FOR_SIP:
+		dictionary_content = (char *)rfc3485_dictionary_content;
+		break;
+	case UDC_DICT_OPERATOR:
