+s32 cmdq_op_subtract(struct cmdqRecStruct *handle, CMDQ_VARIABLE *arg_out,
+	CMDQ_VARIABLE arg_b, CMDQ_VARIABLE arg_c)
+{
+	return cmdq_append_logic_command(handle, arg_out, arg_b,
+		CMDQ_LOGIC_SUBTRACT, arg_c);
+}
