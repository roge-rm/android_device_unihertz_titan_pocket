+	 * if SMI dose not process request and upstream HWs
+	 * such as MDP_RSZ send data to WDMA, WDMA FIFO will full finally
+	 */
+	CMDQ_ERR("WDMA grep:%d, FIFO full:%d\n", grep, isFIFOFull);
