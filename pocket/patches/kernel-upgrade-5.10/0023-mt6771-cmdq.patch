+void testcase_longloop(void)
+{
+	u32 last_inst = 0;
+	u32 page_num = 0;
+
+	CMDQ_LOG("%s\n", __func__);
+
+	for (page_num = 1; page_num < 4; page_num++) {
+		for (last_inst = 0; last_inst < 5; last_inst++)
+			_testcase_longloop_inst(CMDQ_CMD_BUFFER_SIZE *
+			page_num / CMDQ_INST_SIZE - last_inst);
+	}
+
+	CMDQ_LOG("%s\n", __func__);
+}
