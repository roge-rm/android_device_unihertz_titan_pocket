+
+	CMDQ_LOG("%s\n", __func__);
+	for (i = 0; i < TEST_PREFETCH_MARKER_LOOP; i++) {
+		CMDQ_MSG("=============== flush:%d/%d ===============\n",
+			i, TEST_PREFETCH_MARKER_LOOP);
