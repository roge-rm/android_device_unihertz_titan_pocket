+bool cmdq_virtual_is_disp_loop(enum CMDQ_SCENARIO_ENUM scenario)
+{
+	bool is_disp_loop = false;
+
+	if (scenario == CMDQ_SCENARIO_TRIGGER_LOOP ||
+		scenario == CMDQ_SCENARIO_TRIGGER_LOOP_SUB)
+		is_disp_loop = true;
+
+	return is_disp_loop;
+}
