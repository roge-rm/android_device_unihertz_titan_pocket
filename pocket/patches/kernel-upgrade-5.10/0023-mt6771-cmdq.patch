+phys_addr_t cmdq_dev_get_gce_node_PA(struct device_node *node, int index)
+{
+	struct resource res;
+	phys_addr_t regBasePA = 0L;
+
+	do {
+		if (of_address_to_resource(node, index, &res) < 0)
+			break;
+
+		regBasePA = (0L | res.start);
+	} while (0);
+
+	return regBasePA;
