+void mdp_ion_free_handle(struct ion_handle *handle)
+{
+#if defined(CONFIG_MTK_IOMMU_V2)
+	if (!g_mdp_ion_client) {
+		CMDQ_ERR("invalid ion client!\n");
+		return;
+	}
+	if (!handle)
+		return;
+
+	ion_free(g_mdp_ion_client, handle);
+
+	CMDQ_MSG("free ion handle 0x%p\n", handle);
+#endif
+}
