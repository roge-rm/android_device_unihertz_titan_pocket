+void *cmdq_mbox_buf_alloc(struct device *dev, dma_addr_t *pa_out)
+{
+	void *va;
+	dma_addr_t pa = 0;
+
+	va = dma_alloc_coherent(dev, CMDQ_BUF_ALLOC_SIZE, &pa, GFP_KERNEL);
+	if (!va) {
+		cmdq_err("alloc dma buffer fail dev:0x%p", dev);
+		dump_stack();
+		return NULL;
+	}
+
+	*pa_out = pa;
+	return va;
+}
