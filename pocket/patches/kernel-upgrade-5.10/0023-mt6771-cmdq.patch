+static void cmdq_mdp_lock_wake_lock(bool lock)
+{
+	if (!mdp_ctx.wake_lock)
+		return;
+
+	if (lock) {
+		if (!mdp_ctx.wake_locked) {
+			__pm_stay_awake(mdp_ctx.wake_lock);
+			mdp_ctx.wake_locked = true;
+		}
+	} else {
+		if (mdp_ctx.wake_locked) {
+			__pm_relax(mdp_ctx.wake_lock);
+			mdp_ctx.wake_locked = false;
+		}
+	}
+}
