+		len = snprintf(text_gpr, ARRAY_SIZE(text_gpr),
+			" GPR R%u:%#x", gprid, val);
+		if (len >= ARRAY_SIZE(text_gpr))
+			cmdq_log("len:%d over text_gpr size:%d",
+				len, ARRAY_SIZE(text_gpr));
