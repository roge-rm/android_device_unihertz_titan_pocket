+	if (i - 1 != data)
+		CMDQ_TEST_FAIL(
+			"reg value is 0x%08x not idx 0x%08x\n", data, i);
+
+	cmdq_pkt_destroy(pkt);
+
+	CMDQ_LOG("%s END\n", __func__);
