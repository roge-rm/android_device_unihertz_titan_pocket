+	cmdq_task_create(CMDQ_SCENARIO_DEBUG_MDP, &handle);
+	cmdq_task_set_secure(handle, gCmdqTestSecure);
+	cmdq_op_init_variable(&result);
+	cmdq_op_init_variable(&get_value);
