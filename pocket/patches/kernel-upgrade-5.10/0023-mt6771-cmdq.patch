+static const struct file_operations cmdqOP = {
+	.owner = THIS_MODULE,
+	.open = cmdq_open,
+	.release = cmdq_release,
+	.unlocked_ioctl = cmdq_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl = cmdq_ioctl_compat,
+#endif
+};
