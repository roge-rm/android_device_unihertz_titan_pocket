+
+	CMDQ_LOG("%s\n", __func__);
+
+	base_inst_num = buffer_num * CMDQ_CMD_BUFFER_SIZE / CMDQ_INST_SIZE;
+	_testcase_boundary_mem_inst(base_inst_num - inst_num);
+
+	CMDQ_LOG("%s END\n", __func__);
+}
