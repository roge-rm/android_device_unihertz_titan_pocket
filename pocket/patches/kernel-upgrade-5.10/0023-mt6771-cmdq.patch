+	cmdq_task_create(CMDQ_SCENARIO_DEBUG_MDP, &handle_conflict);
+	cmdq_task_set_secure(handle_conflict, gCmdqTestSecure);
+	cmdq_task_set_engine(handle_conflict, engines[0] | engines[1]);
