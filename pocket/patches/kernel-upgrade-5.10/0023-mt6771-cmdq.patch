+		cmdq_mdp_lock_wake_lock(true);
+
+	CMDQ_MSG("[CLOCK]MDP SMI clock enable %d\n", smi_ref);
+	cmdq_mdp_get_func()->mdpEnableCommonClock(true);
+
+	CMDQ_PROF_MMP(cmdq_mmp_get_event()->MDP_clock_smi,
+		MMPROFILE_FLAG_PULSE, smi_ref, 1);
