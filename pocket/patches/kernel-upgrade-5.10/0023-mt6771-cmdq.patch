+		1 << CMDQ_DATA_REG_DEBUG);
+
+	CMDQ_LOG("%s\n", __func__);
+
+	pkt = cmdq_pkt_create(clt);
+	cmdq_pkt_wfe(pkt, CMDQ_SYNC_TOKEN_GPR_SET_4);
+
+	buf = list_last_entry(&pkt->buf, typeof(*buf), list_entry);
