+static void cmdq_core_dump_handle_command(const struct cmdqRecStruct *handle,
+	u32 *pc)
+{
+	CMDQ_ERR("============ [CMDQ] Error Command Buffer ============\n");
+
+	cmdq_core_dump_error_buffer(handle, pc, 0);
+}
