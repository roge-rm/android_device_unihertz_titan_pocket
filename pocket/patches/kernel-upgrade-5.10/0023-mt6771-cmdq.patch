+void cmdq_virtual_enable_common_clock_locked(bool enable)
+{
+#ifdef CMDQ_PWR_AWARE
+	if (enable) {
+		CMDQ_VERBOSE("[CLOCK] Enable SMI & LARB0 Clock\n");
+		/* Use SMI clock API */
+#ifdef CONFIG_MTK_SMI_EXT
+		smi_bus_prepare_enable(SMI_LARB0, "CMDQ");
