+#if IS_ENABLED(CONFIG_MTK_CMDQ_MBOX_EXT)
+static void cmdq_print_wait_summary(void *chan, dma_addr_t pc,
+	struct cmdq_instruction *inst)
+{
+#define txt_len 128
+	char text[txt_len];
+	char text_gpr[30] = {0};
+	void *base;
+	u32 gprid, val, len;
