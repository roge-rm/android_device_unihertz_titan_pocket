+	int status = 0;
+	/* set the slot value directly */
+	status = cmdqCoreWriteWriteAddress(h_backup_slot + slot_index *
+		sizeof(u32), value);
+	return status;
+
+#else
+	CMDQ_ERR("func:%s failed since CMDQ doesn't support GPR\n", __func__);
