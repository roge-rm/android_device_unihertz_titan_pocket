+	if (id >= SMI_DEV_NUM) {
+		SMIDBG("Invalid id:%u, SMI_DEV_NUM=%u, user=%s\n",
+			id, SMI_DEV_NUM, user);
+		return -EINVAL;
+	}
+	if (!smi_dev[id]) {
+		pr_notice_ratelimited("SMI%u not probed, user=%s\n", id, user);
+		return -ENXIO;
+	}
+	smi_clk_record(id, true, user);
+	if (id == SMI_LARB0 && user && !strcmp(user, "DISP"))
+		atomic_inc(&smi_disp_refs);
