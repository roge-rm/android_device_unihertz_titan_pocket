+	/* Update HW runtime option */
+	g_mmdvfs_adaptor->enable_vcore = !disable_mmdvfs;
+	g_mmdvfs_adaptor->enable_pll_hopping = !disable_freq_hopping;
+	g_mmdvfs_adaptor->enable_clk_mux = !disable_freq_mux;
