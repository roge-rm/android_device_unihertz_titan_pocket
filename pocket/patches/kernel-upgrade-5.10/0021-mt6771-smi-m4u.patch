+static inline void m4u_enable_intr(unsigned int m4u_id)
+{
+	M4U_WriteReg32(gM4UBaseAddr[m4u_id], REG_MMU_INT_L2_CONTROL, 0x6f);
+	M4U_WriteReg32(gM4UBaseAddr[m4u_id],
