+struct kicker_config {
+	int kicker;
+	int opp;
+	int dvfs_opp;
+};
+
+enum dvfs_kicker {
+	KIR_MM = 0,
+	KIR_DCS,
+	KIR_UFO,
+	KIR_PERF,
+	KIR_EFUSE,
+	KIR_PASR,
+	KIR_SDIO,
+	KIR_USB,
