+int mmdvfs_set_fine_step_force(enum MTK_SMI_BWC_SCEN smi_scenario,
+	int mmdvfs_step)
+{
+	int ret = 0;
+
+	if (!g_mmdvfs_adaptor) {
+		MMDVFSMSG("step_force: g_mmdvfs_adaptor is NULL\n");
+		return -1;
+	}
+
+	/* Update HW runtime option */
