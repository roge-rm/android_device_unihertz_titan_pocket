+#if IS_ENABLED(CONFIG_MACH_MT6885) || IS_ENABLED(CONFIG_MACH_MT6893)
+	if (id == 6 || id == 10 || id == 12) {
+		SMIDBG("Invalid id:%u user:%s\n", id, user);
+		return -EINVAL;
+	}
+
+	switch (id) {
+	case 0:
+	case 1:
+	case 5:
+	case 7:
+	case 14:
+	case 17:
+		ret = smi_unit_prepare_enable(21); // disp
+		if (ret)
+			return ret;
+		ret = smi_unit_prepare_enable(24); // disp-subcom
+		if (ret)
+			return ret;
+		ret = smi_unit_prepare_enable(25); // disp-subcom1
+		if (ret)
+			return ret;
+		break;
+	case 2:
+	case 3:
+	case 4:
+	case 8:
+	case 9:
+	case 13:
+	case 16:
+	case 18:
+		ret = smi_unit_prepare_enable(22); // mdp
+		if (ret)
+			return ret;
+		ret = smi_unit_prepare_enable(26); // mdp-subcom
+		if (ret)
+			return ret;
+		ret = smi_unit_prepare_enable(27); // mdp-subcom1
+		if (ret)
+			return ret;
+		break;
+	case 11:
+	case 19:
+	case 20:
+		ret = smi_unit_prepare_enable(21); // disp
+		if (ret)
+			return ret;
+		ret = smi_unit_prepare_enable(24); // disp-subcom
+		if (ret)
+			return ret;
+		ret = smi_unit_prepare_enable(25); // disp-subcom1
+		if (ret)
+			return ret;
+		ret = smi_unit_prepare_enable(22); // mdp
+		if (ret)
+			return ret;
+		ret = smi_unit_prepare_enable(26); // mdp-subcom
+		if (ret)
+			return ret;
+		ret = smi_unit_prepare_enable(27); // mdp-subcom1
