+static inline int larb_2_m4u_slave_id(int larb)
+{
+	int i;
+
+	for (i = 0; i < gM4u_port_num; i++) {
+		if (gM4uPort[i].larb_id == larb)
+			return gM4uPort[i].m4u_slave;
+	}
+	return 0;
