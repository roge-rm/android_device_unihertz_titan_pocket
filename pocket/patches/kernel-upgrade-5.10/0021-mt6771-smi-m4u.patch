+		if (ret)
+			return ret;
+		break;
+	case 13:
+		ret = smi_unit_prepare_enable(23); // sysram
+		if (ret)
+			return ret;
+		ret = smi_unit_prepare_enable(29); // cam-subcom
+		if (ret)
+			return ret;
+		ret = smi_unit_prepare_enable(31); // cam-subcom2
+		if (ret)
+			return ret;
+		break;
+	case 14:
+		ret = smi_unit_prepare_enable(23); // sysram
+		if (ret)
+			return ret;
+		ret = smi_unit_prepare_enable(30); // cam-subcom1
+		if (ret)
+			return ret;
+		ret = smi_unit_prepare_enable(31); // cam-subcom2
+		if (ret)
+			return ret;
+		break;
+	case 16:
+	case 17:
+	case 18:
+		ret = smi_unit_prepare_enable(23); // sysram
+		if (ret)
+			return ret;
+		ret = smi_unit_prepare_enable(31); // cam-subcom2
+		if (ret)
+			return ret;
