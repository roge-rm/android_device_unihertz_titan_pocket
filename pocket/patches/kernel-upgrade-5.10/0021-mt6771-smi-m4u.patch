+		M4U_PRINT_LOG_OR_SEQ(seq,
+			"%s normal_reg:0x%x\n",
+			__func__,
+			M4U_ReadReg32(larb_base, SMI_LARB_NON_SEC_CONx(l_port)));
+	}
+
+	M4U_PRINT_LOG_OR_SEQ(seq,
+			"%s larb:%d, port:%s, mmu_en:%d\n",
+			__func__, larb, m4u_get_port_name(tf_port),
+			!!mmu_en);
+}
