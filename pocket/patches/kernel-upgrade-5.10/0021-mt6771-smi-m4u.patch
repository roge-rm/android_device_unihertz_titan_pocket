+/* put ref count on all pages in sgtable */
+int m4u_put_sgtable_pages(struct sg_table *table)
+{
+	int i;
+	struct scatterlist *sg;
+
+	for_each_sg(table->sgl, sg, table->nents, i) {
+		struct page *page = sg_page(sg);
+
+		if (page)
+			put_page(page);
+	}
+	return 0;
+}
