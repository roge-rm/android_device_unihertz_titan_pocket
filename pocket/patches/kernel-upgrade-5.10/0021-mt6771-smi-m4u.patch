+{
+	int ret;
+	struct m4u_sec_context *ctx;
+
+	ctx = m4u_sec_ctx_get(CMD_M4U_REG_RESTORE);
+	if (!ctx)
+		return -EFAULT;
+
+	ctx->m4u_msg->cmd = CMD_M4U_REG_RESTORE;
+
+	ret = m4u_exec_cmd(ctx);
+	if (ret) {
+		M4UMSG("m4u exec command fail\n");
+		ret = -1;
+		goto out;
+	}
+
+	ret = ctx->m4u_msg->rsp;
+
+out:
+	m4u_sec_ctx_put(ctx);
+	return ret;
+}
