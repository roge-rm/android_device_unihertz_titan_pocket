+void verify_ret(int ret, unsigned int start, unsigned int end)
+{
+	switch (ret) {
+	case -1:
+		M4UMSG("test range [0x%x, 0x%x] config error\n", start, end);
+		break;
+	case 1:
+		M4UMSG(
+			"test range [0x%x, 0x%x] is in the vpu region\n",
+			start, end);
+		break;
+	case 0:
+		M4UMSG(
+			"test range [0x%x, 0x%x] is out of vpu region\n",
+			start, end);
+		break;
+	default:
+		break;
+	}
+}
