+void m4u_print_port_status(struct seq_file *seq, int tf_port)
+{
+	int mmu_en = 0;
+	int m4u_index, larb, l_port;
+	unsigned long larb_base;
+
+	m4u_index = m4u_port_2_m4u_id(tf_port);
+	larb = m4u_port_2_larb_id(tf_port);
