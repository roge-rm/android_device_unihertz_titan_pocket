+int mmdvfs_set_fine_step(enum MTK_SMI_BWC_SCEN smi_scenario, int mmdvfs_step)
+{
+	if (disable_mmdvfs || g_mmdvfs_mgr->is_mmdvfs_start == 0) {
+		MMDVFSMSG("MMDVFS request denalied; scen:%d, step:%d\n",
