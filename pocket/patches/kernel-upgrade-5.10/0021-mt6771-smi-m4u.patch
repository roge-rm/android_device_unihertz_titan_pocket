+static inline char *m4u_get_port_name(int portID)
+{
+	if ((portID < gM4u_port_num) &&  (portID >= M4U_PORT_DISP_OVL0))
+		return gM4uPort[portID].name;
+
+	return "m4u_port_unknown";
