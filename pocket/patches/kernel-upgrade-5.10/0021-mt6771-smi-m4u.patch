+#define SMI_LARB_CON_CLR		(0x18)
+#define SMI_LARB_VC_PRI_MODE		(0x20)
+#define SMI_LARB_CMD_THRT_CON		(0x24)
+#define SMI_LARB_SW_FLAG		(0x40)
