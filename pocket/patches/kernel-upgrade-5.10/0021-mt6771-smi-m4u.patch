+				NULL, buf_size,
+				M4U_PROT_READ | M4U_PROT_CACHE, 0, &mva);
+		if (ret) {
+			m4u_info("alloc using kmalloc fail:va=0x%p,size=0x%x\n",
+				 va[i], buf_size);
