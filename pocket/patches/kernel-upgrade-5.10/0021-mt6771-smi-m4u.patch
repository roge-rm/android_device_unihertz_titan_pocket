+static struct pg_callbacks smi_clk_subsys_handle = {
+	.after_on = smi_subsys_after_on,
+	.before_off = smi_subsys_before_off,
+#if !IS_ENABLED(SMI_CCF_NO_DUMP)
+	.debug_dump = smi_subsys_debug_dump,
+#endif
+};
