+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include "scp_ipi.h"
+#include "scp_helper.h"
+#include "scp_excep.h"
+
+/*
+ * dispatch scp irq: the SCP to host IPI, or its watchdog. A WDT is logged
+ * and the SCP marked stopped; without recovery nothing restarts it. The WDT
+ * bit is cleared at once: stock's recovery build first waited up to 200 ms
+ * for SCP_GPR_CM4_A_REBOOT to read CM4_A_READY_TO_REBOOT, its non-recovery
+ * build cleared at once as here.
+ * @param irq:      irq id
+ * @param dev_id:   should be NULL
+ */
+irqreturn_t scp_A_irq_handler(int irq, void *dev_id)
+{
+	unsigned int reg = readl(SCP_A_TO_HOST_REG);
+	int reboot = 0;
+
+	if (reg & SCP_IRQ_WDT) {
+		pr_notice("[SCP] CM4 A WDT exception\n");
+		scp_A_dump_regs();
+		reboot = 1;
+		reg &= SCP_IRQ_WDT;
+	}
+
+	if (reg & SCP_IRQ_SCP2HOST) {
+		/* if WDT and IPI triggered on the same time, ignore the IPI */
+		if (!reboot)
+			scp_A_ipi_handler();
+		reg &= SCP_IRQ_SCP2HOST;
+	}
+
+	writel(reg, SCP_A_TO_HOST_REG);
+
+	if (reboot) {
+		scp_aed_reset(EXCEP_RUNTIME, SCP_A_ID);
+		scp_mark_stopped();
+	}
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * scp irq initialize
+ */
+void scp_A_irq_init(void)
+{
+	writel(SCP_IRQ_SCP2HOST, SCP_A_TO_HOST_REG); /* clear scp irq */
+}
