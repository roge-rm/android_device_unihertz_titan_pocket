+/*
+ * SCP exceptions, cut down to the kernel log: the type, PC, LR and the
+ * status registers. No AED and no SRAM or L1C dump.
+ */
+
+#include <linux/io.h>
+#include <linux/mutex.h>
+#include <linux/workqueue.h>
+#include "scp_ipi.h"
