+/* Reads PWR_STATUS and PWR_STATUS_2ND; -ENODEV until scpsys has mapped SPM. */
+int __init mt6771_spm_pwr_status(u32 *sta, u32 *sta_2nd)
+{
+	if (!spm_base)
+		return -ENODEV;
+	*sta = spm_read(PWR_STATUS);
+	*sta_2nd = spm_read(PWR_STATUS_2ND);
+	return 0;
+}
