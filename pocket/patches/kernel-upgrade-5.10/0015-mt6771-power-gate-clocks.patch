--- /dev/null
+++ b/drivers/misc/mediatek/Kconfig
@@ -0,0 +1,52 @@
+source "drivers/misc/mediatek/tkcore/Kconfig"
+
+menuconfig MEDIATEK_SOLUTION
+	bool "MediaTek 4.14 driver glue for the display and GPU port"
+	default n
+	help
+	  Turns on the MediaTek display and GPU drivers and shows
+	  MTK_PLATFORM. Each driver directory has its own symbol.
+
+if MEDIATEK_SOLUTION
+
+config MTK_PLATFORM
+	string "MTK platform name"
+	default "mt6771"
+
+# T declares this in arch/arm64/Kconfig.platforms with SoC selects. Here it
+# only gates the MT6771 branches of the 4.14 Makefiles and sources.
+config MACH_MT6771
+	bool "MediaTek MT6771"
+	help
+	  Selects the MT6771 code in the 4.14 MediaTek drivers.
+
+# The PMIC stock pairs with the MT6771. Like MACH_MT6771 it only picks the
+# MT6358 branches of the 4.14 sources.
+config MTK_PMIC_CHIP_MT6358
+	bool "MediaTek MT6358 PMIC"
+	help
+	  Selects the MT6358 code in the 4.14 MediaTek drivers.
+
+# The DRAMC driver isn't ported. This only lets the 4.14 callers use the
+# dramc/mt6771/mtk_dramc.h answers (LPDDR4X, 2 channels, 3600) as stock does.
+config MTK_DRAMC
+	bool "MediaTek DRAM controller queries"
+	help
+	  Picks the DRAM-type branches in the 4.14 DISP layering rule.
+
+# Turns on the 4.14 PM QoS requests in DISP and SMI mmdvfs. They go to the
+# no-op pm_qos calls in include/linux/pm_qos.h and the mmdvfs_pmqos.h stubs.
+config MTK_QOS_SUPPORT
+	bool "MediaTek MM PM QoS requests"
+	help
+	  Builds the 4.14 PM QoS request paths; nothing listens to them.
+
+config MTK_BASE_POWER
+	bool "MediaTek power management"
+	help
+	  For MediaTek power management features, such as CPU idle,
+	  CPU suspend, CPU DVFS, GPU DVFS,
+	  Select if you want to enable MediaTek power
+	  management feature.
+
+endif
