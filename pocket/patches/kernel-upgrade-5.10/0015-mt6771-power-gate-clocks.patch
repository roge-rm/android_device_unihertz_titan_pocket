+static void dump_cg_state(const char *clkname)
+{
+	struct clk *c = __clk_lookup(clkname);
+
+	if (IS_ERR_OR_NULL(c)) {
+		pr_notice("[%17s: NULL]\n", clkname);
+		return;
+	}
+
+	pr_notice("[%-17s: %3d]\n",
+		__clk_get_name(c),
+		__clk_get_enable_count(c));
+}
