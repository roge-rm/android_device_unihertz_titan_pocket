+	 unsigned char cbcrVScale)
+{
+	unsigned int u4Value;
+
+
+	/* yHScale =  yHScale; */
+	/* yVScale =  yVScale; */
+	/* cbcrHScale = cbcrHScale; */
+	/* cbcrVScale = cbcrVScale; */
+#if 0
