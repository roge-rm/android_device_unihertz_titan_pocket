+	if (exif_en) {
+		u4Value = IMG_REG_READ(REG_ADDR_JPEG_ENC_CTRL);
+		u4Value |= JPEG_ENC_EN_JFIF_EXIF;
+		IMG_REG_WRITE((u4Value), REG_ADDR_JPEG_ENC_CTRL);
+	}
+}
