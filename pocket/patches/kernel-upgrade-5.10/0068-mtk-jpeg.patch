+void wait_pr(void)
+{
+	unsigned int timeout1 = 0xF;
+	unsigned int timeout2 = 0xFFFFF;
+	unsigned int timeout3 = 0xFFFFFFF;
+
+
+	while (timeout1 > 0) {
+		while (timeout2 > 0) {
+			while (timeout3 > 0)
+				timeout3--;
+
+			timeout2--;
+		}
+		timeout1--;
+	}
+}
