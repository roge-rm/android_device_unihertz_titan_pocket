+#ifdef CONFIG_COMPAT
+	.proc_compat_ioctl = compat_jpeg_ioctl,
+#endif
+	.proc_open = jpeg_open,
+	.proc_release = jpeg_release,
+	.proc_read = jpeg_read,
+#ifdef JPEG_HYBRID_DEC_DRIVER
+	.proc_mmap = jpeg_mmap,
+#endif
+};
