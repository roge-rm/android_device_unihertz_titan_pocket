+
+	if (yHScale > 3 || yVScale > 3 || cbcrHScale > 3 || cbcrVScale > 3)
+		return 0;
+
+	u4Value = (cbcrVScale << BIT_BRZ_CV_SHIFT) |
+		 (cbcrHScale << BIT_BRZ_CH_SHIFT) |
+		 (yVScale << BIT_BRZ_YV_SHIFT) |
