+#define JPEG_DRV_ENC_INT_STATUS_DONE   0x01
+#define JPEG_DRV_ENC_INT_STATUS_STALL  0x02
+#define JPEG_DRV_ENC_INT_STATUS_VCODEC_IRQ  0x10
