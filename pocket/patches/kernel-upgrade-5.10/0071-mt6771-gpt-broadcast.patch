+/*
+ * MT6771 APXGPT: GPT1 as a clockevent only, on the 13 MHz
+ * system clock, for the tick broadcast while a core is off in MCDI. The arch
+ * timer stays the clocksource and sched_clock: mtk_gpt_init's 13 MHz
+ * sched_clock has the arch timer's rate, so it would replace it.
+ */
+static int __init mtk_gpt_broadcast_init(struct device_node *node)
+{
+	int ret;
+
+	mtk_gpt_clkevt_ops();
+	ret = timer_of_init(node, &to);
+	if (ret)
+		return ret;
+
+	mtk_gpt_setup(&to, TIMER_CLK_EVT, GPT_CTRL_OP_REPEAT);
+	clockevents_config_and_register(&to.clkevt, timer_of_rate(&to),
+					TIMER_SYNC_TICKS, 0xffffffff);
+
+	mtk_gpt_enable_irq(&to, TIMER_CLK_EVT);
+
+	return 0;
+}
+
 TIMER_OF_DECLARE(mtk_mt6577, "mediatek,mt6577-timer", mtk_gpt_init);
+TIMER_OF_DECLARE(mtk_mt6771, "mediatek,mt6771-timer", mtk_gpt_broadcast_init);
 TIMER_OF_DECLARE(mtk_mt6765, "mediatek,mt6765-timer", mtk_syst_init);
