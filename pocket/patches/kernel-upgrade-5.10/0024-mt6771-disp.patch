+static int _rdma_update_callback(unsigned long if_fence)
+{
+	int ret = 0;
+
+	ret |= _Interface_fence_release_callback(if_fence);
+	ret |= _ovl_fence_release_callback(pgc->session_mode);
+	return ret;
+}
