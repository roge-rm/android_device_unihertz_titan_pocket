+				var.yres > MTK_FB_YRES ||
+				var.xres_virtual > MTK_FB_XRESV ||
+				var.yres_virtual > MTK_FB_YRESV ||
+				var.xoffset > MTK_FB_XRES ||
+				var.yoffset > MTK_FB_YRESV * (MTK_FB_PAGES - 1))
+			return -EFAULT;
