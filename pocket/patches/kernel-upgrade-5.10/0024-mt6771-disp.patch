+/**
+ * Store a single color palette entry into a pseudo palette or the hardware
+ * palette if one is available. For now we support only 16bpp and thus store
+ * the entry only to the pseudo palette.
+ */
+static int mtkfb_setcolreg(u_int regno, u_int red, u_int green, u_int blue,
+			   u_int transp, struct fb_info *info)
+{
+	int ret = 0;
+	struct mtkfb_device *fbdev = (struct mtkfb_device *)info->par;
+	unsigned int bpp, size;
+
+	NOT_REFERENCED(transp);
+
+	MSG_FUNC_ENTER();
+
+	bpp = info->var.bits_per_pixel;
+	size = ARRAY_SIZE(fbdev->pseudo_palette);
+	if (regno >= size) {
+		ret = -EINVAL;
+		goto exit;
+	}
+
+	switch (bpp) {
+	case 16:
+		/* RGB 565 */
+		((u32 *) (info->pseudo_palette))[regno] =
+		    ((red & 0xF800) | ((green & 0xFC00) >> 5) |
+		    ((blue & 0xF800) >> 11));
+		break;
+	case 32:
+		/* ARGB8888 */
+		((u32 *) (info->pseudo_palette))[regno] =
+		    (0xff000000) |
+		    ((red & 0xFF00) << 8) | ((green & 0xFF00)) |
+		    ((blue & 0xFF00) >> 8);
+		break;
+
+		/* TODO: RGB888, BGR888, ABGR8888 */
+
+	default:
+		DDPPR_ERR("set color info fail,bpp=%d\n", bpp);
+		ASSERT(0);
+		ret = -EINVAL;
+	}
+
+exit:
+	MSG_FUNC_LEAVE();
+	return ret;
+}
