+				  __LINE__);
+			kfree(layerInfo);
+			return -EFAULT;
+		}
+
+		memset((void *)&session_input, 0, sizeof(session_input));
+		for (i = 0; i < VIDEO_LAYER_COUNT; ++i) {
+			if (layerInfo[i].layer_id >= TOTAL_OVL_LAYER_NUM) {
+				DDPPR_ERR("MTKFB_SET_VIDEO_LAYERS, layer_id invalid=%d\n",
+					 layerInfo[i].layer_id);
