+/* begin for irq check */
+static inline unsigned int gic_irq(struct irq_data *d)
+{
+	return d ? d->hwirq : 0;
+}
+
+static inline unsigned int virq_to_hwirq(unsigned int virq)
+{
+	struct irq_desc *desc;
+	unsigned int hwirq;
+
+	desc = irq_to_desc(virq);
+
+	WARN_ON(!desc);
+	if (!desc)
+		return 0;
+
+	hwirq = gic_irq(&desc->irq_data);
+
+	return hwirq;
+}
+/* end for irq check */
