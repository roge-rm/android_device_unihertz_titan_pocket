+int is_unified_color_fmt_supported(enum UNIFIED_COLOR_FMT ufmt)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(display_engine_supported_color); i++) {
+		if (ufmt == display_engine_supported_color[i])
+			return 1;
+	}
+	return 0;
