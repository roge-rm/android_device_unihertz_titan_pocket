+#define PARTIAL_WIDTH_ALIGN_LINE
+static inline int align_to(int value, int n, int lower_align)
+{
+	int x = value;
+
+	value = (((x) + ((n) - 1)) & ~((n) - 1));
+
+	if (lower_align) {
+
+		if (value > x)
+			value -= n;
+	} else {
+#ifndef PARTIAL_WIDTH_ALIGN_LINE
+		if (value <= x)
+			value += n;
+#else
+		if (value < x)
+			value += n;
+#endif
+	}
+	return value;
+}
