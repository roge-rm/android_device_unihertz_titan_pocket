+			DSI_OUTREGBIT(NULL, struct DSI_PHY_TIMCON0_REG,
+				      DSI_REG[0]->DSI_PHY_TIMECON0, HS_PRPR,
+				      timing.value);
+			DSI_OUTREGBIT(NULL, struct DSI_PHY_TIMCON0_REG,
+				      DSI_REG[1]->DSI_PHY_TIMECON0, HS_PRPR,
+				      timing.value);
+		}
+		break;
+	case HS_ZERO:
+		if (dsi_index == PM_DSI0) {
+			DSI_OUTREGBIT(NULL, struct DSI_PHY_TIMCON0_REG,
+				      DSI_REG[0]->DSI_PHY_TIMECON0, HS_ZERO,
+				      timing.value);
+		} else if (dsi_index == PM_DSI1) {
