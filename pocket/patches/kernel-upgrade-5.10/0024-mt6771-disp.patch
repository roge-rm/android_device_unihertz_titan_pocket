+static int _color_deinit(enum DISP_MODULE_ENUM module, void *cmq_handle)
+{
+#if !defined(CONFIG_MACH_MT6759) && !defined(CONFIG_MACH_MT6739)
+	_color_clock_off(module, cmq_handle);
+#endif
+	return 0;
+}
