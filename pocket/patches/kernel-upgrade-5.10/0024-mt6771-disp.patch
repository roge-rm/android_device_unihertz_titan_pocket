+						  name);
+
+	mmprofile_enable_event_recursive(p->mmp, 1);
+#endif
+	p->level = level;
+
+	memset((void *)&p->logger, 0, sizeof(p->logger));
+	DISPDBG("dprec logger event init, name=%s, level=0x%08x\n",
+		name, level);
+}
