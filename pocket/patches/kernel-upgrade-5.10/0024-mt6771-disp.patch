+	input_phy->src_h = h;
+	input_phy->src_pitch = pitch*2;
+	input_phy->dst_x = 0;
+	input_phy->dst_y = offset;
+	input_phy->dst_w = w;
+	input_phy->dst_h = h;
+	input_phy->aen = 1;
+	input_phy->sur_aen = 0;
+	input_phy->alpha = 255;
+	input_phy->keyEn = 0;
+	input_phy->key = 0;
+	input_phy->src_alpha = 0;
+	input_phy->dst_alpha = 0;
+	input_phy->source = OVL_LAYER_SOURCE_MEM;
