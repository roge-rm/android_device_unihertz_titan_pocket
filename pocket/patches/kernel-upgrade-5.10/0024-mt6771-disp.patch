+	case DISP_MODULE_OVL0_2L:
+		return DISPSYS_OVL0_2L_BASE;
+	case DISP_MODULE_OVL1_2L:
+		return DISPSYS_OVL1_2L_BASE;
+	default:
+		DDPPR_ERR("invalid ovl module=%d\n", module);
+		return -1;
+	}
+	return 0;
