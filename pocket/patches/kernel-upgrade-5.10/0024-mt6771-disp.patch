+			DSI_OUTREGBIT(NULL, struct DSI_PHY_TIMCON1_REG,
+				      DSI_REG[1]->DSI_PHY_TIMECON1, TA_GET,
+				      timing.value);
+		}
+		break;
+	case DA_HS_EXIT:
+		if (dsi_index == PM_DSI0) {
+			DSI_OUTREGBIT(NULL, struct DSI_PHY_TIMCON1_REG,
+				      DSI_REG[0]->DSI_PHY_TIMECON1, DA_HS_EXIT,
+				      timing.value);
+		} else if (dsi_index == PM_DSI1) {
+			DSI_OUTREGBIT(NULL, struct DSI_PHY_TIMCON1_REG,
+				      DSI_REG[1]->DSI_PHY_TIMECON1, DA_HS_EXIT,
+				      timing.value);
