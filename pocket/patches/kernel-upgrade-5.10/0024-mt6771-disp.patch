+}
+
+/*
+ * trigger operation:      VDO+CMDQ  CMD+CMDQ VDO+CPU  CMD+CPU
+ * 9. cmdq insert token:   Y         Y        N        N
+ */
+static int _should_insert_wait_frame_done_token(void)
+{
+	return ext_disp_cmdq_enabled() ? 1 : 0;
+}
