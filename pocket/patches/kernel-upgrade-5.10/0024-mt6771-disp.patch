+	case MTKFB_ERROR_INDEX_UPDATE_TIMEOUT_AEE:
+	{
+		DDPPR_ERR("[DDP] %s():MTKFB_ERROR_INDEX_UPDATE_TIMEOUT\n",
+				__func__);
