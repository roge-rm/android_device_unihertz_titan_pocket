+/* IOCFG_BL_BAS+0X0[13:12] */
+#define FLD_GPIO_IOCFG_BL_BASE_DBI_LSDA		    REG_FLD(2, 12)
+/* IOCFG_BL_BAS+0X0[9:8] */
+#define FLD_GPIO_IOCFG_BL_BASE_DBI_LSCE0B		REG_FLD(2, 8)
+/* IOCFG_BL_BAS+0X0[11:10] */
