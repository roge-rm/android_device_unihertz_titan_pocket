+		return plcm->drv;
+
+	DISPPR_ERROR("WARNING, invalid lcm handle:%p\n", plcm);
+	return NULL;
+}
+
+void _dump_lcm_info(struct disp_lcm_handle *plcm)
+{
+	struct LCM_DRIVER *l = NULL;
+	struct LCM_PARAMS *p = NULL;
+
+	if (plcm == NULL) {
+		DISPPR_ERROR("plcm is null\n");
+		return;
+	}
+
+	l = plcm->drv;
+	p = plcm->params;
+
+	if (!l || !p)
+		return;
+
+	DISPCHECK("[LCM] name: %s\n", l->name);
