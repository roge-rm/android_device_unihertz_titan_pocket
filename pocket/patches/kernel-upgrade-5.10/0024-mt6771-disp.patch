+/**** UT Program ****/
+#ifdef HRT_UT_DEBUG
+static void debug_set_layer_data(struct disp_layer_info *disp_info,
+	int disp_id, int data_type, int value)
+{
+	static int layer_id = -1;
+	struct layer_config *layer_info = NULL;
+
+	if (data_type != HRT_LAYER_DATA_ID && layer_id == -1)
+		return;
+
