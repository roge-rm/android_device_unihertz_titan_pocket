+	case DDP_SCENARIO_SUB_DISP:
+	case DDP_SCENARIO_SUB_RDMA1_DISP:
+	case DDP_SCENARIO_SUB_OVL_MEMOUT:
+	case DDP_SCENARIO_SUB_ALL:
