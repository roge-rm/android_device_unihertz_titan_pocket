+struct logger_buffer {
+	char **buffer_ptr;
+	unsigned int len;
+	unsigned int id;
+	const unsigned int count;
+	const unsigned int size;
+	char name[15];
+};
+
+static struct logger_buffer dprec_logger_buffer[DPREC_LOGGER_PR_NUM] = {
+	{0, 0, 0, ERROR_BUFFER_COUNT, LOGGER_BUFFER_SIZE, "error"},
+	{0, 0, 0, FENCE_BUFFER_COUNT, LOGGER_BUFFER_SIZE, "fence"},
+	{0, 0, 0, DUMP_BUFFER_COUNT, LOGGER_BUFFER_SIZE, "dump"},
+	{0, 0, 0, DEBUG_BUFFER_COUNT, LOGGER_BUFFER_SIZE, "dbg"},
+	{0, 0, 0, ONESHOT_DUMP_BUFFER_COUNT, LOGGER_BUFFER_SIZE,
+	    "oneshot_dump"},
+	{0, 0, 0, STATUS_BUFFER_COUNT, LOGGER_BUFFER_SIZE, "status"},
+};
+bool is_buffer_init;
+char *debug_buffer;
+
+int debug_buffer_size(void)
+{
+#if defined(CONFIG_MTK_ENG_BUILD) || !defined(CONFIG_MTK_GMO_RAM_OPTIMIZE)
+	static int size;
+
+	if (size == 0) {
+		int i;
+
+		size += 4096;
+		for (i = 0; i < DPREC_LOGGER_PR_NUM; i++)
+			size += dprec_logger_buffer[i].count *
+			    LOGGER_BUFFER_SIZE;
+	}
+	return size;
+#else
+	return 10240;
+#endif
+}
+
+void init_log_buffer(void)
+{
+	int i, j, buf_size, buf_idx;
+	char *temp_buf;
+
+	/* 1.allocate debug buffer. This buffer used to store the output data.*/
+	debug_buffer = kcalloc(debug_buffer_size(), sizeof(char), GFP_KERNEL);
+	if (!debug_buffer)
+		goto err;
+
+	/* 2.allocate Error, Fence, Debug and Dump log buffer slot */
+	for (i = 0; i < DPREC_LOGGER_PR_NUM; i++) {
+		char **ptr;
+
+		ptr = kcalloc(dprec_logger_buffer[i].count, sizeof(char *),
+			GFP_KERNEL);
+		if (!ptr)
+			goto err;
+		dprec_logger_buffer[i].buffer_ptr = ptr;
+	}
+
+	/* 3.allocate log ring buffer. */
+	buf_size = sizeof(char) * (debug_buffer_size() - 4096);
+	temp_buf = kzalloc(buf_size, GFP_KERNEL);
+	if (!temp_buf)
+		goto err;
+
+	/* 4.dispatch log ring buffer to each buffer slot */
+	buf_idx = 0;
+
+	for (i = 0; i < DPREC_LOGGER_PR_NUM; i++) {
+		for (j = 0; j < dprec_logger_buffer[i].count; j++) {
+			char **ptr = dprec_logger_buffer[i].buffer_ptr;
+
+			ptr[j] = (temp_buf + buf_idx * LOGGER_BUFFER_SIZE);
+			buf_idx++;
+		}
+	}
+
+	is_buffer_init = true;
+	pr_info("[DISP]%s success\n", __func__);
+	return;
+
+err:
+	pr_err("[DISP]%s: log buffer allocation fail\n", __func__);
+}
