+void mtkfb_waitVsync(void)
+{
+	if (primary_display_is_sleepd()) {
+		DISPMSG("[MTKFB_VSYNC]:mtkfb has suspend, return directly\n");
+		msleep(20);
+		return;
+	}
+	vsync_cnt++;
+#ifdef CONFIG_FPGA_EARLY_PORTING
+	msleep(20);
+#else
+	primary_display_wait_for_vsync(NULL);
+#endif
+	vsync_cnt--;
+
+}
