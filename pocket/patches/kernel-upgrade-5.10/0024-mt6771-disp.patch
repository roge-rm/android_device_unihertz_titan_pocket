+
+int ddp_dbi_dump(enum DISP_MODULE_ENUM module, int level)
+{
+	if (!_is_power_on_status(module)) {
+		DISPERR("sleep dump is invalid\n");
+		return 0;
+	}
+
+	dbi_analysis(module);
+	DBI_DumpRegisters(module, level);
+
+	return 0;
+}
