+			DSI_OUTREGBIT(NULL, struct DSI_PHY_TIMCON2_REG,
+				      DSI_REG[1]->DSI_PHY_TIMECON2, CONT_DET,
+				      timing.value);
+		}
+		break;
+	case CLK_ZERO:
+		if (dsi_index == PM_DSI0) {
+			DSI_OUTREGBIT(NULL, struct DSI_PHY_TIMCON2_REG,
+				      DSI_REG[0]->DSI_PHY_TIMECON2, CLK_ZERO,
+				      timing.value);
+		} else if (dsi_index == PM_DSI1) {
+			DSI_OUTREGBIT(NULL, struct DSI_PHY_TIMCON2_REG,
+				      DSI_REG[1]->DSI_PHY_TIMECON2, CLK_ZERO,
