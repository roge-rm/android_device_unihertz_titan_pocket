+enum mt65xx_led_mode {
+	MT65XX_LED_MODE_NONE,
+	MT65XX_LED_MODE_PWM,
+	MT65XX_LED_MODE_GPIO,
+	MT65XX_LED_MODE_PMIC,
+	MT65XX_LED_MODE_CUST_LCM,
+	MT65XX_LED_MODE_CUST_BLS_PWM
+};
