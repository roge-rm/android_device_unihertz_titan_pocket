+		int i = 1000;
+
+		while (i--) {
+			DAL_Printf("display aee layer test\n");
+			msleep(20);
+			DAL_Clean();
+			msleep(20);
+		}
+	} else if (strncmp(opt, "lfr_setting:", 12) == 0) {
+		unsigned int enable;
+		unsigned int mode;
+		/* unsigned int mode = 3; */
+		unsigned int type = 0;
