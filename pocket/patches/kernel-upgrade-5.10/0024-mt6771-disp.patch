+		char *p = (char *)opt + 11;
+		UINT32 mode = 0;
+
+		ret = kstrtouint(p, 0, &mode);
+		if (ret) {
+			DISPWARN("%d error to parse cmd %s\n", __LINE__, opt);
+			return;
+		}
+		primary_display_switch_dst_mode(mode % 2);
+		return;
+	} else if (strncmp(opt, "cv_switch:", 10) == 0) {
+		char *p = (char *)opt + 10;
