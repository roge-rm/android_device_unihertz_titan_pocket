+static void lcm_udelay(UINT32 us)
+{
+	udelay(us);
+}
+
+static void lcm_mdelay(UINT32 ms)
+{
+	if (ms < 10)
+		udelay(ms * 1000);
+	else
+		msleep(ms);
+}
