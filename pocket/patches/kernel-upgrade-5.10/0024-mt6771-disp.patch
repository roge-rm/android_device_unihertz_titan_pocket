+static struct ovl_info_s {
+	unsigned char ovl_idx;
+	unsigned char layer_num;
+} ovl_infos[OVL_NUM] = {
+	{DISP_MODULE_OVL0, 4}, {DISP_MODULE_OVL0_2L, 2},
+	{DISP_MODULE_OVL1_2L, 2},
+};
+#endif
