+		disp_ccorr_write_coef_reg(cmdq, module, DISP_CCORR0, 1);
+#else
+		DISP_REG_SET(cmdq,
+		DISP_REG_CCORR_EN + ccorr_get_offset(module), 1);
+		CCORR_DBG("FPGA_EARLY_PORTING");
+#endif
+	return 0;
+}
