+		break;
+	case LCM_INTERFACE_DSI1:
+		DISPCHECK("[LCM] interface: DSI1\n");
+		break;
+	case LCM_INTERFACE_DSI_DUAL:
+		DISPCHECK("[LCM] interface: DSI_DUAL\n");
+		break;
