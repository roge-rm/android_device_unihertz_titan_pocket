+unsigned int PanelMaster_is_enable(void)
+{
+	if (atomic_read(&PMaster_enable) == 1)
+		return 1;
+
+	return 0;
+}
+
+unsigned int PanelMaster_set_PM_enable(unsigned int value)
+{
+	atomic_set(&PMaster_enable, value);
+	return 0;
+}
