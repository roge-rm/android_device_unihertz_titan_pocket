+#endif
+	} else if (strncmp(opt, "diagnose_oneshot", 16) == 0) {
+		primary_display_diagnose_oneshot(__func__, __LINE__);
+		return;
+	} else if (strncmp(opt, "diagnose", 8) == 0) {
