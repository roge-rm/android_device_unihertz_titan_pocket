+/**
+ * Free driver resources. Can be called to rollback an aborted initialization
+ * sequence.
+ */
+static void mtkfb_free_resources(struct mtkfb_device *fbdev, int state)
+{
+	switch (state) {
+	case MTKFB_ACTIVE:
+		unregister_framebuffer(fbdev->fb_info);
+		/* lint -fallthrough */
+	case 5:
+		mtkfb_unregister_sysfs(fbdev);
+		/* lint -fallthrough */
+	case 4:
+		mtkfb_fbinfo_cleanup(fbdev);
+		/* lint -fallthrough */
+	case 3:
+		/* DISP_CHECK_RET(DISP_Deinit()); */
+		/* lint -fallthrough */
+	case 2:
+		/*
+		 * fb_va_base is LK's framebuffer, ioremapped and M4U mapped by
+		 * disp_hal_allocate_framebuffer, not from dma_alloc_coherent.
+		 * Stock's dma_free_coherent(NULL, ...) went to dummy dma ops and
+		 * did nothing; 5.10 would oops on the NULL device, so skip it.
+		 */
+		/* lint -fallthrough */
+	case 1:
+		dev_set_drvdata(fbdev->dev, NULL);
+		framebuffer_release(fbdev->fb_info);
+		/* lint -fallthrough */
+	case 0:
+		/* nothing to free */
+		break;
+	default:
+		DDPPR_ERR("free resources fail, state=%d\n", state);
+		break;
+	}
+}
