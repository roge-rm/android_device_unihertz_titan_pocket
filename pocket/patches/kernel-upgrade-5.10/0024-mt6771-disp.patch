+	case MTKFB_ERROR_INDEX_UPDATE_TIMEOUT:
+	{
+		DDPPR_ERR("[DDP] %s():MTKFB_ERROR_INDEX_UPDATE_TIMEOUT\n",
+				__func__);
+		/* call info dump function here */
+		/* mtkfb_dump_layer_info(); */
