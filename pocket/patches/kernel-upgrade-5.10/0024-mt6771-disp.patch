+/* PM suspend */
+static int mtkfb_suspend(struct platform_device *pdev, pm_message_t mesg)
+{
+	DISPFUNC();
+	NOT_REFERENCED(pdev);
+	MSG_FUNC_ENTER();
+	MTKFB_LOG("[FB Driver] %s(): 0x%x\n", __func__, mesg.event);
+	ovl2mem_wait_done();
+	MSG_FUNC_LEAVE();
+	return 0;
+}
