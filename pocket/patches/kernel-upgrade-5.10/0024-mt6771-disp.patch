+static void _mtkfb_draw_block(unsigned long addr, unsigned int x,
+			      unsigned int y, unsigned int w, unsigned int h,
+			      unsigned int color)
+{
+	int i = 0;
+	int j = 0;
+	unsigned long start_addr = addr + MTK_FB_XRESV * 4 * y + x * 4;
+
+	for (j = 0; j < h; j++) {
+		for (i = 0; i < w; i++)
+			mt_reg_sync_writel(color, (start_addr + i * 4 +
+						   j * MTK_FB_XRESV * 4));
+	}
+}
