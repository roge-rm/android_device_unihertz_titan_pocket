+static int path_top_clock_on(void)
+{
+	struct DDP_MANAGER_CONTEXT *c = _get_context();
+	int i = 0;
+
+	if (c->power_state)
+		return 0;
+
+	c->power_state = 1;
+	ddp_path_top_clock_on();
+	for (i = 0; i < DISP_MODULE_NUM; i++) {
+		if (ddp_valid_engine[i])
+			ddp_clk_enable_by_module(i);
+	}
+
+	return 0;
