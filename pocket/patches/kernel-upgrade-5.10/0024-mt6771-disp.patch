+static void _display_set_refresh_rate_post_proc(int fps)
+{
+	if (fps == 60) {
+		/* TODO: switch path after adjusting fps */
+		od_need_start = 0;
+		spm_enable_sodi(1);
+	} else if (fps == 120) {
+		if (!od_by_pass)
+			od_need_start = 1;
+
+		spm_enable_sodi(0);
+	}
+}
+#endif
