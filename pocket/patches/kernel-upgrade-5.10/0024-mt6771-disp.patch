+static int ovl2mem_cmdq_dump(uint64_t engineFlag, int level)
+{
+	DISPFUNC();
+
+	if (pgc->dpmgr_handle != NULL)
+		dpmgr_check_status(pgc->dpmgr_handle);
+	else
+		DISPMSG("ovl2mem dpmgr_handle == NULL\n");
+
+	return 0;
+}
