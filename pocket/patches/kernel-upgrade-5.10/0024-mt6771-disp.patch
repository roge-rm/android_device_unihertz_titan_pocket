+static inline int is_module_ovl(enum DISP_MODULE_ENUM module)
+{
+	if (module == DISP_MODULE_OVL0 ||
+	    module == DISP_MODULE_OVL0_2L || module == DISP_MODULE_OVL1_2L)
+		return 1;
+
+	return 0;
