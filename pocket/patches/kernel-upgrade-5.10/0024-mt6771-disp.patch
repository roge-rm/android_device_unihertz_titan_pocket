+			if (*(tmp + i + 2) != *(tmp2 + i + 2))
+				pr_debug("data: 0x%x 0x%x, index: %d\n",
+					*(tmp + i + 2),
+					*(tmp2 + i + 2), i + 2);
+			if (*(tmp + i + 3) != *(tmp2 + i + 3))
+				pr_debug("data: 0x%x 0x%x, index: %d\n",
+					*(tmp + i + 3),
+					*(tmp2 + i + 3), i + 3);
+			if (*(tmp + i + 4) != *(tmp2 + i + 4))
+				pr_debug("data: 0x%x 0x%x, index: %d\n",
+					*(tmp + i + 4),
+					*(tmp2 + i + 4), i + 4);
+			if (*(tmp + i + 5) != *(tmp2 + i + 5))
+				pr_debug("data: 0x%x 0x%x, index: %d\n",
+					*(tmp + i + 5),
+					*(tmp2 + i + 5), i + 5);
+			if (*(tmp + i + 6) != *(tmp2 + i + 6))
