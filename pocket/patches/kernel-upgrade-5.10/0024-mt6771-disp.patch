+
+	/* save pdev for disp_probe_1 */
+	memcpy(&mydev, pdev, sizeof(mydev));
+
+	disp_helper_option_init();
+
+	if (disp_helper_get_stage() == DISP_HELPER_STAGE_NORMAL)
+		disp_clk_init(pdev);
+
+	disp_probe_cnt++;
+
+	pr_info("disp driver(1) %s end\n", __func__);
+
+	return 0;
+}
