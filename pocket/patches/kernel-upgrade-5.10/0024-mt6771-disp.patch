+			DDPPR_ERR("[FB Driver] is still in MTKFB_POWERON!\n");
+			return ret;
+		}
+		DISPDBG("[FB Driver] enter MTKFB_POWERON\n");
+		DISPDBG("[FB Driver] leave MTKFB_POWERON\n");
+		is_early_suspended = FALSE; /* no care */
+		return ret;
+	}
