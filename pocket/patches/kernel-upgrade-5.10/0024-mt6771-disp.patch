+		return FLD_OVL0_ULTRA_SEL;
+	case DISP_MODULE_OVL0_2L:
+		return FLD_OVL0_2L_ULTRA_SEL;
+	case DISP_MODULE_OVL1_2L:
+		return FLD_OVL1_2L_ULTRA_SEL;
+	default:
+		DDPPR_ERR("invalid ovl module=%d\n", module);
+		return -1;
+	}
+	return 0;
