+		addr_offset + DISP_REG_RDMA_FIFO_CON),
+	    DISP_REG_GET_FIELD(FIFO_CON_FLD_FIFO_PSEUDO_SIZE,
+		addr_offset + DISP_REG_RDMA_FIFO_CON),
+	    DISP_REG_GET_FIELD(FIFO_CON_FLD_FIFO_UNDERFLOW_EN,
+		addr_offset + DISP_REG_RDMA_FIFO_CON));
+	DDPDUMP("THRSHOLD_SODI [11:0]:%u [27:16]:%u\n",
