+int disp_lcm_is_video_mode(struct disp_lcm_handle *plcm)
+{
+	struct LCM_PARAMS *lcm_param = NULL;
+	/* LCM_INTERFACE_ID lcm_id = LCM_INTERFACE_NOTDEFINED; */
+
+	/* DISPFUNC(); */
+	if (_is_lcm_inited(plcm))
+		lcm_param = plcm->params;
+	else
+		return -1;
+
+	switch (lcm_param->type) {
+	case LCM_TYPE_DBI:
+		return 0;
+	case LCM_TYPE_DSI:
+		break;
+	case LCM_TYPE_DPI:
+		return 1;
+	default:
+		DISPPR_ERROR("[LCM] TYPE: unknown\n");
+		break;
+	}
+
+	if (lcm_param->type == LCM_TYPE_DSI) {
+		switch (lcm_param->dsi.mode) {
+		case CMD_MODE:
+			return 0;
+		case SYNC_PULSE_VDO_MODE:
+		case SYNC_EVENT_VDO_MODE:
+		case BURST_VDO_MODE:
+			return 1;
+		default:
+			DISPPR_ERROR("[LCM] DSI Mode: Unknown\n");
+			break;
+		}
+	}
+
+	disp_aee_db_print("LCM parmas is error, type=%d\n", lcm_param->type);
+	return -1;
