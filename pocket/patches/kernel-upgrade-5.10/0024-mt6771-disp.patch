+	}
+	cmdqRecReset(handle);
+	_cmdq_insert_wait_frame_done_token_mira(handle);
+
+	data_config = dpmgr_path_get_last_config(pgc->dpmgr_handle);
+
+	primary_display_config_full_roi(data_config, pgc->dpmgr_handle, handle);
+
+	cmdqRecFlush(handle);
+	cmdqRecDestroy(handle);
+	return ret;
+}
