+do { \
+	if (mtkfb_vsync_on) \
+		VSYNC_WRN(fmt, ##arg); \
+} while (0)
+
+#define MTKFB_VSYNC_FUNC()	\
+	do { \
+		if (mtkfb_vsync_on) \
+			VSYNC_WRN("[Func]%s\n", __func__); \
+	} while (0)
