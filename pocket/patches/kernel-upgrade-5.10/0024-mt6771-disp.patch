+	hrtimer_init(&cmd_mode_update_timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+	cmd_mode_update_timer.function = _DISP_CmdModeTimer_handler;
+	hrtimer_start(&cmd_mode_update_timer, ns_to_ktime(16666666),
+		      HRTIMER_MODE_REL);
+
+	return 0;
+}
