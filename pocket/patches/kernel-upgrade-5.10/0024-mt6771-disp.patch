+			/* early jump out */
+			if (ccorr_without_gamma == 1)
+				continue;
+
+			if (i == j && g_ccorr_color_matrix[i][j] != 1024) {
+				ccorr_without_gamma = 1;
+				identity_matrix = false;
+			} else if (i != j && g_ccorr_color_matrix[i][j] != 0) {
+				ccorr_without_gamma = 1;
