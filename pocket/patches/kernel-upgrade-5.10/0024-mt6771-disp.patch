+static const struct file_operations mtkfb_vsync_fops = {
+	.owner = THIS_MODULE,
+	.unlocked_ioctl = mtkfb_vsync_unlocked_ioctl,
+	.open = mtkfb_vsync_open,
+	.release = mtkfb_vsync_release,
+	.flush = mtkfb_vsync_flush,
+	.read = mtkfb_vsync_read,
+};
