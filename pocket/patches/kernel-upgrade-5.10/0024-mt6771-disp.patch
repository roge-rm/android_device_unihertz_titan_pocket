+	case TA_SURE:
+		if (dsi_index == PM_DSI0) {
+			DSI_OUTREGBIT(NULL, struct DSI_PHY_TIMCON1_REG,
+				      DSI_REG[0]->DSI_PHY_TIMECON1, TA_SURE,
+				      timing.value);
+		} else if (dsi_index == PM_DSI1) {
+			DSI_OUTREGBIT(NULL, struct DSI_PHY_TIMCON1_REG,
+				      DSI_REG[1]->DSI_PHY_TIMECON1, TA_SURE,
