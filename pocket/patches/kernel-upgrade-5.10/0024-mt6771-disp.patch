+int _is_lcm_inited(struct disp_lcm_handle *plcm)
+{
+	if (plcm) {
+		if (plcm->params && plcm->drv)
+			return 1;
+	}
+
+	DISPPR_ERROR("WARNING, invalid lcm handle: %p\n", plcm);
+	return 0;
+}
