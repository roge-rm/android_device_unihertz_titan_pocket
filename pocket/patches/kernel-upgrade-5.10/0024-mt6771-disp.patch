+/* Release the fb_info object */
+static void mtkfb_fbinfo_cleanup(struct mtkfb_device *fbdev)
+{
+	MSG_FUNC_ENTER();
+
+	fb_dealloc_cmap(&fbdev->fb_info->cmap);
+
+	MSG_FUNC_LEAVE();
+}
