+int mtkfb_pm_suspend(struct device *device)
+{
+	/* pr_debug("calling %s()\n", __func__); */
+
+	struct platform_device *pdev = to_platform_device(device);
+
+	if (pdev == NULL) {
+		disp_aee_db_print("pdev is NULL\n");
+		return -1;
+	}
+
+	/*
+	 * The display holds pri_disp_wakelock while it is on. Android's
+	 * wakeup_count check aborts suspend on it; a plain write to
+	 * /sys/power/state skips that check, the display keeps scanning out
+	 * through SPM suspend and a display IRQ at resume can read an OVL that
+	 * no longer answers. Refuse suspend here in that case.
+	 */
+	if (primary_display_wakelock_held()) {
+		pr_info("[FB Driver] display on, refusing system suspend\n");
+		return -EBUSY;
+	}
+
+	return mtkfb_suspend(pdev, PMSG_SUSPEND);
+}
