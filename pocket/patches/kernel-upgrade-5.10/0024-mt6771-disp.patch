+
+	spin_unlock_irqrestore(&gdprec_logger_spinlock, flags);
+
+	dprec_to_mmp(type_logsrc, MMPROFILE_FLAG_PULSE,
+		     (unsigned int)l->period_max_frame, fence_idx);
+}
