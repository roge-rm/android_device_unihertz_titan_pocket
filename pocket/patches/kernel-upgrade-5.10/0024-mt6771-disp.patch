+			input = &session_input.config[layer_num];
+			session_input.config_layer_num++;
+			_convert_fb_layer_to_disp_input(&layerInfo[i], input);
+		}
+		primary_display_config_input_multiple(&session_input);
+		primary_display_trigger(1, NULL, 0);
