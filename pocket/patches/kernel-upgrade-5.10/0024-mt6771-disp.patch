+static void _dbi_basic_irq_enable(enum DISP_MODULE_ENUM module, void *cmdq)
+{
+	if (module == DISP_MODULE_DBI) {
+		DBI_OUTREGBIT(cmdq, struct DBI_REG_INTERRUPT,
+				DBI_REG->INT_ENABLE, COMPLETED, 1);
+		DBI_OUTREGBIT(cmdq, struct DBI_REG_INTERRUPT,
+				DBI_REG->INT_ENABLE, SYNC, 1);
+	}
+}
