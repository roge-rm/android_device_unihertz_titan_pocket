+#define OUTREG8(x, y)	WRITE_REGISTER_UINT8((UINT8 *)((void *)(x)), (UINT8)(y))
+#define SETREG8(x, y)	OUTREG8(x, INREG8(x)|(y))
+#define CLRREG8(x, y)	OUTREG8(x, INREG8(x)&~(y))
