+static int release_session_buffer(unsigned int session)
+{
+	mutex_lock(&disp_session_lock);
+
+	if (session == 0) {
+		DISPPR_ERROR("%s: session id:0x%08x\n", __func__, session);
+		mutex_unlock(&disp_session_lock);
+		return -1;
+	}
+
+	mtkfb_release_session_fence(session);
+
+	mutex_unlock(&disp_session_lock);
+	return 0;
+}
