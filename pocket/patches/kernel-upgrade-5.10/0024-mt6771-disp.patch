+		err = get_user(d, data32);
+		err |= put_user(d, data);
+		if (err)
+			return err;
+
+		ret = file->f_op->unlocked_ioctl(file, FB_GET_MISC,
+						 (unsigned long)data);
+		err |= get_user(d, data);
+		err |= put_user(d, data32);
+		return ret ? ret : err;
+	}
+	default:
+		return ret;
+	}
+}
