+			format = UFMT_BGR888;
+			break;
+		case MTK_FB_FORMAT_ARGB8888:
+			format = UFMT_ARGB8888;
+			break;
+		case MTK_FB_FORMAT_RGB565:
+			format = UFMT_RGB565;
+			break;
+		case MTK_FB_FORMAT_UYVY:
