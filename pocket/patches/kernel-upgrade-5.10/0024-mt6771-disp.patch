+static int ovl_check_input_param(struct OVL_CONFIG_STRUCT *cfg)
+{
+	if ((cfg->addr == 0 && cfg->source == 0) ||
+	    cfg->dst_w == 0 || cfg->dst_h == 0) {
+		DDPERR("ovl parameter invalidate, addr=0x%08lx, w=%d, h=%d\n",
+		       cfg->addr, cfg->dst_w, cfg->dst_h);
+		ASSERT(0);
+		return -1;
+	}
+
+	return 0;
+}
