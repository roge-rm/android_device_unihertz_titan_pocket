+			"MAG DRIVER OLD ARCHITECTURE DON'T SUPPORT ACC COMMON VERSION FLUSH\n");
+	if (err < 0)
+		pr_err("mag enable flush err %d\n", err);
+	mutex_unlock(&mag_context_obj->mag_op_mutex);
+	if (err)
