+{
+	situation_driver_add(&stat_init_info, ID_STATIONARY_DETECT);
+	return 0;
+}
+
+static void __exit stat_exit(void)
+{
+	pr_debug("%s\n", __func__);
+}
+
+module_init(stat_init);
+module_exit(stat_exit);
