+{
+	int idx, err = 0;
+	int num = (int)(ARRAY_SIZE(gyrohub_attr_list));
+
+	if (driver == NULL)
+		return -EINVAL;
+
+	for (idx = 0; idx < num; idx++)
+		driver_remove_file(driver, gyrohub_attr_list[idx]);
+
+	return err;
