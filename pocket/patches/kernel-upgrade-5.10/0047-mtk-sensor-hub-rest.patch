+
+	pr_debug("%s buf=%s\n", __func__, buf);
+	mutex_lock(&gyro_context_obj->gyro_op_mutex);
+	if (!strncmp(buf, "1", 1)) {
+		cxt->enable = 1;
+		cxt->is_active_data = true;
+	} else if (!strncmp(buf, "0", 1)) {
+		cxt->enable = 0;
