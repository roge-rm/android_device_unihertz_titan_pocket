+	cxt->mdev.minor = ID_STEP_COUNTER;
+	cxt->mdev.name = STEP_C_MISC_DEV_NAME;
+	cxt->mdev.fops = &step_fops;
+	err = sensor_attr_register(&cxt->mdev);
+	if (err)
+		pr_err("unable to register step_c misc device!!\n");
+	return err;
+}
