+	MAG_MDATA_DEBUG = 0X02,
+	MAG_ODATA_DEBUG = 0X04,
+	MAG_CTR_DEBUG = 0X08,
+	MAG_IPI_DEBUG = 0x10,
+};
+struct maghub_ipi_data {
+	int		direction;
+	int32_t dynamic_cali[MAGHUB_AXES_NUM];
+	int32_t parameter_cali[6];
+	atomic_t	trace;
+	atomic_t	suspend;
+	atomic_t	scp_init_done;
