+		if (cxt->step_c_ctl.step_d_flush != NULL)
+			err = cxt->step_c_ctl.step_d_flush();
+		else
+			pr_err("NOT SUPPORT STEP DETECTOR COM FLUSH\n");
+		if (err < 0)
+			pr_err("step detector enable flush err %d\n",
