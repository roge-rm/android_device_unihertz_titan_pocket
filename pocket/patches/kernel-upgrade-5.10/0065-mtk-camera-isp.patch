+			case ISP_CAM_B_IDX:
+				module = ISP_IRQ_TYPE_INT_CAM_B_ST;
+				break;
+			case ISP_CAM_C_IDX:
+				module = ISP_IRQ_TYPE_INT_CAM_C_ST;
+				break;
