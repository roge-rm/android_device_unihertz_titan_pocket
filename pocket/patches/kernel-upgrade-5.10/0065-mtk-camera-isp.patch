+			case ISP_CAMSV1_IDX:
+				module = ISP_IRQ_TYPE_INT_CAMSV_1_ST;
+				break;
+			case ISP_CAMSV2_IDX:
+				module = ISP_IRQ_TYPE_INT_CAMSV_2_ST;
+				break;
+			case ISP_CAMSV3_IDX:
+				module = ISP_IRQ_TYPE_INT_CAMSV_3_ST;
+				break;
+			case ISP_CAMSV4_IDX:
+				module = ISP_IRQ_TYPE_INT_CAMSV_4_ST;
