+	compat_uint_t count;
+	/*compat_uptr_t uptr; */
+	int err = 0;
+	/* Assume data pointer is unchanged. */
+	/* err = get_user(compat_ptr(uptr), &data->m_pDpeConfig); */
+	/* err |= put_user(uptr, &data32->m_pDpeConfig); */
+	err |= get_user(count, &data->m_ReqNum);
+	err |= put_user(count, &data32->m_ReqNum);
+	return err;
+}
