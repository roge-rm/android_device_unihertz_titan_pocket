+				if (vf & 0x1)
+					LOG_NOTICE(
+					    "CAMSV_%d: vf already enabled\n",
+					    DebugFlag[1]);
+				else
+					ISP_WR32(
+					    CAMSV_REG_TG_VF_CON(DebugFlag[1]),
