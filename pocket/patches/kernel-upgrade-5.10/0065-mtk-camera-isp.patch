+static int wpe_reg_read(struct seq_file *m, void *v)
+{
+	unsigned int i;
+
+	seq_puts(m, "======== read wpe register ========\n");
+
+	for (i = 0x400; i <= 0x4B4; i = i + 4) {
+		seq_printf(m, "[0x%08X 0x%08X]\n",
+			(unsigned int)(WPE_BASE_HW + i),
+			(unsigned int)WPE_RD32(ISP_WPE_BASE + i));
+	}
+
+	return 0;
+}
