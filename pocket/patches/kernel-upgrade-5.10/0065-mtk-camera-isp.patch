+ ******************************************************************************/
+
+static dev_t IspDevNo;
+static struct cdev *pIspCharDrv;
+static struct class *pIspClass;
+
+static const struct file_operations IspFileOper = {
+	.owner = THIS_MODULE,
+	.open = ISP_open,
+	.release = ISP_release,
+	/* .flush       = mt_isp_flush, */
+	.mmap = ISP_mmap,
+	.unlocked_ioctl = ISP_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl = ISP_ioctl_compat,
