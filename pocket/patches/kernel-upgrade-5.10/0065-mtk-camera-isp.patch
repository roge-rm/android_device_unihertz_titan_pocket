+static dev_t IspDevNo;
+static struct cdev *pIspCharDrv;
+static struct class *pIspClass;
+
+static const struct file_operations IspFileOper = {
+	.owner = THIS_MODULE,
+	.open = DIP_open,
+	.release = DIP_release,
+	/* .flush       = mt_dip_flush, */
+	/*  .mmap = DIP_mmap, */
