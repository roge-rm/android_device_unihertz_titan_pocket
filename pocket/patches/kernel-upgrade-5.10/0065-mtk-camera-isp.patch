+static inline void WPE_Unprepare_ccf_clock(void)
+{
+	/* must keep this clk close order:*/
+	/*WPE clk -> CG_SCP_SYS_ISP ->*/
+	/*CG_MM_SMI_COMMON -> CG_SCP_SYS_DIS */
+	clk_unprepare(wpe_clk.CG_IMGSYS_WPE_B);
