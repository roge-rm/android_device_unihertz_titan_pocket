+
+
+	return 0;
+}
+
+/***********************************************************************
+ *
+ ***********************************************************************/
+static signed int WPE_resume(struct platform_device *pDev)
+{
+	LOG_DBG("bPass1_On_In_Resume_TG1(%d).\n", bPass1_On_In_Resume_TG1);
+	if (g_u4WpeCnt > 0) {
+		WPE_EnableClock(MTRUE);
+		g_u4WpeCnt--;
+	}
+
+	return 0;
+}
