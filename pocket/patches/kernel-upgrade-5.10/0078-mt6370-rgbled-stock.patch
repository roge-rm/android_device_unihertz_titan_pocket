+/*
+ * delay_on_off: "on off" in ms, as the stock 4.14 LED core had it for the
+ * stock lights HAL. Sets the blink delays and calls led_blink_set(), which
+ * lands in mt6370_pmu_led_blink_set(): both non-zero blinks in PWM mode in
+ * the PMIC, "1 0" goes back to steady.
+ */
+static ssize_t delay_on_off_show(struct device *dev,
+	struct device_attribute *attr, char *buf)
+{
+	struct led_classdev *led_cdev = dev_get_drvdata(dev);
+
+	return sprintf(buf, "%lu %lu\n", led_cdev->blink_delay_on,
+		       led_cdev->blink_delay_off);
+}
+
+static ssize_t delay_on_off_store(struct device *dev,
+	struct device_attribute *attr, const char *buf, size_t size)
+{
+	struct led_classdev *led_cdev = dev_get_drvdata(dev);
+	unsigned long on = 0, off = 0;
+	ssize_t ret = size;
+
+	if (sscanf(buf, "%lu %lu", &on, &off) != 2)
+		return -EINVAL;
+	mutex_lock(&led_cdev->led_access);
+	if (led_sysfs_is_disabled(led_cdev)) {
+		ret = -EBUSY;
+		goto out;
+	}
+	led_cdev->blink_delay_on = on;
+	led_cdev->blink_delay_off = off;
+	led_blink_set(led_cdev, &led_cdev->blink_delay_on,
+		      &led_cdev->blink_delay_off);
+out:
+	mutex_unlock(&led_cdev->led_access);
+	return ret;
+}
+static DEVICE_ATTR_RW(delay_on_off);
+
+static struct attribute *mt6370_led_attrs[] = {
+	&dev_attr_delay_on_off.attr,
+	NULL,
+};
