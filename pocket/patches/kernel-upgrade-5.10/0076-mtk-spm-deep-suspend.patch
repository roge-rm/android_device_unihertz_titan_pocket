 #define MTK_UART_FRACDIV_L	0x15	/* Fractional divider LSB address */
 #define MTK_UART_FRACDIV_M	0x16	/* Fractional divider MSB address */
 #define MTK_UART_DEBUG0	0x18
+#define MTK_UART_SLEEP_REQ	0x2d	/* Sleep request register */
+#define MTK_UART_SLEEP_ACK	0x2e	/* Sleep ack register */
 #define MTK_UART_IER_XOFFI	0x20	/* Enable XOFF character interrupt */
 #define MTK_UART_IER_RTSI	0x40	/* Enable RTS Modem status interrupt */
 #define MTK_UART_IER_CTSI	0x80	/* Enable CTS Modem status interrupt */
@@ -48,6 +52,10 @@
 #define MTK_UART_EFR_HW_FC	(MTK_UART_EFR_RTS | MTK_UART_EFR_CTS)
 #define MTK_UART_DMA_EN_TX	0x2
 #define MTK_UART_DMA_EN_RX	0x5
+
+#define MTK_UART_SEND_SLEEP_REQ	0x1	/* Request uart to sleep */
+#define MTK_UART_SLEEP_ACK_IDLE	0x1	/* uart in idle state */
+#define MTK_UART_WAIT_ACK_TIMES	50	/* 10 us apart */
 
 #define MTK_UART_ESCAPE_CHAR	0x77	/* Escape char added under sw fc */
 #define MTK_UART_RX_SIZE	0x8000
@@ -654,6 +662,86 @@
 	return 0;
 }
 
+#if IS_BUILTIN(CONFIG_SERIAL_8250_MT6577)
+static struct platform_driver mtk8250_platform_driver;
+
+/* A port this driver owns with its bus clock on, as stock's clk_count check */
+static struct uart_8250_port *mtk8250_sleep_port(int line)
+{
+	struct uart_8250_port *up = serial8250_get_port(line);
+	struct mtk8250_data *data;
+
+	if (!up->port.dev || up->port.dev->driver != &mtk8250_platform_driver.driver)
+		return NULL;
+	data = dev_get_drvdata(up->port.dev);
+	return data && data->clk_count ? up : NULL;
+}
+
+/*
+ * Stock's mtk8250_request_to_sleep, for the SPM suspend path with IRQs off:
+ * set SLEEP_REQ on each port and wait up to 500 us for SLEEP_ACK idle; a
+ * port that doesn't ack refuses the sleep and every port's request is cleared.
+ */
+int mtk8250_request_to_sleep(void)
+{
+	struct uart_8250_port *up;
+	int line, i, req, n;
+
+	for (line = 0; line < CONFIG_SERIAL_8250_NR_UARTS; line++) {
+		up = mtk8250_sleep_port(line);
+		if (!up)
+			continue;
+		req = serial_in(up, MTK_UART_SLEEP_REQ);
+		serial_out(up, MTK_UART_SLEEP_REQ, req | MTK_UART_SEND_SLEEP_REQ);
+		for (i = 0; !(serial_in(up, MTK_UART_SLEEP_ACK) & MTK_UART_SLEEP_ACK_IDLE); i++) {
+			if (i >= MTK_UART_WAIT_ACK_TIMES) {
+				serial_out(up, MTK_UART_SLEEP_REQ, req);
+				pr_info_ratelimited("UART%d SLEEP ACK Fail\n", line);
+				/* The caller skips wakeup on failure, so clear the earlier ports here */
+				for (n = 0; n < line; n++) {
+					up = mtk8250_sleep_port(n);
+					if (up)
+						serial_out(up, MTK_UART_SLEEP_REQ,
+							   serial_in(up, MTK_UART_SLEEP_REQ) &
+							   ~MTK_UART_SEND_SLEEP_REQ);
+				}
+				return -EBUSY;
+			}
+			udelay(10);
+		}
+	}
+	return 0;
+}
+
+/*
+ * Stock's mtk8250_request_to_wakeup: clear SLEEP_REQ and wait for SLEEP_ACK to
+ * drop. A port that doesn't drop keeps its request cleared, the other ports
+ * are still woken and the error is returned at the end.
+ */
+int mtk8250_request_to_wakeup(void)
+{
+	struct uart_8250_port *up;
+	int line, i, req, ret = 0;
+
+	for (line = 0; line < CONFIG_SERIAL_8250_NR_UARTS; line++) {
+		up = mtk8250_sleep_port(line);
+		if (!up)
+			continue;
+		req = serial_in(up, MTK_UART_SLEEP_REQ);
+		serial_out(up, MTK_UART_SLEEP_REQ, req & ~MTK_UART_SEND_SLEEP_REQ);
+		for (i = 0; serial_in(up, MTK_UART_SLEEP_ACK) & MTK_UART_SLEEP_ACK_IDLE; i++) {
+			if (i >= MTK_UART_WAIT_ACK_TIMES) {
+				pr_debug("CANNOT GET UART%d WAKE ACK\n", line);
+				ret = -EBUSY;
+				break;
+			}
+			udelay(10);
+		}
+	}
+	return ret;
+}
+#endif
