+/* A root-level diagnostic consumer leaves LK's generated nodes untouched.
+ * Validate the fresh reservation before any persistent RAM mapping/write.
+ */
+static int ramoops_pocket_guard(struct device *dev,
+			      const struct ramoops_platform_data *pdata)
+{
+	struct device_node *parent, *child;
+	struct resource res;
+	u32 address_cells, size_cells;
+	int length, matches = 0;
+	bool valid = false;
+
+	if (!of_device_is_compatible(dev_of_node(dev),
+			"unihertz,titan-pocket-ramoops-diagnostic"))
+		return 0;
+	if (!ramoops_pocket_layout_ok(pdata))
+		return -EINVAL;
+
+	parent = of_find_node_by_path("/reserved-memory");
+	if (!parent)
+		return -ENODEV;
+	if (!of_device_is_available(parent) ||
+	    of_property_read_u32(parent, "#address-cells", &address_cells) ||
+	    of_property_read_u32(parent, "#size-cells", &size_cells) ||
+	    address_cells != 2 || size_cells != 2 ||
+	    !of_find_property(parent, "ranges", &length) || length) {
+		of_node_put(parent);
+		return -EINVAL;
+	}
+	for_each_available_child_of_node(parent, child) {
+		if (!of_device_is_compatible(child, "mediatek,pstore"))
+			continue;
+		matches++;
+		if (!of_address_to_resource(child, 0, &res) &&
+		    ramoops_pocket_reservation_ok(res.start, resource_size(&res),
+			    of_property_read_bool(child, "no-map"),
+			    of_property_read_bool(child, "reusable")))
+			valid = true;
+	}
+	of_node_put(parent);
+	if (matches != 1 || !valid) {
+		dev_err(dev, "diagnostic pstore reservation missing or inconsistent\n");
+		return -EINVAL;
+	}
+	return 0;
+}
+
