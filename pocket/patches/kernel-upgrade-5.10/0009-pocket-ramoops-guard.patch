+/* Firmware module parameters must not bypass the guarded diagnostic node. */
+static bool ramoops_pocket_skip_dummy(void)
+{
+	struct device_node *node;
+
+	node = of_find_compatible_node(NULL, NULL,
+			"unihertz,titan-pocket-ramoops-diagnostic");
+	if (!node)
+		return false;
+	of_node_put(node);
+	return true;
+}
