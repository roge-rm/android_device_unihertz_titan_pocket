+
+extern void agold_gpio_set(unsigned int gpio, int value);
+/* Matches stock: GPIO165 goes high when going off from a dim level; what it is wired to is unknown. */
+static bool g_pwm_gpio165_high;
 
 static int pwm_dbg_en;
