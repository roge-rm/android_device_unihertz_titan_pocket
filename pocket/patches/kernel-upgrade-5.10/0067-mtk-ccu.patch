+int ccu_i2c_controller_uninit_all(void)
+{
+	int i;
+
+	mutex_lock(&ccu_i2c_mutex);
+	for (i = 0 ; i < I2C_MAX_CHANNEL ; i++) {
+		if (ccu_i2c_initialized[i])
+			ccu_i2c_controller_uninit(i);
+	}
+
+	LOG_INF_MUST("%s done.\n", __func__);
+
+	mutex_unlock(&ccu_i2c_mutex);
+	return 0;
+}
