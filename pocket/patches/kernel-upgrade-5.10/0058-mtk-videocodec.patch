+#define MAX_HISTORY 10
+#define MIN_SUBMIT_GAP 2000		/* 2ms */
+#define MAX_SUBMIT_GAP (1000*1000)	/* 1 second */
+#define FREE_HIST_DELAY (5000*1000)	/* Free history delay */
