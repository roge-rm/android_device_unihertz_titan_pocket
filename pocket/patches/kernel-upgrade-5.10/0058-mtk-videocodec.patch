+struct codec_history {
+	void *handle;
+	int kcy[MAX_HISTORY];
+	long long submit[MAX_HISTORY];
+	long long start[MAX_HISTORY];
+	long long end[MAX_HISTORY];
+	int cur_idx;
+	int cur_cnt;
+	int tot_kcy;
+	long long tot_time;
+	struct codec_history *next;
+};
+
+struct codec_job {
