+#define MTK_USB_PHY_MISC_BASE   (instance->sif_misc)
+#define MTK_USB_PHY_FMREG_BASE	(instance->sif_fmreg)
+#define MTK_USB_PHY_SPLLC_BASE	(instance->sif_spllc)
+#define MTK_USB_PHY_U2_BASE		(instance->sif_u2phy_com)
