+			    bMono << mMemIfChannels[Memory_Interface][1],
+			    mMemIfChannels[Memory_Interface][2] <<
+			    mMemIfChannels[Memory_Interface][1]);
+		break;
+	case Soc_Aud_Digital_Block_MEM_DAI:
