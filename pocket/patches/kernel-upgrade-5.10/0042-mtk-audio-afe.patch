+					__func__, aud_clks[CLOCK_ADC].name);
+				goto EXIT;
+			}
+		} else {
+			pr_err("%s [CCF]clk_prepare error %s fail",
+				__func__, aud_clks[CLOCK_ADC].name);
+			goto EXIT;
+		}
+	}
+	Aud_ADC_Clk_cntr++;
+EXIT:
+	spin_unlock_irqrestore(&auddrv_Clk_lock, flags);
