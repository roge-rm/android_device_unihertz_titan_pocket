+/*
+ * AFE SRAM (0x11221000) sits inside audsys, so like the registers it hangs the bus with
+ * SYS_AUDIO off. True if p points into it while the power is off; the caller skips the
+ * access. SRAM goes only to streams that hold AudDrv_Clk_On, which keeps the power on.
+ */
+static bool afe_sram_unpowered(const void *p)
+{
+	const char *base = Get_Afe_SramBase_Pointer();
+	const char *c = p;
+
+	if (!base || c < base || c >= base + Get_Afe_Sram_Length())
+		return false;
+	if (AudDrv_Clk_Power_On())
+		return false;
+	pr_err_ratelimited("AFE SRAM %p with SYS_AUDIO off, skipped\n", p);
+	return true;
+}
