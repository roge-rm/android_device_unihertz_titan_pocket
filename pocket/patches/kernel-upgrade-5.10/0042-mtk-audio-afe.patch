+			&afe_mem_blk_dl1_2_lock,
+			spinlock_flags[Soc_Aud_Digital_Block_MEM_DL1_DATA2]);
+		break;
+	case Soc_Aud_Digital_Block_MEM_VUL:
+		spin_lock_irqsave(
+			&afe_mem_blk_ul1_lock,
+			spinlock_flags[Soc_Aud_Digital_Block_MEM_VUL]);
