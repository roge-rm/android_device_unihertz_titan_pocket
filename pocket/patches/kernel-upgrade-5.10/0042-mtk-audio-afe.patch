+/*
+ * LK's atag,extbuck_fan53526 in /chosen is { size, tag, exist }, read from the live tree
+ * in place of stock's flat DT scan. The stock live tree has no such tag, so it stays 0.
+ */
+static int __init audio_drv_gpio_init(void)
+{
+	struct device_node *chosen = of_find_node_by_path("/chosen");
+	u32 exist;
+
+	if (!chosen)
+		return 0;
+	if (!of_property_read_u32_index(chosen, "atag,extbuck_fan53526", 2,
+					&exist)) {
+		extbuck_fan53526_exist = exist;
+		pr_info("[%s] fan53526_exist = %d\n", __func__,
+			extbuck_fan53526_exist);
+	}
+	of_node_put(chosen);
+	return 0;
+}
