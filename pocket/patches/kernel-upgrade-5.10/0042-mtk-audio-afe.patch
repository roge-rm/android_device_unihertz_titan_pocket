+	[CLOCK_TOP_MUX_AUD_ENG1] = {"top_mux_aud_eng1", false, false, NULL},
+	[CLOCK_TOP_APLL1_D8] = {"top_apll1_d8", false, false, NULL},
+	[CLOCK_TOP_MUX_AUD_ENG2] = {"top_mux_aud_eng2", false, false, NULL},
