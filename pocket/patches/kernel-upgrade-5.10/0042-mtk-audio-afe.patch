+/*****************************************************************************
+ * FUNCTION
+ *  Register_aud_irq
+ *
+ * DESCRIPTION
+ *  IRQ handler
+ *
+ *****************************************************************************
+ */
+bool Register_Aud_Irq(void *dev, unsigned int afe_irq_number)
+{
+	int ret;
+
+#ifndef CONFIG_OF
+	afe_irq_number = MT6735_AFE_MCU_IRQ_LINE;
+#endif
+	/*
+	 * The line is level low and not shared; asserted with SYS_AUDIO off the handler can't
+	 * clear it, so it starts masked and the clock code enables it only while powered.
+	 */
+	irq_set_status_flags(afe_irq_number, IRQ_NOAUTOEN);
+	ret = devm_request_irq(dev, afe_irq_number, AudDrv_IRQ_handler, IRQF_TRIGGER_LOW,
+			       "Afe_ISR_Handle", dev);
+	if (ret) {
+		irq_clear_status_flags(afe_irq_number, IRQ_NOAUTOEN);
+		return ret;
+	}
+	AudDrv_Clk_Set_Irq(afe_irq_number);
+	return ret;
+}
+
+static unsigned int get_mcu_irq_mask(void)
+{
+	int index = 0;
+	const struct Aud_RegBitsInfo *irq_status;
+	enum Soc_Aud_IRQ_PURPOSE purpose;
+
+	if (irq_mcu_mask == 0) {
+		for (index = 0; index < Soc_Aud_IRQ_MCU_MODE_NUM; index++) {
+			irq_status = &GetIRQCtrlReg(index)->status;
+			purpose = GetIRQCtrlReg(index)->irqPurpose;
+			if (irq_status->reg == AFE_REG_UNDEFINED)
+				continue;
+
+			irq_mcu_mask |= (purpose == Soc_Aud_IRQ_MCU)
+					<< irq_status->sbit;
+		}
+	}
+	return irq_mcu_mask;
+}
