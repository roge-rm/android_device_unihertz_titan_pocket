+void AudDrv_ADC_Clk_On(void)
+{
+	int ret = 0;
+	unsigned long flags = 0;
+
+	spin_lock_irqsave(&auddrv_Clk_lock, flags);
+	if (!aud_mtcmos_check(__func__))
+		goto EXIT;
+
