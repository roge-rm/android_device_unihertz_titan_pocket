+	int power_vol;	/*!< the VDD power voltage of the als chip */
+	int polling_mode;     /*!< 1: polling mode ; 0:interrupt mode*/
+	int polling_mode_ps;  /*!< 1: polling mode ; 0:interrupt mode*/
