+static bool nanohub_os_log(char *buffer, int len)
+{
+	if (le32_to_cpu((((u32 *)buffer)[0]) & 0x7FFFFFFF) ==
+	    OS_LOG_EVENTID) {
+		char *mtype, *mdata = &buffer[5];
+
+		buffer[len - 1] = '\0';
+
+		switch (buffer[4]) {
+		case 'E':
+			mtype = KERN_ERR;
+			break;
+		case 'W':
+			mtype = KERN_WARNING;
+			break;
+		case 'I':
+			mtype = KERN_INFO;
+			break;
+		case 'D':
+			mtype = KERN_DEBUG;
+			break;
+		default:
+			mtype = KERN_DEFAULT;
+			mdata--;
+			break;
+		}
+		pr_debug("%snanohub: %s", mtype, mdata);
+		return true;
+	} else {
+		return false;
+	}
+}
