+struct hwmsen_convert map[] = {
+	{ { 1, 1, 1}, {0, 1, 2} },
+	{ {-1, 1, 1}, {1, 0, 2} },
+	{ {-1, -1, 1}, {0, 1, 2} },
+	{ { 1, -1, 1}, {1, 0, 2} },
+
+	{ {-1, 1, -1}, {0, 1, 2} },
+	{ { 1, 1, -1}, {1, 0, 2} },
+	{ { 1, -1, -1}, {0, 1, 2} },
+	{ {-1, -1, -1}, {1, 0, 2} },
+
+};
+/*----------------------------------------------------------------------------*/
+int hwmsen_get_convert(int direction, struct hwmsen_convert *cvt)
+{
+	unsigned int dir;
+
+	if (!cvt)
+		return -EINVAL;
+	else if (direction < 0 || direction >= ARRAY_SIZE(map))
+		return -EINVAL;
+	else
+		dir = direction;
+
+	*cvt = map[dir];
+	return 0;
+}
+/*----------------------------------------------------------------------------*/
+EXPORT_SYMBOL_GPL(hwmsen_get_convert);
