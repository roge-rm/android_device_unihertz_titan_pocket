+const struct SCP_sensorHub_Cmd *
+	SCP_sensorHub_find_cmd(uint32_t packetReason)
+{
+	int i;
+	const struct SCP_sensorHub_Cmd *cmd;
+
+	for (i = 0; i < ARRAY_SIZE(SCP_sensorHub_Cmds); i++) {
+		cmd = &SCP_sensorHub_Cmds[i];
+		if (cmd->reason == packetReason)
+			return cmd;
+	}
+	return NULL;
