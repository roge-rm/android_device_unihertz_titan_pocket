+static int alspshub_delete_attr(struct device_driver *driver)
+{
+	int idx = 0, err = 0;
+	int num = (int)(ARRAY_SIZE(alspshub_attr_list));
+
+	if (!driver)
+		return -EINVAL;
+
+	for (idx = 0; idx < num; idx++)
+		driver_remove_file(driver, alspshub_attr_list[idx]);
+
+	return err;
+}
