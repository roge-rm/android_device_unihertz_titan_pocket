+	for (n = rb_first(&client->handles); n; n = rb_next(n)) {
+		struct ion_handle *handle =
+			rb_entry(n, struct ion_handle, node);
+		heapid = handle->buffer->heap->id;
+		type = handle->buffer->heap->type;
