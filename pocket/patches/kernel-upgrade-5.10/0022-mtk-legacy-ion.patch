+int ion_mm_cp_sf_buf_info(struct ion_mm_sf_buf_info *src,
+			  struct ion_mm_sf_buf_info *dst)
+{
+	int i;
+
+	dst->handle = src->handle;
+	for (i = 0; i < ION_MM_SF_BUF_INFO_LEN; i++)
+		dst->info[i] = src->info[i];
+
+	return 0;
+}
