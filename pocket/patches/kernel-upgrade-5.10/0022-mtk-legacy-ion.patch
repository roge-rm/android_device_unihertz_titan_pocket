+		    (id == ION_HEAP_TYPE_MULTIMEDIA &&
+		     (type == ION_HEAP_TYPE_SYSTEM ||
+		      type == ION_HEAP_TYPE_MULTIMEDIA ||
+		      type == ION_HEAP_TYPE_MULTIMEDIA_SEC))) {
+			client->dbg_hnd_cnt++;
+			size += handle->buffer->size;
+		}
+	}
+	mutex_unlock(&client->lock);
+	return size;
