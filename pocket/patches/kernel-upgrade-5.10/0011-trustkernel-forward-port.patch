+	int max;
+};
+
+#define TEE_STATS_CONTEXT_IDX	0
+#define TEE_STATS_SESSION_IDX	1
+#define TEE_STATS_SHM_IDX		2
+
+#define TEE_MAX_TEE_DEV_NAME (64)
+struct tee {
+	struct klist_node node;
