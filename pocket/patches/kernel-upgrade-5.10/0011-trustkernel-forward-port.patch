+#ifdef CONFIG_TRUSTKERNEL_TEE_RAM_DIAGNOSTIC
+/* Original diagnostic guard, not a stock-driver behaviour claim.
+ * Stock tz_start just ioremaps the range. Here the negotiated pool must lie
+ * inside the one LK-inserted TEE reservation, which must carry no-map, match
+ * its early reserved-memory record, and be absent from mapped and reserved
+ * memblock memory (5.10 marks no-map ranges NOMAP or removes them, it never
+ * reserves them). The stock tee1 image and the preloader log give the relative layout: pool at
+ * +0x2028000, 0x3d8000 bytes, ending at the end of a 36 MiB reservation.
+ * No physical base is assumed. Reject before ioremap/pool creation/RoT.
+ */
+/* Overflow-safe overlap of a memblock region with [start, end). */
+static bool diagnostic_overlaps(const struct memblock_region *region,
+				phys_addr_t start, phys_addr_t end)
+{
+	return region->size && region->base < end &&
+	       (region->base >= start || start - region->base < region->size);
+}
+
+/* Find the one available no-map mediatek,tee-reserved node whose reg matches
+ * its early reserved-memory record, and check that none of it is in mapped or
+ * reserved memblock memory. Returns NULL when owned, else the failed check.
+ */
+static const char *diagnostic_tee_reservation(phys_addr_t *start_out,
+					      phys_addr_t *length_out)
+{
+	struct device_node *node, *owner = NULL;
+	struct memblock_region *region;
+	struct reserved_mem *record;
+	struct resource resource;
+	phys_addr_t start, length, end;
+	unsigned int matches = 0;
+	const char *failed = NULL;
+
+	for_each_compatible_node(node, NULL, "mediatek,tee-reserved") {
+		matches++;
+		if (!owner)
+			owner = of_node_get(node);
+	}
+	if (matches != 1 || !owner) {
+		failed = "exactly one mediatek,tee-reserved node";
+		goto out;
+	}
+	if (!of_device_is_available(owner)) {
+		failed = "TEE reservation node available";
+		goto out;
+	}
+	if (!of_property_read_bool(owner, "no-map")) {
+		failed = "TEE reservation has no-map";
+		goto out;
+	}
+	if (of_address_to_resource(owner, 0, &resource)) {
+		failed = "TEE reservation reg readable";
+		goto out;
+	}
+	start = resource.start;
+	length = resource_size(&resource);
+	*start_out = start;
+	*length_out = length;
+	if (!length || start > (phys_addr_t)-1 - length) {
+		failed = "TEE reservation range valid";
+		goto out;
+	}
+	end = start + length;
+	record = of_reserved_mem_lookup(owner);
+	if (!record || record->base != start || record->size != length) {
+		failed = "early reserved-memory record matches reg";
+		goto out;
+	}
+	/* Check the whole reservation, not just the pool. */
+	for_each_mem_region(region) {
+		if (diagnostic_overlaps(region, start, end) &&
+		    !memblock_is_nomap(region)) {
+			failed = "TEE reservation absent from mapped memory";
+			goto out;
+		}
+	}
+	for_each_reserved_mem_region(region) {
+		if (diagnostic_overlaps(region, start, end)) {
+			failed = "TEE reservation absent from memblock.reserved";
+			goto out;
+		}
+	}
+out:
+	of_node_put(owner);
+	return failed;
+}
+
+static bool diagnostic_shm_owned(phys_addr_t base, size_t size)
+{
+	phys_addr_t start = 0, length = 0, end, shm_end;
+	const char *failed;
+
+	failed = diagnostic_tee_reservation(&start, &length);
+	if (failed)
+		goto out;
+	end = start + length;
+	if (!size || base > (phys_addr_t)-1 - size) {
+		failed = "SHM range valid";
+		goto out;
+	}
+	shm_end = base + size;
+	if (base < start || shm_end > end) {
+		failed = "SHM inside TEE reservation";
+		goto out;
+	}
+	if (length != 0x2400000ULL || base - start != 0x2028000ULL ||
+	    size != 0x3d8000ULL || shm_end != end) {
+		failed = "SHM matches evidenced TEE layout";
+		goto out;
+	}
+out:
+	if (failed) {
+		pr_err("TK RAM diagnostic: SHM ownership rejected, failed: %s; no SHM mapping\n",
+		       failed);
+		pr_err("TK RAM diagnostic: SHM %pa+%zx, TEE reservation %pa+%pa\n",
+		       &base, size, &start, &length);
+		return false;
+	}
+	pr_info("TK RAM diagnostic: SHM %pa+%zx owned by no-map TEE reservation %pa+%pa\n",
+		&base, size, &start, &length);
+	return true;
+}
+
+/* Log SHM from GET_LOGM_CONFIG, checked before the logger maps it
+ * (CONFIG_TRUSTKERNEL_TEE_DIAGNOSTIC_LOGGER). It must be inside the same
+ * owned TEE reservation and clear of the evidenced pool
+ * [+0x2028000, end). the stock tee1 image has a 0x20000 log area between the 0x8000
+ * header and the pool, but that order is inferred, so only containment and
+ * no overlap with the pool are required.
+ */
+bool tkcore_diag_log_owned(phys_addr_t base, size_t size)
+{
+	phys_addr_t start = 0, length = 0, end, log_end;
+	const char *failed;
+
+	failed = diagnostic_tee_reservation(&start, &length);
+	if (failed)
+		goto out;
+	end = start + length;
+	if (!size || base > (phys_addr_t)-1 - size) {
+		failed = "log range valid";
+		goto out;
+	}
+	log_end = base + size;
+	if (base < start || log_end > end) {
+		failed = "log inside TEE reservation";
+		goto out;
+	}
+	if (length != 0x2400000ULL || log_end > start + 0x2028000ULL) {
+		failed = "log clear of evidenced SHM pool";
+		goto out;
+	}
+out:
+	if (failed) {
+		pr_err("TK RAM diagnostic: log ownership rejected, failed: %s; logger off\n",
+		       failed);
+		pr_err("TK RAM diagnostic: log %pa+%zx, TEE reservation %pa+%pa\n",
+		       &base, size, &start, &length);
+		return false;
+	}
+	pr_info("TK RAM diagnostic: log %pa+%zx owned by no-map TEE reservation %pa+%pa\n",
+		&base, size, &start, &length);
+	return true;
+}
+#endif
+
+/* configure_shm - Negotiate Shared Memory configuration with teetz. */
+static int configure_shm(struct tee_tz *ptee)
+{
+	struct smc_param param = { 0 };
+	size_t shm_size = -1;
+	int ret = 0;
+
+	WARN_ON(!CAPABLE(ptee->tee));
+
+	param.a0 = TEESMC32_ST_FASTCALL_GET_SHM_CONFIG;
+	smc_xfer(&param);
+
+	if (param.a0 != TEESMC_RETURN_OK) {
+		pr_err("shm service not available: 0x%x",
+			(uint) param.a0);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ptee->shm_paddr = param.a1;
+	shm_size = param.a2;
+	ptee->shm_cached = (bool)param.a3;
+#ifdef CONFIG_TRUSTKERNEL_TEE_RAM_DIAGNOSTIC
+	if (!diagnostic_shm_owned(ptee->shm_paddr, shm_size)) {
+		ret = -EPERM;
+		goto out;
+	}
+#endif
+
+	if (ptee->shm_cached)
+		ptee->shm_vaddr = tee_map_cached_shm(ptee->shm_paddr, shm_size);
+	else
+		ptee->shm_vaddr = ioremap(ptee->shm_paddr, shm_size);
+
+	if (ptee->shm_vaddr == NULL) {
+		pr_err("shm ioremap failed\n");
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	ptee->shm_pool = tee_shm_pool_create(DEV, shm_size,
+		ptee->shm_vaddr, ptee->shm_paddr);
+
+	if (!ptee->shm_pool) {
+		pr_err("shm pool creation failed (%zu)", shm_size);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (ptee->shm_cached)
+		tee_shm_pool_set_cached(ptee->shm_pool);
+out:
+	return ret;
+}
+
+static int tz_start(struct tee *tee)
+{
+	struct tee_tz *ptee;
+	int ret;
+
+	WARN_ON(!tee || !tee->priv);
+
+	if (!CAPABLE(tee)) {
+		pr_err("not capable\n");
+		return -EBUSY;
+	}
+
+	ptee = tee->priv;
+	WARN_ON(ptee->started);
+	ptee->started = true;
+
+	ret = configure_shm(ptee);
+	if (ret)
+		goto exit;
+
+	{
+#define TKCORE_GET_ROOT_OF_TRUST_INFO 0xBF000202
+		struct smc_param param = { 0 };
+
+		/* tell tos to get root of trust
+		 *
+		 * we are not insterested in the
+		 * return value. the availability
+		 * of RoT will affect the behavior of
+		 * other trust apps anyhow
+		 */
+
+		param.a0 = TKCORE_GET_ROOT_OF_TRUST_INFO;
+		smc_xfer(&param);
+	}
+
+#ifdef CONFIG_OUTER_CACHE
+	ret = register_outercache_mutex(ptee, true);
+	if (ret)
+		goto exit;
+#endif
+
+exit:
+	if (ret)
+		ptee->started = false;
+
+	return ret;
+}
+
+static int tz_stop(struct tee *tee)
+{
+	struct tee_tz *ptee;
+
+	WARN_ON(!tee || !tee->priv);
+
+	ptee = tee->priv;
+
+	if (!CAPABLE(tee)) {
+		pr_err("tee: bad state\n");
+		return -EBUSY;
+	}
+
+#ifdef CONFIG_OUTER_CACHE
+	register_outercache_mutex(ptee, false);
+#endif
+	tee_shm_pool_destroy(tee->dev, ptee->shm_pool);
+	iounmap(ptee->shm_vaddr);
+	ptee->started = false;
+
+	return 0;
+}
+
+static void __tee_smc_call(struct smc_param *p)
+{
+	tee_smc_call(p);
+}
+
+/******************************************************************************/
