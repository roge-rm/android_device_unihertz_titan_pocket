+ * cooling device callback functions (mtk_cl_adp_mutt_ops)
+ * 1 : True and 0 : False
+ */
+static int mtk_cl_adp_mutt_get_max_state(struct thermal_cooling_device *cdev,
+				unsigned long *state)
+{
+	*state = 1;
+	mtk_cooler_mutt_dprintk("[%s] %s %lu\n", __func__, cdev->type, *state);
+	return 0;
+}
