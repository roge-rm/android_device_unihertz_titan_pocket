+	int ret = 0;
+	char tmp[MAX_LEN] = {0};
+	int len = 0;
+
+	len = (count < (MAX_LEN - 1)) ? count : (MAX_LEN - 1);
+	/* write data to the buffer */
+	if (copy_from_user(tmp, buf, len))
+		return -EFAULT;
+
+	ret = kstrtouint(tmp, 10, &tm_input_pid);
+	if (ret)
+		WARN_ON_ONCE(1);
+
+	mtk_cooler_mutt_dprintk("[%s] %s = %d\n", __func__, tmp, tm_input_pid);
+
+	return len;
+}
