+/*
+ * mtk_thermal_cooling_device_register on 5.10: on its node under
+ * /modem-coolers when the board DT has one, so the zone's cooling maps bind
+ * it, otherwise with no node (not bound, as stock leaves it).
+ */
+static struct thermal_cooling_device *mutt_cdev_register(const char *name,
+	void *devdata, const struct thermal_cooling_device_ops *ops)
+{
+	char path[48];
+	struct device_node *np;
+	struct thermal_cooling_device *cdev;
+
+	snprintf(path, sizeof(path), "/modem-coolers/%s", name);
+	np = of_find_node_by_path(path);
+	/* the cooling device keeps np, so the reference is kept too */
+	cdev = thermal_of_cooling_device_register(np, (char *)name, devdata,
+						  ops);
+	if (IS_ERR(cdev)) {
+		pr_err("[Thermal/TC/mutt] %s register failed: %ld\n", name,
+		       PTR_ERR(cdev));
+		of_node_put(np);
+		return NULL;
+	}
+	pr_info("[Thermal/TC/mutt] %s registered%s\n", name,
+		np ? " on its DT node" : "");
+	return cdev;
+}
