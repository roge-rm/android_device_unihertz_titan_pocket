+/* the zone stock binds mtk-cl-adp-mutt to; its temperature drives the loop */
+#define ADP_MUTT_ZONE		"mtktsbtsmdpa"
+/* stock's tzbtspa polling interval from thermal.conf */
+#define ADP_MUTT_PERIOD_MS	1000
+
+
+/*
+ * One step of stock's per-poll adp-mutt call: adaptive_tput_limit on the
+ * zone temperature, then the combined limit to the modem. Repeats every
+ * ADP_MUTT_PERIOD_MS while the cooler is on or still has a limit set.
+ */
+static void mtk_cl_adp_mutt_work_fn(struct work_struct *work)
+{
+	struct thermal_zone_device *tz;
+	int temp = 0, ret;
+	bool again;
+
+	/* Not under cl_mutt_lock: the zone lock is taken before it elsewhere. */
+	tz = thermal_zone_get_zone_by_name(ADP_MUTT_ZONE);
+	ret = IS_ERR(tz) ? PTR_ERR(tz) : thermal_zone_get_temp(tz, &temp);
+
+	mutex_lock(&cl_mutt_lock);
+	if (ret) {
+		pr_warn_ratelimited("[Thermal/TC/mutt] %s temperature: %d\n",
+				    ADP_MUTT_ZONE, ret);
+	} else if (cl_dev_mdoff_state != 1 && cl_dev_noIMS_state != 1) {
+		cl_dev_adp_mutt_state = cl_dev_adp_mutt_req;
+		adaptive_tput_limit(temp);
+		mtk_cl_mutt_set_mutt_limit();
+	}
+	again = cl_dev_adp_mutt_state == 1 || triggered;
+	mutex_unlock(&cl_mutt_lock);
+
+	if (again)
+		schedule_delayed_work(&adp_mutt_work,
+				      msecs_to_jiffies(ADP_MUTT_PERIOD_MS));
+}
+
+/* the thermal core calls this with the zone lock held */
+static int mtk_cl_adp_mutt_set_cur_state(struct thermal_cooling_device *cdev,
+				unsigned long state)
+{
+	int ret;
+
+	mutex_lock(&cl_mutt_lock);
+	ret = mtk_cl_adp_mutt_set_cur_state_locked(cdev, state);
+	mutex_unlock(&cl_mutt_lock);
+	/* adaptive_tput_limit runs in the work, which reads the zone */
+	mod_delayed_work(system_wq, &adp_mutt_work, 0);
+	return ret;
+}
