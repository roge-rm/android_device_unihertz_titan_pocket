+static int clmutt_tmd_pid_read(struct seq_file *m, void *v)
+{
+	seq_printf(m, "%d\n", tmd_input_pid);
+	mtk_cooler_mutt_dprintk("%s %d\n", __func__, tmd_input_pid);
+
+	return 0;
+}
