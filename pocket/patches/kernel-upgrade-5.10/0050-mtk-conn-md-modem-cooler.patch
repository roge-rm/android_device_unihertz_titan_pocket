+}
+
+static int mtk_cl_mdoff_get_cur_state(struct thermal_cooling_device *cdev,
+				unsigned long *state)
+{
+	*state = cl_dev_mdoff_state;
+	mtk_cooler_mutt_dprintk(
+			"[%s] %s %lu (0: md on;  1: md off)\n", __func__,
+			cdev->type, *state);
+	return 0;
+}
+
+static int mtk_cl_mdoff_set_cur_state_locked(struct thermal_cooling_device *cdev,
+				unsigned long state)
+{
+	if ((state >= 0) && (state <= 1))
+		mtk_cooler_mutt_dprintk(
+			"[%s] %s %lu (0: md on;  1: md off)\n", __func__,
+			cdev->type, state);
+	else {
+		mtk_cooler_mutt_dprintk(
+		"[%s]: Invalid input (0:md on;	 1: md off)\n", __func__);
+
+		return 0;
+	}
+
+	clmutt_send_tm_signal(state);
+
+	return 0;
+}
+
+/* the thermal core calls this with the zone lock held */
+static int mtk_cl_mdoff_set_cur_state(struct thermal_cooling_device *cdev,
+				unsigned long state)
+{
+	int ret;
+
+	mutex_lock(&cl_mutt_lock);
+	ret = mtk_cl_mdoff_set_cur_state_locked(cdev, state);
+	mutex_unlock(&cl_mutt_lock);
+	/* a state kept while blocked is applied in the work */
+	mod_delayed_work(system_wq, &adp_mutt_work, 0);
+	return ret;
+}
