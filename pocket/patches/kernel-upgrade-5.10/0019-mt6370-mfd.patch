+		reg_addr = MT6370_PMU_REG_RGBCHRINDDIM;
+		break;
+	default:
+		return -EINVAL;
+	}
+	reg_data = store << MT6370_LED_PWMDUTYSHFT;
+	ret = mt6370_pmu_led_update_bits(led_cdev, reg_addr,
+					 MT6370_LED_PWMDUTYMASK, reg_data);
