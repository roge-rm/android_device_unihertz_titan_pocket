+		.name = "mt6370_pmu_ldo",
+		.owner = THIS_MODULE,
+		.of_match_table = of_match_ptr(mt_ofid_table),
+	},
+	.probe = mt6370_pmu_ldo_probe,
+	.remove = mt6370_pmu_ldo_remove,
+	.id_table = mt_id_table,
+};
