+static inline void rt_config_of_node(struct device *dev)
+{
+	struct device_node *np = NULL;
+
+	np = of_find_node_by_name(NULL, "mt6370_pmu_dts");
+	if (np) {
+		dev_notice(dev, "find mt6370_pmu_dts node\n");
+		dev->of_node = np;
+	}
+}
