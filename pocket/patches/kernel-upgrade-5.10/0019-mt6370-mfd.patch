+/*
+ * agold additions, rebuilt from the stock Image (not in T): the IR transmitter
+ * driver switches the LDO through these. Stock's mt6370_ldo_enable() and
+ * agold_mt6370_ldo_enable() also skip one enable when a flag the IR driver
+ * sets is 1; that flag comes with the IR driver.
+ */
+static struct regulator_dev *agold_ldo_rdev;
+
+int agold_mt6370_ldo_enable(void)
+{
+	struct mt6370_pmu_ldo_data *info;
+
+	if (!agold_ldo_rdev) {
+		pr_info("%s: err\n", __func__);
+		return 0;
+	}
+	info = rdev_get_drvdata(agold_ldo_rdev);
+	mt6370_pmu_reg_set_bit(info->chip,
+		mt6370_ldo_regulators.enable_reg,
+		mt6370_ldo_regulators.enable_bit);
+	pr_info("%s: ok\n", __func__);
+	return 0;
+}
+EXPORT_SYMBOL(agold_mt6370_ldo_enable);
+
+int agold_mt6370_ldo_disable(void)
+{
+	struct mt6370_pmu_ldo_data *info;
+
+	if (!agold_ldo_rdev) {
+		pr_info("%s: err\n", __func__);
+		return 0;
+	}
+	info = rdev_get_drvdata(agold_ldo_rdev);
+	mt6370_pmu_reg_clr_bit(info->chip,
+		mt6370_ldo_regulators.enable_reg,
+		mt6370_ldo_regulators.enable_bit);
+	pr_info("%s: ok\n", __func__);
+	return 0;
+}
+EXPORT_SYMBOL(agold_mt6370_ldo_disable);
