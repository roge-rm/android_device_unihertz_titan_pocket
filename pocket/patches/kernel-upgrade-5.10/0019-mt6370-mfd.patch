+
+	ret = kstrtoul(buf, 10, &store);
+	if (ret < 0)
+		return ret;
+	if (store > MT6370_LED_PWMDUTYMAX)
+		return -EINVAL;
+	switch (led_index) {
+	case MT6370_PMU_LED1:
