+	return IRQ_HANDLED;
+}
+
+static irqreturn_t mt6370_pmu_isink2_open_irq_handler(int irq, void *data)
+{
+	struct mt6370_pmu_rgbled_data *rgbled_data = data;
+
+	dev_notice(rgbled_data->dev, "%s\n", __func__);
+	return IRQ_HANDLED;
+}
