+int charger_manager_enable_power_path(struct charger_consumer *consumer,
+	int idx, bool en)
+{
+	int ret = 0;
+	bool is_en = true;
+	struct charger_manager *info = consumer->cm;
+	struct charger_device *chg_dev = NULL;
+
+
+	if (!info)
+		return -EINVAL;
+
+	switch (idx) {
+	case MAIN_CHARGER:
+		chg_dev = info->chg1_dev;
+		break;
+	case SLAVE_CHARGER:
+		chg_dev = info->chg2_dev;
+		break;
