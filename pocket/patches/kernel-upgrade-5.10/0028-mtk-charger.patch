+/* return false if vbus is over max_charger_voltage */
+static bool mtk_chg_check_vbus(struct charger_manager *info)
+{
+	int vchr = 0;
+
+	/*
+	 * Change from stock: a failed VBUS read (-1) means VBUS is unknown, so
+	 * charging stays off until a good read, rather than passing the check.
+	 */
+	vchr = battery_get_vbus();
+	if (vchr < 0) {
+		chr_err("%s: vbus unknown (%d), not charging\n", __func__, vchr);
+		return false;
+	}
+	vchr *= 1000; /* uV */
+	if (vchr > info->data.max_charger_voltage) {
+		chr_err("%s: vbus(%d mV) > %d mV\n", __func__, vchr / 1000,
+			info->data.max_charger_voltage / 1000);
+		return false;
+	}
+
+	return true;
+}
