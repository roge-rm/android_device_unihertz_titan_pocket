+	if (IS_ENABLED(CONFIG_MTK_PUMP_EXPRESS_PLUS_20_SUPPORT)) {
+		/* Is PE+20 connect */
+		if (mtk_pe20_get_is_connect(pinfo))
+			is_ta_detected = 1;
