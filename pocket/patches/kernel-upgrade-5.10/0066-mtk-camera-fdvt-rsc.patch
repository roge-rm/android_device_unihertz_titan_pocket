+
+enum FRAME_STATUS_ENUM {
+	FRAME_STATUS_EMPTY,	/* 0 */
+	FRAME_STATUS_ENQUE,	/* 1 */
+	FRAME_STATUS_RUNNING,	/* 2 */
+	FRAME_STATUS_FINISHED,	/* 3 */
+	FRAME_STATUS_TOTAL
+};
+
+enum REQUEST_STATE_ENUM {
+	REQUEST_STATE_EMPTY,	/* 0 */
+	REQUEST_STATE_PENDING,	/* 1 */
+	REQUEST_STATE_RUNNING,	/* 2 */
