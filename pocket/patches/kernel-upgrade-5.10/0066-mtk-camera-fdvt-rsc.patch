+static const struct file_operations FDVT_fops = {
+	.owner               = THIS_MODULE,
+	.unlocked_ioctl      = FDVT_ioctl,
+	.open                = FDVT_open,
+	.release             = FDVT_release,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl        = compat_FD_ioctl,
+#endif
+};
