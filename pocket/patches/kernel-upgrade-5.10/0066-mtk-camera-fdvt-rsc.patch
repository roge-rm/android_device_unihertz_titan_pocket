+				(unsigned int)(RSC_BASE_HW + i),
+			   (unsigned int)RSC_RD32(ISP_RSC_BASE + i));
+	}
+
+	seq_puts(m, "RSC Config Info\n");
+	for (i = 0x230; i < 0x2D8; i = i + 4) {
