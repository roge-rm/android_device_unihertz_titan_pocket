+static irqreturn_t FDVT_irq(int irq, void *dev_id)
+{
+	/*g_FDVT_interrupt_handler = VAL_TRUE;*/
+	/*FDVT_ISR();*/
+	g_FDVTIRQ = ioread32((void *)FDVT_INT);
+	wake_up_interruptible(&g_FDVTWQ);
+
+	return IRQ_HANDLED;
+}
