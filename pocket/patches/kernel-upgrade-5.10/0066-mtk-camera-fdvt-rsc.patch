+static dev_t RSCDevNo;
+static struct cdev *pRSCCharDrv;
+static struct class *pRSCClass;
+
+static const struct file_operations RSCFileOper = {
+	.owner = THIS_MODULE,
+	.open = RSC_open,
+	.release = RSC_release,
+	/* .flush   = mt_RSC_flush, */
+	/* .mmap = RSC_mmap, */
