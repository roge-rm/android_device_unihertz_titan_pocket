+#if (MTK_SECURE_FD_SUPPORT == 1)
+	case COMPAT_FDVT_IOC_SETMETA_CMD:
+	{
+		compat_FDVTMetaData __user *data32;
+		FDVTMetaData __user *data;
+		int err;
+
+		data32 = compat_ptr(arg);
+		data = compat_alloc_user_space(sizeof(*data));
