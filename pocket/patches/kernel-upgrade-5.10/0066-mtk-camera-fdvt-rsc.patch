+static int __init egnreq_init(void)
+{
+	int ret = 0;
+
+	LOG_INF("engine_request module loaded");
+	return ret;
+}
+
+static void __exit egnreq_exit(void)
+{
+	LOG_INF("engine_request module unloaded");
+
+}
+
+module_init(egnreq_init);
+module_exit(egnreq_exit);
