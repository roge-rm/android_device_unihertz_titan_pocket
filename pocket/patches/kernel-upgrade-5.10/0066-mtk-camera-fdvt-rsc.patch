+			FDVT_IOC_G_READ_FDREG_CMD,
+			(unsigned long)data);
+		err = compat_FD_put_register_data(data32, data);
+		return ret ? ret : err;
+	}
+	case COMPAT_FDVT_IOC_T_SET_SDCONF_CMD:
+	{
+		compat_FDVTRegIO __user *data32;
+		FDVTRegIO __user *data;
