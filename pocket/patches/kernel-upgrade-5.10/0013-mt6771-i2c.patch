+/*
+ * Step and sample count as the vendor mtk_i2c_calculate_speed works them out
+ * with the stock DT i2c_common (cnt_constraint set). Above 400 kHz the vendor
+ * limits step to 8, which also applies to its 45% duty high phase at 400 kHz.
+ */
+static int mtk_i2c_vendor_cnt(unsigned int clk_src, unsigned int speed,
+			      unsigned int *step, unsigned int *sample)
+{
+	unsigned int max_step = speed > I2C_MAX_FAST_MODE_FREQ ?
+				MAX_HS_STEP_CNT_DIV : MAX_STEP_CNT_DIV;
+	unsigned int khz = speed / 1000;
+	unsigned int hclk = clk_src / 1000;
+	unsigned int min_div, best, s, t;
+	unsigned int s_div = MAX_SAMPLE_CNT_DIV, t_div = max_step;
+
+	if (!khz)
+		return -EINVAL;
+	min_div = ((hclk >> 1) + khz - 1) / khz;
+	best = MAX_SAMPLE_CNT_DIV * max_step;
+	for (s = 1; s <= MAX_SAMPLE_CNT_DIV; s++) {
+		t = (min_div + s - 1) / s;
+		if (t > max_step)
+			continue;
+		if (t * s < best) {
+			best = t * s;
+			s_div = s;
+			t_div = t;
+			if (best == min_div)
+				break;
+		}
+	}
+	if (hclk / (2 * s_div * t_div) > khz)
+		return -EINVAL;
+
+	/* cnt_constraint: step only drops by one when sample stays above 0 */
+	*sample = s_div - 1;
+	*step = *sample ? t_div - 1 : t_div;
+	return 0;
+}
