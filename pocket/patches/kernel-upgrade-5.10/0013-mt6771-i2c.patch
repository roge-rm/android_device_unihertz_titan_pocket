+	mtk_i2c_writew_at(i2c, chan, i2c->use_push_pull ?
+			  I2C_IO_CONFIG_PUSH_PULL : I2C_IO_CONFIG_OPEN_DRAIN,
+			  OFFSET_IO_CONFIG);
+	mtk_i2c_writew_at(i2c, chan, i2c->chan_timing | I2C_CHAN_TIMEOUT_EN,
+			  OFFSET_TIMING);
