+ * timing, CONTROL, slave address, status and FIFO cleared, the vendor
+ * channel interrupt mask and the lengths. The CCU starts its own transfers.
+ * Holds the bus lock while it writes, so no AP transfer runs meanwhile.
+ */
+int mtk_i2c_ccu_enable(struct i2c_adapter *adap, u16 ch_offset)
+{
+	struct mtk_i2c *i2c = mtk_i2c_from_adap(adap);
