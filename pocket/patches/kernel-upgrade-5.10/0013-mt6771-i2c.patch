+/*
+ * Channel TIMING, LTIMING and HW_TIMEOUT as the vendor i2c_set_speed and
+ * mt_i2c_do_transfer set them for ST and FS (set_ltiming, 45% high duty above
+ * 100 kHz). At 24.96 MHz and 400 kHz this gives TIMING 0x405, LTIMING 0x23
+ * and HW_TIMEOUT 0x56b. An hs_only bus above 1 MHz takes the same path at 50%
+ * duty: 3.4 MHz gives TIMING 0x4, LTIMING 0x4 and HW_TIMEOUT 0x2700.
+ */
+static int mtk_i2c_chan_timing(struct mtk_i2c *i2c, unsigned int clk_src)
+{
+	unsigned int duty = 50;
+	unsigned int step, sample, l_step, l_sample;
+	int ret;
+
+	if (i2c->speed_hz > I2C_MAX_FAST_MODE_FREQ && !i2c->hs_only)
+		return -EINVAL;
+	if (i2c->speed_hz > I2C_MAX_STANDARD_MODE_FREQ &&
+	    i2c->speed_hz <= I2C_MAX_FAST_MODE_FREQ)
+		duty = 45;
+
+	ret = mtk_i2c_vendor_cnt(clk_src, i2c->speed_hz * 50 / duty,
+				 &step, &sample);
+	if (ret)
+		return ret;
+	ret = mtk_i2c_vendor_cnt(clk_src, i2c->speed_hz * 50 / (100 - duty),
+				 &l_step, &l_sample);
+	if (ret)
+		return ret;
+
+	i2c->chan_timing = (sample & 0x7) << 8 | (step & 0x3f);
+	i2c->chan_ltiming = (l_sample & 0x7) << 6 | (l_step & 0x3f);
+	i2c->chan_hw_timeout = DIV_ROUND_UP(clk_src / 1000 * I2C_CHAN_SCL_LOW_MS,
+					    ((l_step & 0x3f) + 1) *
+					    ((l_sample & 0x7) + 1)) & 0xffff;
+	return 0;
+}
