+/*
+ * Ending of a channel transfer, after the vendor driver. A NACK only sets
+ * ACKERR beside TRANSAC_COMP and needs no reset. A timeout, bus error, lost
+ * arbitration or an interrupt with no status resets the shadow bank and hands
+ * the arbiter back with RESUME_ARBIT.
+ */
+static int mtk_i2c_chan_result(struct mtk_i2c *i2c, struct i2c_msg *msgs,
+			       int done, u16 intr_mask)
+{
+	u16 start_reg;
+
+	if (done == 0 || !i2c->irq_stat) {
+		start_reg = mtk_i2c_readw(i2c, OFFSET_START);
+		mtk_i2c_writew(i2c, I2C_FIFO_ADDR_CLR_MCH | I2C_FIFO_ADDR_CLR,
+			       OFFSET_FIFO_ADDR_CLR);
+		dev_info(i2c->dev,
+			 "addr 0x%x channel %s, start 0x%x, shadow slave 0x%x\n",
+			 msgs->addr, done ? "irq stat 0" : "timeout", start_reg,
+			 mtk_i2c_readw_shadow(i2c, OFFSET_SLAVE_ADDR));
+		mtk_i2c_init_hw(i2c);
+		if (start_reg & I2C_RESUME_ARBIT)
+			mtk_i2c_writew_shadow(i2c, I2C_RESUME_ARBIT,
+					      OFFSET_START);
+		return done ? -EIO : -ETIMEDOUT;
+	}
+
+	if (i2c->irq_stat & (I2C_HS_NACKERR | I2C_ACKERR | I2C_HW_TIMEOUT |
+			     I2C_BUS_ERR | I2C_ARB_LOST | I2C_IBI)) {
+		dev_dbg(i2c->dev, "addr 0x%x, irq_stat 0x%x\n", msgs->addr,
+			i2c->irq_stat);
+		mtk_i2c_writew(i2c, I2C_FIFO_ADDR_CLR_MCH | I2C_FIFO_ADDR_CLR,
+			       OFFSET_FIFO_ADDR_CLR);
+		if (!(i2c->irq_stat & I2C_TRANSAC_COMP) ||
+		    (i2c->irq_stat & I2C_BUS_ERR)) {
+			if ((i2c->irq_stat & intr_mask) > I2C_TRANSAC_COMP) {
+				mtk_i2c_init_hw(i2c);
+				mtk_i2c_writew_shadow(i2c, I2C_RESUME_ARBIT,
+						      OFFSET_START);
+			}
+		}
+		if (i2c->irq_stat & (I2C_HS_NACKERR | I2C_ACKERR))
+			return -ENXIO;
+		return -EIO;
+	}
+
+	mtk_i2c_fifo_read(i2c, msgs);
 	return 0;
 }
 
