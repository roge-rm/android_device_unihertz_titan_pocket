+static int mt6358_add_ufs_clock(struct platform_device *pdev)
+{
+	struct device_node *clock;
+	int ret = 0;
+
+	if (!IS_ENABLED(CONFIG_COMMON_CLK_MT6358_UFS))
+		return 0;
+	clock = of_get_compatible_child(pdev->dev.of_node,
+				       "mediatek,mt6358-ufs-clock");
+	if (clock && of_device_is_available(clock))
+		ret = devm_mfd_add_devices(&pdev->dev, PLATFORM_DEVID_NONE,
+				   &mt6358_ufs_clock_dev, 1, NULL, 0, NULL);
+	of_node_put(clock);
+	return ret;
+}
+
+/*
+ * A failure here only logs: without the driver, gpufreq keeps its boot hold
+ * at the battery OC limit.
+ */
+static void mt6358_add_battery_oc(struct platform_device *pdev)
+{
+	struct device_node *np;
+	int ret;
+
+	if (!IS_ENABLED(CONFIG_MT6358_BATTERY_OC))
+		return;
+	np = of_get_compatible_child(pdev->dev.of_node, "mediatek,mt-pmic");
+	if (np && of_device_is_available(np)) {
+		ret = devm_mfd_add_devices(&pdev->dev, PLATFORM_DEVID_NONE,
+					   &mt6358_battery_oc_dev, 1, NULL, 0, NULL);
+		if (ret)
+			dev_err(&pdev->dev, "battery OC child not added: %d\n", ret);
+	} else {
+		dev_info(&pdev->dev, "no mt-pmic node, battery OC not added\n");
+	}
+	of_node_put(np);
+}
 
