+
+	if (platform_device_register(&g_stAF_device)) {
+		LOG_INF("failed to register AF driver\n");
+		return -ENODEV;
+	}
+
+	if (platform_driver_register(&g_stAF_Driver)) {
+		LOG_INF("Failed to register AF driver\n");
+		return -ENODEV;
+	}
+
+	return 0;
+}
