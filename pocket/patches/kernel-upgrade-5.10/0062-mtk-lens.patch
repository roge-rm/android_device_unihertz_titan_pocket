+	.probe = AF_probe,
+	.remove = AF_remove,
+	.suspend = AF_suspend,
+	.resume = AF_resume,
+	.driver = {
+		.name = PLATFORM_DRIVER_NAME, .owner = THIS_MODULE,
+	} };
