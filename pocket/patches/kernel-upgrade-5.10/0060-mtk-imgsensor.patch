+enum IMGSENSOR_RETURN imgsensor_i2c_delete(void)
+{
+	int i;
+
+	for (i = 0; i < IMGSENSOR_I2C_DEV_MAX_NUM; i++)
+		i2c_del_driver(&gi2c_driver[i]);
+
+	return IMGSENSOR_RETURN_SUCCESS;
+}
