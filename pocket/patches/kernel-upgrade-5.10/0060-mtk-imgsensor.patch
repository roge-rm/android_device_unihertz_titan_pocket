+			if (err != 0)
+				PK_PR_ERR(
+			"[CAMERA SENSOR] compat_put_acdk_sensor_getinfo_struct failed\n");
+			return ret;
+		}
+
+	default:
+		return filp->f_op->unlocked_ioctl(filp, cmd, arg);
