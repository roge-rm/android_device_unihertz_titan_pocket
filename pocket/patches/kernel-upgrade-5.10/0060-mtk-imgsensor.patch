+			ret =
+			    filp->f_op->unlocked_ioctl(filp,
+					KDIMGSENSORIOC_X_GETINFO2,
+					(unsigned long)data);
+			err =
+			  compat_put_imagesensor_getinfo_struct(data32, data);
