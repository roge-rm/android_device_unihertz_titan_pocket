+static const struct file_operations gseninf_file_operations = {
+	.owner          = THIS_MODULE,
+	.open           = seninf_open,
+	.release        = seninf_release,
+	.mmap           = seninf_mmap,
+	.unlocked_ioctl = seninf_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl   = seninf_ioctl_compat,
+#endif
+};
