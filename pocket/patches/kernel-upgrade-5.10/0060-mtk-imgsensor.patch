+static kal_uint16 gain2reg(const kal_uint16 gain)
+{
+
+	kal_uint16 reg_gain = 0x0000;
+	kal_uint16 OV8865_GAIN_BASE = 128;
+
+
+	reg_gain = gain*OV8865_GAIN_BASE/BASEGAIN;
+	return (kal_uint16)reg_gain;
+
+	
+}
