+static void capture_setting(kal_uint16 currefps)
+{
+
+	if(currefps==300)
+		normal_capture_setting();
+	else if(currefps==200) // PIP
+		pip_capture_setting();
+	else if(currefps==150)
+        pip_capture_15fps_setting();
+  else// default
+	normal_capture_setting();
+}
