+			void *pinstance,
+			enum IMGSENSOR_SENSOR_IDX,
+			enum IMGSENSOR_HW_PIN, enum IMGSENSOR_HW_PIN_STATE);
+	enum IMGSENSOR_RETURN (*release)(void *pinstance);
+	enum IMGSENSOR_RETURN (*dump)(void *pintance);
+};
