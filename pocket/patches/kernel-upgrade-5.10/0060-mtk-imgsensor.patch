+ /* S means "set through a ptr" */
+ /* T means "tell by a arg value" */
+ /* G means "get by a ptr" */
+ /* Q means "get by return a value" */
+ /* X means "switch G and S atomically" */
+ /* H means "switch T and Q atomically" */
