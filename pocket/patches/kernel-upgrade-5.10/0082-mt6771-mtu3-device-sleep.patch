+static void mtu3_regs_init(struct mtu3 *mtu);
+
+/*
+ * Reset the device MAC and set it up again as at probe. Stock does this on
+ * every cable plug-in; with VBUS forced valid MT6771 never sees one, so it
+ * runs on each UDC bind and on resume from system sleep instead.
+ * Caller holds mtu->lock.
+ */
+void mtu3_device_reinit(struct mtu3 *mtu)
+{
+	mtu3_clrbits(mtu->ippc_base, U3D_SSUSB_IP_PW_CTRL2, SSUSB_IP_DEV_PDN);
+	mtu3_device_reset(mtu);
+	mtu3_regs_init(mtu);
+}
