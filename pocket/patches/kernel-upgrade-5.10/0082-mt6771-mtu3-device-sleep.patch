+/*
+ * System sleep with VBUS forced valid (MT6771). If a host link was up, drop
+ * the pull-up, end all requests, report a disconnect and power the device
+ * down, as stock does on unplug; the caller then powers the PHY off.
+ * Returns true if it stopped the device. Process context, lock not held.
+ */
+bool mtu3_gadget_sleep(struct mtu3 *mtu)
+{
+	unsigned long flags;
+	unsigned int sc;
+	int i;
+
+	/* 1 not active, 2 no gadget driver, 3 speed unknown; logged when it changes */
+	static int last_reason;
+	int reason = !mtu->is_active ? 1 : !mtu->gadget_driver ? 2 :
+		     mtu->g.speed == USB_SPEED_UNKNOWN ? 3 : 0;
+
+	if (reason) {
+		if (reason != last_reason)
+			dev_info(mtu->dev, "sleep: not stopping the device (%s)\n",
+				 reason == 1 ? "not active" :
+				 reason == 2 ? "no gadget driver" : "speed unknown");
+		last_reason = reason;
+		return false;
+	}
+	last_reason = 0;
+
+	disable_irq(mtu->irq);
+	spin_lock_irqsave(&mtu->lock, flags);
+
+	if (mtu->softconnect)
+		mtu3_dev_on_off(mtu, 0);
+
+	nuke(mtu->ep0, -ESHUTDOWN);
+	for (i = 1; i < mtu->num_eps; i++) {
+		nuke(mtu->in_eps + i, -ESHUTDOWN);
+		nuke(mtu->out_eps + i, -ESHUTDOWN);
+	}
+	/* the function drivers disable their endpoints here */
+	mtu3_gadget_disconnect(mtu);
+	mtu->g.speed = USB_SPEED_UNKNOWN;
+
+	/* keep the pull-up request for mtu3_gadget_wake() */
+	sc = mtu->softconnect;
+	mtu->softconnect = 0;
+	mtu3_stop(mtu);
+	mtu->softconnect = sc;
+	mtu->sleep_stopped = 1;
+
+	spin_unlock_irqrestore(&mtu->lock, flags);
+	dev_info(mtu->dev, "device stopped for sleep\n");
+	return true;
+}
+
+/* undo mtu3_gadget_sleep() once the PHY is on again */
+void mtu3_gadget_wake(struct mtu3 *mtu)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&mtu->lock, flags);
+	mtu->sleep_stopped = 0;
+	mtu3_device_reinit(mtu);
+	mtu3_start(mtu);
+	spin_unlock_irqrestore(&mtu->lock, flags);
+	enable_irq(mtu->irq);
+	dev_info(mtu->dev, "device restarted after sleep\n");
+}
