+config BATTERY_OZ8806
+	bool "O2Micro OZ8806 fuel gauge (Titan Pocket)"
+	depends on I2C=y && OF && MFD_MT6397=y
+	help
+	  The OZ8806 gauge on i2c6 0x2f of the Titan Pocket. The level
+	  follows the coulomb counter and is set from the cell's OCV at boot
+	  and after a rest.
+
+config OZ8806_WRITE
+	bool "Let the OZ8806 driver write the gauge and the RTC spare register"
+	depends on BATTERY_OZ8806
+	help
+	  Lets the driver write the OZ8806 (OP_CTRL, trim, board offset and
+	  CAR) and the SOC in the MT6358 RTC spare register, as stock does.
+	  Off, it only reads them and keeps the CAR offset in software, and
+	  writes only OP_CTRL: 0x20 to wake the chip, 0x60 at shutdown.
+
+config OZ8806_WRITE_CAR
+	bool "Let the OZ8806 driver write the coulomb counter (CAR) only"
+	depends on BATTERY_OZ8806 && !OZ8806_WRITE
+	help
+	  Writes the CAR register (0x14) as stock does: at init, at end of
+	  charge, at empty and when it drifts from the remaining capacity.
+	  Nothing else is written beyond the OP_CTRL wake and sleep.
