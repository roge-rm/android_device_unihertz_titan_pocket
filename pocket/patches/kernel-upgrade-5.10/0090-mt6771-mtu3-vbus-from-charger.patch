+/*
+ * Plug-out: pull-up off and a disconnect to the functions through the UDC
+ * core, which then keeps the pull-up off across binds, then end all requests
+ * and stop the device MAC, as stock does on unplug. The PHY stays powered.
+ * Plug-in: as on bind, PHY off and on and a fresh MAC, then the pull-up.
+ */
+static void mtu3_vbus_work(struct work_struct *work)
+{
+	struct mtu3 *mtu = smp_load_acquire(&vbus_mtu);
+	unsigned long flags;
+	bool on;
+	int i;
+
+	if (!mtu)
+		return;
+
+	mutex_lock(&vbus_lock);
+	on = READ_ONCE(vbus_on);
+	if (on != vbus_stopped)
+		goto out;
+
+	if (!on) {
+		usb_udc_vbus_handler(&mtu->g, false);
+
+		spin_lock_irqsave(&mtu->lock, flags);
+		nuke(mtu->ep0, -ESHUTDOWN);
+		for (i = 1; i < mtu->num_eps; i++) {
+			nuke(mtu->in_eps + i, -ESHUTDOWN);
+			nuke(mtu->out_eps + i, -ESHUTDOWN);
+		}
+		mtu->g.speed = USB_SPEED_UNKNOWN;
+		mtu3_state_reset(mtu);
+		usb_gadget_set_state(&mtu->g, USB_STATE_NOTATTACHED);
+		if (mtu->is_active)
+			mtu3_stop(mtu);
+		vbus_stopped = true;
+		spin_unlock_irqrestore(&mtu->lock, flags);
+
+		synchronize_irq(mtu->irq);
+		dev_info(mtu->dev, "cable out, device stopped\n");
+		goto out;
+	}
+
+	if (mtu->gadget_driver) {
+		ssusb_phy_power_off(mtu->ssusb);
+		if (ssusb_phy_power_on(mtu->ssusb)) {
+			/* stays stopped; the next plug-in tries again */
+			dev_err(mtu->dev, "cable in, phy power on failed\n");
+			goto out;
+		}
+		spin_lock_irqsave(&mtu->lock, flags);
+		mtu3_device_reinit(mtu);
+		mtu3_start(mtu);
+		spin_unlock_irqrestore(&mtu->lock, flags);
+	}
+	vbus_stopped = false;
+	usb_udc_vbus_handler(&mtu->g, true);
+	dev_info(mtu->dev, "cable in, device started\n");
+out:
+	mutex_unlock(&vbus_lock);
+}
+
+/*
+ * The PHY didn't power on after sleep: IRQ back on and the device left
+ * stopped as after a plug-out, so the plug-in work cycles the PHY and starts
+ * it. It tries once now; if that fails too, the next plug-in tries again.
+ */
+void mtu3_gadget_wake_failed(struct mtu3 *mtu)
+{
+	unsigned long flags;
+
+	mutex_lock(&vbus_lock);
+	spin_lock_irqsave(&mtu->lock, flags);
+	mtu->sleep_stopped = 0;
+	vbus_stopped = true;
+	spin_unlock_irqrestore(&mtu->lock, flags);
+	enable_irq(mtu->irq);
+	mutex_unlock(&vbus_lock);
+
+	if (smp_load_acquire(&vbus_mtu))
+		queue_work(system_freezable_wq, &vbus_work);
+}
+
+static void mtu3_vbus_set(bool on)
+{
+	WRITE_ONCE(vbus_on, on);
+	/* events before the gadget is registered are dropped */
+	if (smp_load_acquire(&vbus_mtu))
+		queue_work(system_freezable_wq, &vbus_work);
+}
+
+/* the charger saw a USB host: SDP, CDP or a non-standard charger */
+void mt_usb_connect(void)
+{
+	mtu3_vbus_set(true);
+}
+
+/* the charger saw a plug-out or a charger that isn't a host */
+void mt_usb_disconnect(void)
+{
+	mtu3_vbus_set(false);
+}
