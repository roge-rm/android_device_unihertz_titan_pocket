+static DEFINE_MUTEX(vbus_lock);
+static bool vbus_stopped;
+static bool vbus_on = true;
+static struct mtu3 *vbus_mtu;
+static void mtu3_vbus_work(struct work_struct *work);
+static DECLARE_WORK(vbus_work, mtu3_vbus_work);
