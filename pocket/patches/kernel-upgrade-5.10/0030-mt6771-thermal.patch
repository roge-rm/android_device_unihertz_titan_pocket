+static ssize_t sensors_show(struct device *dev, struct device_attribute *attr,
+			    char *buf)
+{
+	struct mtk_thermal *mt = dev_get_drvdata(dev);
+
+	return mtk_thermal_format_sensors(mt, buf, PAGE_SIZE);
+}
+static DEVICE_ATTR_RO(sensors);
