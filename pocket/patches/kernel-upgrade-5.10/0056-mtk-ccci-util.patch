+static int get_plat_capbility(int md_id)
+{
+	int en_flag = 0;
+
+	/* MD1 */
+	/* Fix me, may design more better solution to reduce memory usage */
+	en_flag |= (1<<0);
+
+	/* MD3 */
+	en_flag |= (1<<2);
+
+	return (en_flag & (1<<md_id));
