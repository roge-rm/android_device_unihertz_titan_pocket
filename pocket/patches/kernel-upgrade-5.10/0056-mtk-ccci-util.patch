+static int __init early_init_dt_get_chosen(unsigned long node,
+	const char *uname, int depth, void *data)
+{
+	if (depth != 1 || (strcmp(uname, "chosen") != 0
+			&& strcmp(uname, "chosen@0") != 0))
+		return 0;
+	s_g_dt_chosen_node = node;
