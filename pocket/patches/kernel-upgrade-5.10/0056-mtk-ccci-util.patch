+			*(curr_p + 4), *(curr_p + 5),
+			*(curr_p + 6), *(curr_p + 7),
+			*(curr_p + 8), *(curr_p + 9),
+			*(curr_p + 10), *(curr_p + 11),
+			*(curr_p + 12), *(curr_p + 13),
+			*(curr_p + 14), *(curr_p + 15));
+			curr_p += 64/4;
+	}
+
+	/* Tail section */
+	if (tail_num > 0) {
+		curr_ch_p = (unsigned char *)curr_p;
+		for (j = 0; j < tail_num; j++) {
+			buf[j] = *curr_ch_p;
+			curr_ch_p++;
+		}
+		for (; j < 64; j++)
+			buf[j] = 0;
+		curr_p = (unsigned int *)buf;
+		ccci_dump_write(md_id, buf_type, 0,
+			"%03X: %X %X %X %X %X %X %X %X %X %X %X %X %X %X %X %X\n",
+			i * 64,
+			*curr_p, *(curr_p + 1),
+			*(curr_p + 2), *(curr_p + 3),
+			*(curr_p + 4), *(curr_p + 5),
+			*(curr_p + 6), *(curr_p + 7),
+			*(curr_p + 8), *(curr_p + 9),
+			*(curr_p + 10), *(curr_p + 11),
+			*(curr_p + 12), *(curr_p + 13),
+			*(curr_p + 14), *(curr_p + 15));
+	}
+}
