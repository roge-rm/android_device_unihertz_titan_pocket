+	}
+	if (len == 0) {
+		ccci_dump_write(md_id, buf_type, 0, "len [0]\n");
+		return;
+	}
+
+	/* Fix section */
+	for (i = 0; i < _64_fix_num; i++) {
+		ccci_dump_write(md_id, buf_type, 0,
+			"%03X: %X %X %X %X %X %X %X %X %X %X %X %X %X %X %X %X\n",
+			i * 64,
+			*curr_p, *(curr_p + 1),
