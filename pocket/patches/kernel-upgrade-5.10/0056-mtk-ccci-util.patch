+	for (i = 0; i < MAX_MD_NUM; i++) {
+		if (get_modem_is_enabled(MD_SYS1 + i))
+			md_en[i] = 'E';
+		else
+			md_en[i] = 'D';
+	}
+
+	/* Final string */
+	return snprintf(buf, 32,
+			"%c-%c-%c-%c-%c (1->5)\n",
+			md_en[0], md_en[1], md_en[2],
+			md_en[3], md_en[4]);
+}
