+static int find_ccci_tag_inf(char *name, char *buf, unsigned int size)
+{
+	unsigned int i;
+
+	/* For strcmp/strncmp should not be used on device memory,
+	 * so prepare a temp buffer.
+	 */
+	char tag_name[64];
+	unsigned int data_offset;
+	unsigned int data_size;
+	unsigned int next_tag_offset;
+	unsigned int tmp_buf;
+	int cpy_size;
+	unsigned int curr_offset = 0, tag_size, limit;
+	char *curr;
+	union u_tag {
+		struct _ccci_tag v1;
+		struct _ccci_tag_v2 v2;
+	} tag;
+
+	if (buf == NULL)
+		return -1;
+
+	if (s_g_lk_inf_base == NULL)
+		return -2;
+
+	/* Offsets come from LK's buffer: keep every read inside the mapped tag area. */
+	limit = min_t(unsigned int, s_g_tag_inf_size, MAX_LK_INFO_SIZE);
+	tag_size = s_g_lk_info_tag_version >= CCCI_LK_INFO_VER_V2 ?
+		sizeof(struct _ccci_tag_v2) : sizeof(struct _ccci_tag);
+	CCCI_UTIL_INF_MSG("------curr tags:%s----------\n", name);
+	for (i = 0; i < s_g_tag_cnt; i++) {
+		if (curr_offset > limit || limit - curr_offset < tag_size) {
+			CCCI_UTIL_ERR_MSG("tag %u offset 0x%x out of range\n", i, curr_offset);
+			return -1;
+		}
+		curr = (char *)s_g_lk_inf_base + curr_offset;
+		/* 1. Copy tag */
+		memcpy_fromio(&tag, curr, tag_size);
+		if (s_g_lk_info_tag_version >= CCCI_LK_INFO_VER_V2) {
+			snprintf(tag_name, 64, "%.*s", CCCI_TAG_NAME_LEN_V2, tag.v2.tag_name);
+			data_offset = tag.v2.data_offset;
+			data_size = tag.v2.data_size;
+			next_tag_offset = tag.v2.next_tag_offset;
+		} else {
+			snprintf(tag_name, 64, "%.*s", CCCI_TAG_NAME_LEN, tag.v1.tag_name);
+			data_offset = tag.v1.data_offset;
+			data_size = tag.v1.data_size;
+			next_tag_offset = tag.v1.next_tag_offset;
+		}
+		if (data_offset > limit || limit - data_offset < data_size ||
+		    limit - data_offset < sizeof(int)) {
+			CCCI_UTIL_ERR_MSG("tag %s data 0x%x+0x%x out of range\n",
+				tag_name, data_offset, data_size);
+			return -1;
+		}
+		memcpy_fromio(&tmp_buf, (void *)(s_g_lk_inf_base + data_offset),
+			sizeof(int));
+
+		#ifdef LK_LOAD_MD_INFO_DEBUG_EN
+		CCCI_UTIL_INF_MSG("tag->name:%s\n", tag_name);
+		CCCI_UTIL_INF_MSG("tag->data_offset:%d\n", data_offset);
+		CCCI_UTIL_INF_MSG("tag->data_size:%d\n", data_size);
+		CCCI_UTIL_INF_MSG("tag->next_tag_offset:%d\n", next_tag_offset);
+		CCCI_UTIL_INF_MSG("tag value:%d\n", tmp_buf);
+		#endif
+
+		/* 2. compare tag value. */
+		if (strcmp(tag_name, name) != 0) {
+			curr_offset = next_tag_offset;
+			continue;
+		}
+		/* found it */
+		cpy_size = size > data_size?data_size:size;
+		memcpy_fromio(buf,
+			(void *)(s_g_lk_inf_base + data_offset),
+			cpy_size);
+
+		return cpy_size;
+	}
+	return -1;
+}
