+			    struct snd_ctl_elem_value *ucontrol)
+{
+	int index = ucontrol->value.integer.value[0];
+
+	if (index >= ARRAY_SIZE(DAC_DL_PGA_Speaker_GAIN)) {
+		pr_warn("return -EINVAL\n");
