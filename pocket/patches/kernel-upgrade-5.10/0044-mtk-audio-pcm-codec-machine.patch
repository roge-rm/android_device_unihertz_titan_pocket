+static bool AudioPreAmp1_Sel(int Mul_Sel)
+{
+	if (Mul_Sel >= 0 && Mul_Sel < NUM_PREAMP_INPUT_SELECT)
+		Ana_Set_Reg(AUDENC_ANA_CON0, Mul_Sel << 6, 0x3 << 6);
+	else
+		pr_warn("%s(), error, Mul_Sel = %d", __func__, Mul_Sel);
+
+	return true;
+}
