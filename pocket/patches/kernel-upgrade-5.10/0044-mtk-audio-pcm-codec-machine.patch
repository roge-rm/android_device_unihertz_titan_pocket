+/* 1.7V * 0.5kohm / (2.5 + 0.5)kohm = 0.283V, support 1k ~ 14k, 0.5k margin */
+#define MIC_VINP_4POLE_THRES_MV 283
+#define VINP_NORMALIZED_TO_MV 1700
+
