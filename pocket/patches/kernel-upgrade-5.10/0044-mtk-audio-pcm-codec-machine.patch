+#include "mtk-auddrv-afe.h"
+#include "mtk-auddrv-ana.h"
+#include "mtk-auddrv-clk.h"
+#include "mtk-auddrv-common.h"
+#include "mtk-auddrv-def.h"
+#include "mtk-auddrv-kernel.h"
