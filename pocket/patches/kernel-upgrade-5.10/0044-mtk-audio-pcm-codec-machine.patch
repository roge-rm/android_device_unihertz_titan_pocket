+static void setHpGainZero(void)
+{
+	Ana_Set_Reg(ZCD_CON2, DL_GAIN_0DB << 7, 0x0f80);
+	Ana_Set_Reg(ZCD_CON2, DL_GAIN_0DB, 0x001f);
