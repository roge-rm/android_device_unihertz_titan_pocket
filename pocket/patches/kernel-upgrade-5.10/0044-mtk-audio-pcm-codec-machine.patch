+static int Voice_Amp_Get(struct snd_kcontrol *kcontrol,
+			 struct snd_ctl_elem_value *ucontrol)
+{
+	pr_debug("%s = %d\n", __func__,
+		 mCodec_data->dev_power[ANA_DEV_OUT_EARPIECEL]);
+	ucontrol->value.integer.value[0] =
