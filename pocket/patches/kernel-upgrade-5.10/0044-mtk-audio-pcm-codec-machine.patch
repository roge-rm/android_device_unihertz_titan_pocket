+				    (void *)DEBUG_FS_NAME, &mtaudio_debug_ops);
+
+	/* create analog debug file */
+	mt_sco_audio_debugfs = debugfs_create_file(
+		DEBUG_ANA_FS_NAME, S_IFREG | 0444, NULL,
+		(void *)DEBUG_ANA_FS_NAME, &mtaudio_ana_debug_ops);
+#endif
+	return ret;
+}
