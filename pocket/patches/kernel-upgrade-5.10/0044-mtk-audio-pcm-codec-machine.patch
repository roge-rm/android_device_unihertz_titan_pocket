+static int mt6358_codec_probe(struct snd_soc_component *codec)
+{
+	int ret = 0;
+
+	pr_debug("%s()\n", __func__);
+
+	/* add codec controls */
+	snd_soc_add_component_controls(codec, mt6358_snd_controls,
+				   ARRAY_SIZE(mt6358_snd_controls));
+	snd_soc_add_component_controls(codec, mt6358_UL_Codec_controls,
+				   ARRAY_SIZE(mt6358_UL_Codec_controls));
+	snd_soc_add_component_controls(codec, mt6358_pmic_Test_controls,
+				   ARRAY_SIZE(mt6358_pmic_Test_controls));
+
+	snd_soc_add_component_controls(codec, Audio_snd_auxadc_controls,
+				   ARRAY_SIZE(Audio_snd_auxadc_controls));
+
+	/*
+	 * A failed or deferred card bind removes and probes the component
+	 * again; controls and drvdata go on the new one, the PMIC init and
+	 * the DC trim run once.
+	 */
+	if (mInitCodec == true) {
+		snd_soc_component_set_drvdata(codec, mCodec_data);
+		return 0;
+	}
+
+	/* here to set  private data */
+	mCodec_data = kzalloc(sizeof(struct mt6358_codec_priv), GFP_KERNEL);
+	if (!mCodec_data) {
+		/*pr_warn("Failed to allocate private data\n");*/
+		return -ENOMEM;
+	}
+	snd_soc_component_set_drvdata(codec, mCodec_data);
+
+	memset((void *)mCodec_data, 0, sizeof(struct mt6358_codec_priv));
+	mt6358_codec_init_reg(codec);
+	InitCodecDefault();
+	efuse_current_calibrate = read_efuse_hp_impedance_current_calibration();
+	mInitCodec = true;
+	apply_n12db_gain = 0;
+
+	dc_trim_task = kthread_create(dc_trim_thread, NULL, "dc_trim_thread");
+	if (IS_ERR(dc_trim_task)) {
+		ret = PTR_ERR(dc_trim_task);
+		dc_trim_task = NULL;
+		pr_debug("%s(), create dc_trim_thread failed, ret %d\n",
+			__func__, ret);
+	} else {
+		wake_up_process(dc_trim_task);
+	}
+	return 0;
+}
