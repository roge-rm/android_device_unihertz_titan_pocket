+/*****************************************************************************
+ *                E X T E R N A L   R E F E R E N C E S
+ *****************************************************************************/
+#include <linux/types.h>
+#include <linux/kernel.h>
+
+#include "mtk-auddrv-ana.h"
+#include "mtk-soc-codec-63xx.h"
+
+#ifdef AUDIO_USING_WRAP_DRIVER
+#include <linux/err.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#endif
+
+
+#ifdef AUDIO_USING_WRAP_DRIVER
+/*
+ * 5.10 has no global pwrap_read/pwrap_write. MT6358 registers go through the pwrap
+ * regmap instead, the one U's MT6358 mfd uses. Its accesses can sleep, so Ana_Set_Reg
+ * holds a mutex where stock held a spinlock; every caller is in process context
+ * (controls, the codec probe and its DC trim thread, debugfs, suspend).
+ */
+static DEFINE_MUTEX(ana_set_reg_lock);
+static struct regmap *ana_regmap;
+
+/* Finds the pwrap regmap through the MT6358 node's parent; -EPROBE_DEFER until pwrap binds. */
+int Ana_Init_Regmap(void)
+{
+	struct device_node *pmic, *wrap;
+	struct platform_device *pdev;
+	struct regmap *map;
+
+	if (READ_ONCE(ana_regmap))
+		return 0;
+	pmic = of_find_compatible_node(NULL, NULL, "mediatek,mt6358");
+	if (!pmic)
+		return -ENODEV;
+	wrap = of_get_parent(pmic);
+	of_node_put(pmic);
+	if (!wrap)
+		return -ENODEV;
+	pdev = of_find_device_by_node(wrap);
+	of_node_put(wrap);
+	if (!pdev)
+		return -EPROBE_DEFER;
+	map = dev_get_regmap(&pdev->dev, NULL);
+	put_device(&pdev->dev);
+	if (!map)
+		return -EPROBE_DEFER;
+	WRITE_ONCE(ana_regmap, map);
+	return 0;
+}
+EXPORT_SYMBOL(Ana_Init_Regmap);
+#endif
+
+/*****************************************************************************
+ *                         D A T A   T Y P E S
+ *****************************************************************************/
+unsigned int Ana_Get_Reg(unsigned int offset)
+{
+	/* get pmic register */
+	unsigned int Rdata = 0;
+#ifdef AUDIO_USING_WRAP_DRIVER
+	struct regmap *map = READ_ONCE(ana_regmap);
+
+	if (!map) {
+		pr_warn_ratelimited("%s(), 0x%x before the pwrap regmap\n",
+				    __func__, offset);
+		return 0;
+	}
+	if (regmap_read(map, offset, &Rdata))
+		Rdata = 0;
+#endif
+
+	return Rdata;
+}
+EXPORT_SYMBOL(Ana_Get_Reg);
+
+void Ana_Set_Reg(unsigned int offset, unsigned int value, unsigned int mask)
+{
+	/* set pmic register or analog CONTROL_IFACE_PATH */
+
+#ifdef AUDIO_USING_WRAP_DRIVER
+	struct regmap *map = READ_ONCE(ana_regmap);
+	unsigned int Reg_Value;
+
+	if (!map) {
+		pr_warn_ratelimited("%s(), 0x%x before the pwrap regmap\n",
+				    __func__, offset);
+		return;
+	}
+	/* read-modify-write that always writes, as stock (the _SET/_CLR registers need it) */
+	mutex_lock(&ana_set_reg_lock);
+	Reg_Value = Ana_Get_Reg(offset);
+	Reg_Value &= (~mask);
+	Reg_Value |= (value & mask);
+	regmap_write(map, offset, Reg_Value & 0xffff);
+	mutex_unlock(&ana_set_reg_lock);
+#endif
+}
+EXPORT_SYMBOL(Ana_Set_Reg);
