+	sph_property = (int *)get_sph_property_by_name(&voice_property,
+						       kcontrol->id.name);
+	if (!sph_property) {
+		pr_info("%s(), sph_property == NULL\n", __func__);
+		return -EINVAL;
+	}
+	ucontrol->value.integer.value[0] = *sph_property;
+
+	return 0;
+}
