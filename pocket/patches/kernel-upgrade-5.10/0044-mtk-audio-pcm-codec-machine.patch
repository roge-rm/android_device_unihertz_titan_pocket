+static bool GetAdcStatus(void)
+{
+	int i = 0;
+
+	for (i = ANA_DEV_IN_ADC1; i < ANA_DEV_MAX; i++) {
+		if ((mCodec_data->dev_power[i] == true)
+		    && (i != ANA_DEV_RECEIVER_SPEAKER_SWITCH))
+			return true;
+	}
+	return false;
+}
