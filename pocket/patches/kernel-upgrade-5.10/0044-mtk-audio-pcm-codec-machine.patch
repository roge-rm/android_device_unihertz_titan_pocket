+static struct mtk_soc_platform_driver mtk_bt_dai_soc_platform =
+	MTK_SOC_PLATFORM_DRIVER(MT_SOC_VOIP_BT_IN, &mtk_bt_dai_ops, mtk_asoc_bt_dai_probe);
