+		platform->dev, SOC_HIFI_BUFFER_SIZE,
+		&Dl1I2S0_Playback_dma_buf.addr, GFP_KERNEL | GFP_DMA);
+	if (!Dl1I2S0_Playback_dma_buf.area)
