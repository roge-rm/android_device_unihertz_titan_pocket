+{
+	if (enable) {
+		/* connect */
+		if (usb_ul_select == VOICE_UL_PRIMARY) {
+			/* i3i4 -> pcm1 o7o8 */
+			SetIntfConnection(Soc_Aud_InterCon_Connection,
+					  Soc_Aud_AFE_IO_Block_ADDA_UL,
+					  Soc_Aud_AFE_IO_Block_MODEM_PCM_1_O);
