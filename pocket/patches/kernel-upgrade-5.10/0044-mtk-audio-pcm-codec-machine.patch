+static const int dBFactor_Den = 8192;
+/* 1 / (10 ^ (dB / 20)) * dBFactor_Den */
+static const int dBFactor_Nom[32] = {
+	3261, 3659, 4106, 4607,
+	5169, 5799, 6507, 7301,
+	8192, 9192, 10313, 11572,
+	12983, 14568, 16345, 18340,
+	20577, 23088, 25905, 819200,
+	819200, 819200, 819200, 819200,
+	819200, 819200, 819200, 819200,
+	819200, 819200, 819200, 819200,
+};
