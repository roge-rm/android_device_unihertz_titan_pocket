+/*
+ * MT6771 shares the mt8183_regs layout, not its initialization sequence.
+ * Initially support only the validated bootloader-initialized MT6358 bus.
+ * Do not reset the wrapper, change SPI timing or write PMIC test registers.
+ */
+static int pwrap_mt6771_validate_handoff(struct pmic_wrapper *wrp)
+{
+	u32 rdata;
+	int ret;
+
+	if (wrp->slave->type != PMIC_MT6358)
+		return -ENODEV;
+	if (!(pwrap_readl(wrp, PWRAP_INIT_DONE2) & 1) ||
+	    !(pwrap_readl(wrp, PWRAP_WACS2_RDATA) & PWRAP_STATE_INIT_DONE0) ||
+	    !(pwrap_readl(wrp, PWRAP_WRAP_EN) & 1) ||
+	    !(pwrap_readl(wrp, PWRAP_WACS2_EN) & 1))
+		return -ENODEV;
+
+	ret = pwrap_read(wrp, wrp->slave->dew_regs[PWRAP_DEW_READ_TEST], &rdata);
+	if (ret)
+		return ret;
+
+	return rdata == PWRAP_DEW_READ_TEST_VAL ? 0 : -EIO;
 }
 
