+/* scenario */
+#define FLASHLIGHT_SCENARIO_CAMERA_MASK 1
+#define FLASHLIGHT_SCENARIO_DECOUPLE_MASK 2
+#define FLASHLIGHT_SCENARIO_FLASHLIGHT (0 << 0)
