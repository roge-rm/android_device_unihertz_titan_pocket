+static void md_ccif_traffic_monitor_func(struct timer_list *t)
+{
+	struct md_ccif_ctrl *md_ctrl = from_timer(md_ctrl, t, traffic_monitor);
+
+	schedule_work(&md_ctrl->traffic_info.traffic_work_struct);
