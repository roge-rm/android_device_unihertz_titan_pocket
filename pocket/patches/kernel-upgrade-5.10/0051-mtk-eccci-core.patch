+	unsigned int    buffer_id:13; /* BAT index */
+	unsigned int    data_len:16;
+	unsigned int    p_data_addr;
+	unsigned int    data_addr_ext:8;
+	unsigned int    reserved:24;
+};
+#else
+struct dpmaifq_normal_pit {
