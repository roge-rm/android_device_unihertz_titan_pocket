+	if ((jiffies - md_ctrl->traffic_stamp) / HZ <=
+		TRAFFIC_MONITOR_INTERVAL * 2)
+		mod_timer(&md_ctrl->traffic_monitor,
+			jiffies + TRAFFIC_MONITOR_INTERVAL * HZ);
