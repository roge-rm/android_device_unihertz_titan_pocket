+#ifndef __MODEM_CD_H__
+#define __MODEM_CD_H__
+
+#include <linux/pm_wakeup.h>
+#include <linux/dmapool.h>
+#include <linux/timer.h>
+#include <linux/interrupt.h>
+#include <linux/hrtimer.h>
