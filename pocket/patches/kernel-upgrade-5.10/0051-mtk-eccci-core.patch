+static inline int log2_remain(unsigned int value)
+{
+	int x = 0;
+	int y;
+
+	if (value < 32)
+		return -1;
+
+	/* value = (2^x)*y */
+	while (!(value & (1 << x)))
+		x++;
+	y = (value >> x);
+	if ((1 << x) * y != value)
+		WARN_ON(1);
+
+	return y;
+}
