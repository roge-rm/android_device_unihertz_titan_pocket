+			md_ctrl->tx_traffic_monitor[i],
+			md_ctrl->tx_pre_traffic_monitor[i + 1],
+			md_ctrl->tx_traffic_monitor[i + 1],
+			md_ctrl->tx_pre_traffic_monitor[i + 2],
