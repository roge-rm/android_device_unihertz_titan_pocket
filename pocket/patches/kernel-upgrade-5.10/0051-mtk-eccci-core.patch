+/* PSMCU DCM: MD_GLOBAL_CON_DCM_BASE+ */
+/* Bit 26-20: DBC_CNT, Bit 16-12: IDLE_FSEL, Bit 2: DBC_EN, Bit 1: DCM_EN */
+#define R_PSMCU_DCM_CTL0		(0x0010)
