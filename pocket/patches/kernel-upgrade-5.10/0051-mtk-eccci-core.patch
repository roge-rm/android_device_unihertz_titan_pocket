+#define R_MDPERI_CKEN			(0x0048)
+/* Bit 31: MDDBGSYS_DCM_EN
+ *	Bit  21: USB0_LINK_CK_SEL
+ *	Bit  20: USB1_LINK_CK_SEL
+ *	Bit  17: TRACE_CKEN
