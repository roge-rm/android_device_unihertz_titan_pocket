+		CCCI_NORMAL_LOG(md_ctrl->md_id, TAG,
+			"net Txq%d-%d(status=0x%x):%d-%d, %d-%d, %d-%d, %d-%d\n",
+			i, i + 3, cldma_read32(md_ctrl->cldma_ap_pdn_base,
+			CLDMA_AP_UL_STATUS),
