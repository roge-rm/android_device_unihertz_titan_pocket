// Notification and battery light on the MT6370 RGB LED, driven by the stock lights HAL.

runtime_resource_overlay {
    name: "PocketLightsFrameworkOverlay",
    resource_dirs: ["overlay/PocketLightsFrameworkOverlay/res"],
    manifest: "overlay/PocketLightsFrameworkOverlay/AndroidManifest.xml",
    product_specific: true,
}

runtime_resource_overlay {
    name: "PocketLightsLineageOverlay",
    resource_dirs: ["overlay/PocketLightsLineageOverlay/res"],
    manifest: "overlay/PocketLightsLineageOverlay/AndroidManifest.xml",
    product_specific: true,
}
